<%# Custom score provider: URL template with {cve}, then a JSON path, or a CSS selector and / or regex for an HTML page. %>
<%= form_with model: provider, url: (provider.persisted? ? settings_score_provider_path(provider) : settings_score_providers_path), scope: :score_provider,
      data: { controller: "kind-fields" }, class: "score-provider-form card mt-6 space-y-4 p-5" do |f| %>
  <%= render "shared/form_errors", record: provider %>
  <div>
    <%= f.label :name, t(".name"), class: "label" %>
    <%= f.text_field :name, value: provider.name, required: true, class: "input", placeholder: t(".cvefind") %>
  </div>
  <div>
    <%= f.label :url_template, t(".score_address"), class: "label" %>
    <%= f.url_field :url_template, value: provider.setting("url_template"), required: true, class: "input font-mono text-xs", placeholder: "https://www.cvefind.com/fr/cve/{cve}.html" %>
    <p class="mt-1 text-xs text-ink-3"><%= t(".url_hint_html", placeholder: tag.code("{cve}")) %></p>
  </div>
  <div>
    <%= f.label :page_url_template, t(".page_open_optional"), class: "label" %>
    <%= f.url_field :page_url_template, value: provider.setting("page_url_template"), class: "input font-mono text-xs", placeholder: t(".default_score_address") %>
  </div>
  <fieldset>
    <legend class="label">Format</legend>
    <div class="flex flex-wrap gap-4 text-sm">
      <% ScoreProvider::FORMATS.each do |value| %>
        <% label = ScoreProvider.format_label(value) %>
        <label class="flex items-center gap-1.5"><%= f.radio_button :format, value, checked: provider.setting("format") == value, data: { kind_fields_target: "kind", action: "kind-fields#update" } %> <%= label %></label>
      <% end %>
    </div>
  </fieldset>
  <div data-kind-fields-target="field" data-kinds="json">
    <%= f.label :json_path, t(".json_path_score"), class: "label" %>
    <%= f.text_field :json_path, value: provider.setting("json_path"), class: "input font-mono text-xs", placeholder: "cvss3.cvss3_base_score  ou  metrics.0.cvssV3_1.baseScore" %>
  </div>
  <div data-kind-fields-target="field" data-kinds="html" class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :css_selector, t(".css_selector_optional"), class: "label" %>
      <%= f.text_field :css_selector, value: provider.setting("css_selector"), class: "input font-mono text-xs", placeholder: ".cvss-score" %>
    </div>
    <div>
      <%= f.label :regex, t(".regex_optional_1st_group"), class: "label" %>
      <%= f.text_field :regex, value: provider.setting("regex"), class: "input font-mono text-xs", placeholder: '"name": "Base Score",\s*"value": "([\d.]+)"' %>
    </div>
    <p class="text-xs text-ink-3 sm:col-span-2"><%= t(".selector_takes_text_element") %></p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :delay_ms, t(".delay_between_two_requests"), class: "label" %>
      <%= f.number_field :delay_ms, value: provider.setting("delay_ms"), min: 200, class: "input" %>
    </div>
    <div>
      <%= f.label :max_per_run, t(".requests_most_per_run"), class: "label" %>
      <%= f.number_field :max_per_run, value: provider.setting("max_per_run"), min: 1, max: 5000, class: "input" %>
    </div>
  </div>
  <p class="rounded-lg bg-warn-soft px-3 py-2 text-xs text-warn-ink"><%= t(".reading_pages_third_party") %></p>

  <div class="flex flex-wrap items-center gap-2 border-t border-line pt-4">
    <%= text_field_tag :cve, "CVE-2024-6387", class: "input w-44 font-mono text-xs", aria: { label: t(".cve_test") } %>
    <%= f.button t(".test"), type: "submit", formaction: preview_settings_score_providers_path, formmethod: "post", name: nil, class: "btn btn-secondary",
          data: { turbo_stream: true } %>
    <div id="score-provider-test-new" class="min-w-0"></div>
  </div>
  <div class="flex gap-2">
    <%= f.submit provider.persisted? ? t(".save") : t(".add_provider"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), settings_vulnerabilities_path(anchor: "score-providers"), class: "btn btn-ghost" %>
  </div>
<% end %>
