<button type="button" data-action="clipboard#copy"
        class="inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
  <span data-clipboard-target="idle" class="inline-flex items-center gap-1.5"><%= icon :clipboard %> Copier</span>
  <span data-clipboard-target="copied" class="inline-flex items-center gap-1.5 text-emerald-700" hidden><%= icon :check %> Copié</span>
</button>
