<%# Tabs of the settings pages. %>
<h1 class="text-2xl font-bold tracking-tight"><%= t(".title") %></h1>
<nav class="settings-nav scrollbar-none mt-6 flex gap-1 overflow-x-auto border-b border-line" aria-label="<%= t(".title") %>">
  <% [ [ t(".general"), settings_path, controller_path == "settings" ],
       [ t(".notifications"), settings_notifications_path, controller_path.start_with?("settings/notification") ],
       [ t(".users"), settings_users_path, controller_path.in?(%w[settings/users settings/invitations]) ],
       [ t(".vulnerabilities"), settings_vulnerabilities_path, controller_path == "settings/vulnerabilities" ],
       [ t(".docker"), settings_docker_path, controller_path == "settings/docker" ],
       [ t(".extensions"), settings_integrations_path, controller_path == "settings/integrations" ] ].each do |label, path, active| %>
    <%= link_to label, path, aria: { current: (active ? "page" : nil) },
          class: "-mb-px shrink-0 border-b-2 px-4 py-2 whitespace-nowrap text-sm font-medium #{active ? "border-accent text-accent" : "border-transparent text-ink-3 hover:border-line hover:text-ink-2"}" %>
  <% end %>
</nav>
