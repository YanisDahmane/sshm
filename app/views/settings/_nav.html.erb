<%# Tabs of the settings pages. %>
<h1 class="text-2xl font-bold tracking-tight">Paramètres</h1>
<nav class="settings-nav mt-6 flex gap-1 border-b border-line" aria-label="Paramètres">
  <% [ [ "Général", settings_path, controller_path == "settings" ],
       [ "Notifications", settings_notifications_path, controller_path.start_with?("settings/notification") ],
       [ "Automatisations", settings_automations_path, controller_path == "settings/automations" ],
       [ "Utilisateurs", settings_users_path, controller_path.in?(%w[settings/users settings/invitations]) ] ].each do |label, path, active| %>
    <%= link_to label, path, aria: { current: (active ? "page" : nil) },
          class: "-mb-px border-b-2 px-4 py-2 text-sm font-medium #{active ? "border-accent text-accent" : "border-transparent text-ink-3 hover:border-line hover:text-ink-2"}" %>
  <% end %>
</nav>
