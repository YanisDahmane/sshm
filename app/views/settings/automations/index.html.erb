<% content_for :title, "Automatisations · Paramètres · SSHM" %>
<%= render "settings/nav" %>

<p class="mt-6 text-sm text-slate-500">
  Tâches lancées automatiquement à intervalle régulier. Leurs résultats et ce qu'elles détectent apparaissent dans
  <%= link_to "l'activité", activities_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>.
</p>

<div class="mt-6 space-y-4">
  <% @automations.each do |automation| %>
    <section id="<%= dom_id(automation) %>" class="automation rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 max-w-xl">
          <h2 class="flex items-center gap-2 text-base font-semibold">
            <%= automation.label %>
            <% if automation.enabled? %>
              <span class="automation-state rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Activée</span>
            <% else %>
              <span class="automation-state rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Désactivée</span>
            <% end %>
          </h2>
          <p class="mt-1 text-sm text-slate-500"><%= automation.description %></p>
          <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-500">
            <div>
              <dt class="inline">Dernière exécution :</dt>
              <dd class="inline"><%= automation.last_run_at ? relative_time_tag(automation.last_run_at) : "jamais" %></dd>
            </div>
            <% if automation.last_result %>
              <div><dt class="inline">Résultat :</dt> <dd class="automation-result inline"><%= automation.last_result %></dd></div>
            <% end %>
            <% if (next_run = automation.next_run_at) %>
              <div><dt class="inline">Prochaine :</dt> <dd class="inline"><%= relative_time_tag next_run, expired: "à la prochaine minute" %></dd></div>
            <% end %>
          </dl>
        </div>
        <%= button_to "Lancer maintenant", run_settings_automation_path(automation),
              class: "shrink-0 cursor-pointer whitespace-nowrap rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" %>
      </div>

      <%= form_with model: automation, url: settings_automation_path(automation), class: "mt-5 flex flex-wrap items-center gap-4 border-t border-slate-100 pt-4" do |f| %>
        <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
          <%= f.check_box :enabled, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
          Activer
        </label>
        <%= f.select :interval_minutes, Automation::INTERVALS.invert, {}, aria: { label: "Fréquence" },
              class: "rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        <%= f.submit "Enregistrer", class: "cursor-pointer rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <% end %>
    </section>
  <% end %>
</div>
