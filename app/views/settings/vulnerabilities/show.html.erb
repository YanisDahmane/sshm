<% content_for :title, "Vulnérabilités · Paramètres · Elio" %>
<%= render "settings/nav" %>

<section id="vulnerability-feeds" class="card mt-6">
  <div class="card-header">
    <div>
      <h2 class="font-semibold">Bases de vulnérabilités</h2>
      <p class="mt-0.5 text-xs text-ink-3">Téléchargées chaque jour pour les versions présentes sur le parc, puis rapprochées des paquets inventoriés : aucune commande de plus sur les serveurs.</p>
    </div>
    <%= button_to refresh_settings_vulnerabilities_path, class: "btn btn-secondary", form: { class: "shrink-0" } do %>
      <%= icon :arrow_path %> Mettre à jour maintenant
    <% end %>
  </div>
  <ul class="divide-y divide-line">
    <% @feeds.each do |feed| %>
      <li class="vulnerability-feed flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3 text-sm" data-source="<%= feed.source %>">
        <span class="w-56 font-medium"><%= feed.label %></span>
        <% releases = @releases.fetch(feed.source) %>
        <span class="text-xs text-ink-2"><%= releases.any? ? "Versions du parc : #{releases.join(", ")}" : "Aucun serveur concerné" %></span>
        <span class="ml-auto text-xs">
          <% if feed.failed? %>
            <%= status_badge :crit, "Échec", title: feed.last_error, class: "feed-state" %> <span class="text-crit-ink"><%= feed.last_error %></span>
          <% elsif feed.refreshed_at %>
            <%= status_badge :good, "#{feed.entries_count} vulnérabilités", class: "feed-state" %>
            <span class="text-ink-3">mise à jour <%= relative_time_tag feed.refreshed_at %> (<%= feed.origin_label %>)</span>
          <% else %>
            <%= status_badge :neutral, "Jamais mise à jour", class: "feed-state" %>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
  <p class="border-t border-line px-4 py-2.5 text-xs text-ink-3">
    Automatisation « <%= @automation.label %> » : <%= @automation.enabled? ? "active, #{Automation::INTERVALS.fetch(@automation.interval_minutes).downcase}" : "désactivée" %>
    — <%= link_to "Automatisations", settings_automations_path, class: "text-accent hover:underline" %>.
    Sources : <span class="font-mono"><%= Vulnerabilities::DebianTracker::URL %></span>, <span class="font-mono"><%= Vulnerabilities::UbuntuOsv::URL %></span>.
  </p>
</section>

<section id="score-providers" class="card mt-6">
  <div class="card-header">
    <div>
      <h2 class="font-semibold">Fournisseurs de notes</h2>
      <p class="mt-0.5 text-xs text-ink-3">
        La note affichée est la <strong>moyenne</strong> des notes CVSS des fournisseurs actifs ; elle donne la gravité des vulnérabilités que Debian ou Ubuntu n'évaluent pas.
        EPSS et KEV disent si une vulnérabilité est exploitée. <%= @fleet_cves %> CVE sur le parc.
        Automatisation « <%= @scores_automation.label %> » : <%= @scores_automation.enabled? ? Automation::INTERVALS.fetch(@scores_automation.interval_minutes).downcase : "désactivée" %>.
      </p>
    </div>
    <div class="flex shrink-0 gap-2">
      <%= link_to new_settings_score_provider_path, class: "btn btn-secondary" do %><%= icon :plus %> Ajouter<% end %>
      <%= button_to scores_settings_vulnerabilities_path, class: "btn btn-secondary" do %><%= icon :arrow_path %> Mettre à jour<% end %>
    </div>
  </div>
  <ol class="divide-y divide-line">
    <% @providers.each_with_index do |provider, index| %>
      <li class="score-provider flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 text-sm <%= "opacity-60" unless provider.enabled? %>" data-key="<%= provider.key %>">
        <div class="flex flex-col">
          <%= button_to move_settings_score_provider_path(provider, direction: "up"), method: :patch, disabled: index.zero?, class: "btn btn-ghost btn-icon h-5", title: "Monter", aria: { label: "Monter #{provider.name}" } do %><%= icon :chevron_up, class: "h-3.5 w-3.5" %><% end %>
          <%= button_to move_settings_score_provider_path(provider, direction: "down"), method: :patch, disabled: index == @providers.size - 1, class: "btn btn-ghost btn-icon h-5", title: "Descendre", aria: { label: "Descendre #{provider.name}" } do %><%= icon :chevron_down, class: "h-3.5 w-3.5" %><% end %>
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-medium"><%= provider.name %>
            <span class="badge <%= provider.cvss? ? "bg-subtle text-ink-2" : "bg-accent-soft text-accent" %>"><%= provider.cvss? ? "note CVSS" : "exploitation" %></span>
            <% unless provider.enabled? %><span class="badge bg-subtle text-ink-3">désactivé</span><% end %></p>
          <p class="text-xs text-ink-3"><%= provider.description %></p>
          <p class="provider-state text-xs">
            <span class="text-ink-2"><%= @coverage.fetch(provider.key, 0) %> CVE <%= provider.cvss? ? "notées" : (provider.kind == "kev" ? "exploitées" : "avec EPSS") %></span>
            <% if provider.last_run_at %><span class="text-ink-3">· passage <%= relative_time_tag provider.last_run_at %></span><% end %>
            <% if provider.last_error %><span class="text-crit-ink">· <%= provider.last_error %></span><% end %>
          </p>
        </div>
        <%= form_with url: test_settings_score_provider_path(provider), data: { turbo_stream: true }, class: "flex items-center gap-1.5" do %>
          <%= text_field_tag :cve, "CVE-2024-6387", class: "input w-36 py-1 font-mono text-xs", aria: { label: "CVE à tester avec #{provider.name}" } %>
          <button type="submit" class="btn btn-ghost text-xs">Tester</button>
        <% end %>
        <div class="flex items-center gap-1">
          <%= button_to provider.enabled? ? "Désactiver" : "Activer", toggle_settings_score_provider_path(provider), method: :patch, class: "btn btn-secondary text-xs" %>
          <% if provider.custom? %>
            <%= link_to "Modifier", edit_settings_score_provider_path(provider), class: "btn btn-ghost text-xs" %>
            <%= button_to settings_score_provider_path(provider), method: :delete, class: "btn btn-ghost btn-icon", title: "Supprimer", aria: { label: "Supprimer #{provider.name}" },
                  form: { data: { turbo_confirm: "Supprimer « #{provider.name} » et ses notes ?", confirm_variant: "danger" } } do %><%= icon :trash %><% end %>
          <% end %>
        </div>
        <div id="score-provider-test-<%= provider.id %>" class="basis-full empty:hidden"></div>
      </li>
    <% end %>
  </ol>
</section>

<section id="score-colors" class="card mt-6 p-5">
  <h2 class="font-semibold">Couleurs des notes</h2>
  <p class="mt-1 text-xs text-ink-3">Couleur de la pastille d'une note CVSS (0 à 10) dans les listes et le détail d'une vulnérabilité, selon le palier atteint.</p>
  <%= form_with model: @setting, url: settings_vulnerabilities_path, method: :patch, class: "mt-4 space-y-2" do |f| %>
    <% @setting.score_bands.each_with_index do |band, index| %>
      <div class="score-band flex flex-wrap items-center gap-3 text-sm">
        <span class="w-24 text-ink-2">Palier <%= index + 1 %></span>
        <label class="flex items-center gap-1.5">à partir de
          <% if index.zero? %>
            <%= hidden_field_tag "app_setting[score_bands_form][#{index}][from]", 0 %><span class="w-16 font-mono">0</span>
          <% else %>
            <%= number_field_tag "app_setting[score_bands_form][#{index}][from]", band["from"], min: 0.1, max: 10, step: 0.1, class: "input w-20 py-1", aria: { label: "Palier #{index + 1} à partir de" } %>
          <% end %>
        </label>
        <%= select_tag "app_setting[score_bands_form][#{index}][color]", options_for_select(AppSetting::SCORE_COLORS.invert, band["color"]),
              class: "input w-auto py-1", aria: { label: "Couleur du palier #{index + 1}" } %>
        <%= score_pill([ band["from"].to_f, 0.0 ].max + (index.zero? ? 1.5 : 0.5)) %>
      </div>
    <% end %>
    <div class="pt-2"><%= f.submit "Enregistrer les couleurs", class: "btn btn-primary" %></div>
  <% end %>
</section>

<section id="vulnerability-import" class="card mt-6 p-5">
  <h2 class="font-semibold">Importer une base à la main</h2>
  <p class="mt-1 text-xs text-ink-3">Pour un réseau fermé : téléchargez le fichier ailleurs puis envoyez-le ici. Il remplace la base correspondante, reconnue à son contenu.</p>
  <ul class="mt-2 list-disc pl-5 text-xs text-ink-2">
    <li>Debian : <span class="font-mono"><%= Vulnerabilities::DebianTracker::URL %></span> (JSON)</li>
    <li>Ubuntu : <span class="font-mono"><%= Vulnerabilities::UbuntuOsv::URL %></span> (zip)</li>
  </ul>
  <%= form_with url: import_settings_vulnerabilities_path, multipart: true, data: { turbo: false }, class: "mt-4 flex flex-wrap items-center gap-3" do |f| %>
    <%= f.file_field :file, accept: ".json,.zip,application/json,application/zip", required: true, class: "text-sm", aria: { label: "Fichier de la base" } %>
    <%= f.submit "Importer", class: "btn btn-secondary" %>
  <% end %>
</section>

<section id="vulnerability-alerts" class="card mt-6 p-5">
  <h2 class="font-semibold">Alertes</h2>
  <p class="mt-1 text-xs text-ink-3">Une vulnérabilité <strong>corrigeable</strong> (une version qui la corrige existe) à partir de cette gravité rend le serveur critique et enregistre l'activité « Vulnérabilité corrigeable » (notifiable).</p>
  <p class="mt-1 text-xs text-ink-3">Debian n'évalue qu'une petite partie de ses vulnérabilités (la plupart restent « non évaluées ») : pour être prévenu de toutes celles qu'une mise à jour corrige, choisissez « Toutes les corrigeables ». Ubuntu donne une priorité à presque toutes.</p>
  <%= form_with model: @setting, url: settings_vulnerabilities_path, method: :patch, class: "mt-4 flex flex-wrap items-center gap-3" do |f| %>
    <%= f.label :vulnerability_alert_severity, "Gravité minimale", class: "label mb-0" %>
    <%= f.select :vulnerability_alert_severity, AppSetting::VULNERABILITY_ALERTS.invert, {}, class: "input w-auto" %>
    <%= f.submit "Enregistrer", class: "btn btn-primary" %>
  <% end %>
</section>
