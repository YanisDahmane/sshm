<% content_for :title, t("title", page: "#{t("settings.nav.docker")} · #{t("settings.nav.title")}") %>
<%= render "settings/nav" %>

<%= form_with model: @setting, url: settings_docker_path, method: :patch do |f| %>
  <section id="docker-alerts" class="card mt-6 p-5">
    <h2 class="font-semibold">Alertes</h2>
    <p class="mt-1 text-xs text-ink-3"><%= t(".what_containers_images_report") %></p>
    <div class="mt-4 space-y-2 text-sm">
      <label class="flex items-start gap-2"><%= f.check_box :docker_alert_unhealthy, class: "mt-0.5" %>
        <span><%= t(".unhealthy_html") %> <span class="block text-xs text-ink-3"><%= t(".healthcheck_fails") %></span></span></label>
      <label class="flex items-start gap-2"><%= f.check_box :docker_alert_restarts, class: "mt-0.5" %>
        <span><%= t(".looping_html") %> <span class="block text-xs text-ink-3"><%= t(".restarting_state_least_restarts_html", _: (Inventory::Collectors::Docker::LOOP_RESTARTS), in_minutes_to_i: (Inventory::Collectors::Docker::LOOP_WINDOW.in_minutes.to_i)) %></span></span></label>
      <label class="flex items-start gap-2"><%= f.check_box :docker_alert_updates, class: "mt-0.5" %>
        <span><%= t(".updates_html") %> <span class="block text-xs text-ink-3"><%= t(".handy_latest_1_27") %></span></span></label>
    </div>
  </section>

  <section id="docker-registries" class="card mt-6 p-5">
    <h2 class="font-semibold"><%= t(".private_registries") %></h2>
    <p class="mt-1 text-xs text-ink-3"><%= t(".registries_html") %></p>
    <pre class="mt-2 rounded-lg bg-subtle px-3 py-2 font-mono text-xs text-ink-2"><%= t(".registries_example") %></pre>
    <p class="registries-configured mt-3 text-xs text-ink-2">
      <%= @registries.any? ? t(".credentials_saved_leave_empty", registries_join: (@registries.join(", "))) : t(".credentials_saved") %>
    </p>
    <%= f.text_area :docker_registry_credentials, value: "", rows: 3, autocomplete: "off", spellcheck: false, class: "input mt-2 font-mono text-xs",
          aria: { label: t(".registry_credentials") }, placeholder: "registre utilisateur jeton" %>
    <% if @registries.any? %>
      <label class="mt-2 flex items-center gap-2 text-xs"><%= t(".delete_saved_credentials_html", clear_credentials: (check_box_tag :clear_credentials, "1")) %></label>
    <% end %>
  </section>

  <div class="mt-4"><%= f.submit t(".save"), class: "btn btn-primary" %></div>
<% end %>

<section id="docker-image-checks" class="card mt-6">
  <div class="card-header">
    <div>
      <h2 class="font-semibold"><%= t(".image_checks") %></h2>
      <p class="mt-0.5 text-xs text-ink-3">
        <%= t(".automation_html", label: @automation.label) %> <%= @automation.enabled? ? t("settings.automation_active", interval: Automation.interval_label(@automation.interval_minutes).downcase) : t(".automation_off") %>
        <% if @automation.last_result %><%= t(".last_run_html", last_result: @automation.last_result) %><% end %>.
      </p>
    </div>
    <%= button_to check_settings_docker_path, class: "btn btn-secondary", form: { class: "shrink-0" } do %><%= icon :arrow_path %> <%= t(".check_now") %><% end %>
  </div>
  <% if @updates.any? %>
    <div class="overflow-x-auto">
      <table class="table-dense">
        <thead><tr><th class="pl-4">Image</th><th>Registre</th><th><%= t(".checked") %></th><th class="pr-4"><%= t(".result") %></th></tr></thead>
        <tbody>
          <% @updates.each do |update| %>
            <tr class="image-check">
              <td class="pl-4 font-mono text-xs"><%= update.reference %></td>
              <td class="text-xs text-ink-2"><%= update.registry %></td>
              <td class="text-xs"><%= update.checked_at ? relative_time_tag(update.checked_at) : "—" %></td>
              <td class="pr-4 text-xs"><%= update.error ? tag.span(update.error, class: "text-crit-ink") : tag.span(update.remote_digest.to_s.first(19), class: "font-mono text-ink-3", title: update.remote_digest) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="px-4 py-4 text-sm text-ink-3"><%= t(".image_checked_yet") %></p>
  <% end %>
</section>
