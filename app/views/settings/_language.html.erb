<section id="language" class="card mt-6">
  <div class="card-header">
    <h2 class="font-semibold"><%= t(".title") %></h2>
  </div>
  <%= form_with model: app_settings, url: settings_language_path, method: :patch, class: "flex flex-wrap items-end gap-3 p-4" do |f| %>
    <div>
      <%= f.label :default_locale, t(".label"), class: "label" %>
      <%= f.select :default_locale, locale_options, {}, class: "input mt-1 w-auto" %>
    </div>
    <%= f.submit t(".save"), class: "btn btn-secondary" %>
    <p class="basis-full text-xs text-ink-3"><%= t(".hint") %></p>
  <% end %>
</section>
