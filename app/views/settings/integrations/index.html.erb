<% content_for :title, t("title", page: "#{t("settings.nav.extensions")} · #{t("settings.nav.title")}") %>
<%= render "settings/nav" %>

<p class="mt-6 text-sm text-ink-3">
  <%= t(".intro_html") %>
</p>

<div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
  <% @integrations.each do |integration| %>
    <section id="integration-<%= integration.kind %>" class="integration card flex flex-col p-5">
      <div class="flex items-start justify-between gap-3">
        <h2 class="flex items-center gap-2 font-semibold"><%= icon integration.icon, class: "h-5 w-5 text-ink-3" %><%= integration.label %></h2>
        <%= integration.enabled? ? status_badge(:good, t(".text"), class: "integration-state") : status_badge(:neutral, t(".off"), class: "integration-state") %>
      </div>
      <p class="mt-2 flex-1 text-sm text-ink-2"><%= integration.description %></p>
      <% if integration.enabled? %>
        <p class="mt-3 text-xs text-ink-3">
          <% if integration.last_error %>
            <span class="integration-error text-crit-ink"><%= integration.last_error %></span>
          <% elsif integration.last_synced_at %>
            <%= t(".synchronized_html", last_synced_at: (relative_time_tag integration.last_synced_at)) %>
          <% else %>
            <%= t(".not_synchronized_yet") %>
          <% end %>
        </p>
      <% end %>
      <div class="mt-4">
        <%= link_to (integration.enabled? ? t(".configure") : t(".configure_turn")), edit_settings_integration_path(integration.kind), class: "btn btn-secondary" %>
      </div>
    </section>
  <% end %>
</div>
<% if @integrations.empty? %>
  <p class="card mt-5 px-4 py-6 text-sm text-ink-3"><%= t(".extension_available") %></p>
<% end %>
