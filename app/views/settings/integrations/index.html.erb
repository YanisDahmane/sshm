<% content_for :title, "Extensions · Paramètres · Elio" %>
<%= render "settings/nav" %>

<p class="mt-6 text-sm text-ink-3">
  Les extensions relient Elio à vos autres outils, <strong class="font-medium text-ink-2">en lecture seule</strong> : Elio n'y crée, ne modifie et ne supprime rien.
  Une extension désactivée n'apparaît nulle part dans l'interface.
</p>

<div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
  <% @integrations.each do |integration| %>
    <section id="integration-<%= integration.kind %>" class="integration card flex flex-col p-5">
      <div class="flex items-start justify-between gap-3">
        <h2 class="flex items-center gap-2 font-semibold"><%= icon integration.icon, class: "h-5 w-5 text-ink-3" %><%= integration.label %></h2>
        <%= integration.enabled? ? status_badge(:good, "Activée", class: "integration-state") : status_badge(:neutral, "Désactivée", class: "integration-state") %>
      </div>
      <p class="mt-2 flex-1 text-sm text-ink-2"><%= integration.description %></p>
      <% if integration.enabled? %>
        <p class="mt-3 text-xs text-ink-3">
          <% if integration.last_error %>
            <span class="integration-error text-crit-ink"><%= integration.last_error %></span>
          <% elsif integration.last_synced_at %>
            Synchronisée <%= relative_time_tag integration.last_synced_at %>
          <% else %>
            Pas encore synchronisée
          <% end %>
        </p>
      <% end %>
      <div class="mt-4">
        <%= link_to (integration.enabled? ? "Configurer" : "Configurer et activer"), edit_settings_integration_path(integration.kind), class: "btn btn-secondary" %>
      </div>
    </section>
  <% end %>
</div>
<% if @integrations.empty? %>
  <p class="card mt-5 px-4 py-6 text-sm text-ink-3">Aucune extension disponible.</p>
<% end %>
