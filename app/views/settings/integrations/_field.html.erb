<%# One field of an extension's form (Integrations::Base::Field). %>
<% name = "integration[values][#{field.key}]" %>
<% id = "integration_#{field.key}" %>
<% value = integration.value(field.key) %>
<div class="integration-field" data-field="<%= field.key %>">
  <% case field.type %>
  <% when :boolean %>
    <label class="flex cursor-pointer items-start gap-2 text-sm text-ink-2">
      <%= hidden_field_tag name, "0", id: nil %>
      <%= check_box_tag name, "1", value, id: id, class: "mt-0.5 h-4 w-4 rounded border-line text-accent" %>
      <span><span class="font-medium text-ink"><%= field.label %></span><% if field.hint %> <span class="text-ink-3">— <%= field.hint %></span><% end %></span>
    </label>
  <% when :checkboxes %>
    <fieldset>
      <legend class="label"><%= field.label %></legend>
      <%= hidden_field_tag "#{name}[]", "", id: nil %>
      <div class="mt-2 grid grid-cols-1 gap-1.5 sm:grid-cols-2">
        <% field.options.each do |option_value, option_label| %>
          <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-2">
            <%= check_box_tag "#{name}[]", option_value, Array(value).include?(option_value.to_s), id: "#{id}_#{option_value}", class: "h-4 w-4 rounded border-line text-accent" %>
            <%= option_label %>
          </label>
        <% end %>
      </div>
      <% if field.hint %><p class="mt-1 text-xs text-ink-3"><%= field.hint %></p><% end %>
    </fieldset>
  <% else %>
    <%= label_tag id, class: "label" do %><%= field.label %><% unless field.required %> <span class="font-normal text-ink-3"><%= t(".optional") %></span><% end %><% end %>
    <% if field.secret %>
      <%= password_field_tag name, nil, id: id, autocomplete: "off", class: "input mt-1 font-mono text-xs",
            placeholder: (integration.secret?(field.key) ? t(".leave_empty_keep") : field.placeholder) %>
    <% elsif field.type == :select %>
      <%= select_tag name, options_for_select(field.options, value), id: id, class: "input mt-1 w-auto" %>
    <% elsif field.type == :number %>
      <%= number_field_tag name, value, id: id, step: "any", class: "input mt-1 w-32", placeholder: field.placeholder %>
    <% elsif field.type == :list %>
      <%= text_field_tag name, Array(value).join(", "), id: id, class: "input mt-1 font-mono text-xs", placeholder: field.placeholder %>
    <% else %>
      <%= text_field_tag name, value, id: id, class: "input mt-1 #{"font-mono text-xs" if field.type == :url}", placeholder: field.placeholder,
            autocomplete: "off", spellcheck: false %>
    <% end %>
    <% if field.hint %><p class="mt-1 text-xs text-ink-3"><%= field.hint %></p><% end %>
  <% end %>
</div>
