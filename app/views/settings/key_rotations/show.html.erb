<% content_for :title, "Rotation de la clé Elio · Elio" %>
<%= render "settings/nav" %>

<div class="mx-auto mt-8 max-w-3xl">
  <%= link_to "← Clé SSH de l'application", settings_path, class: "text-sm text-ink-3 hover:text-ink-2" %>
  <h2 class="mt-2 text-xl font-semibold">Rotation de la clé Elio</h2>
  <p class="mt-1 text-sm text-ink-3">
    Lancée par <%= @rotation.started_by&.email || "un utilisateur supprimé" %> <%= relative_time_tag @rotation.created_at %>.
    Pendant la rotation, Elio se connecte avec l'ancienne ou la nouvelle clé : aucun serveur ne perd l'accès.
  </p>

  <%# No src here: Turbo refuses a frame whose src is the page itself (auto-refresh sets it). %>
  <%= turbo_frame_tag dom_id(@rotation), class: "block" do %>
    <% if @rotation.running? %>
      <div data-controller="auto-refresh" hidden></div>
    <% end %>

    <section id="rotation-summary" class="mt-6 rounded-xl border border-line bg-surface p-6 shadow-sm">
      <% if @rotation.status == :running %>
        <p class="rotation-status flex items-center gap-2 text-sm font-medium text-accent">
          <%= icon :arrow_path, class: "h-4 w-4 animate-spin" %> En cours : <%= @rotation.servers_done %>/<%= @rotation.servers_count %> serveur(s)
        </p>
      <% elsif @rotation.status == :activated %>
        <p class="rotation-status flex items-center gap-2 text-sm font-medium text-good-ink">
          <%= icon :check, class: "h-4 w-4" %> Terminée : la nouvelle clé est active, l'ancienne a été supprimée.
          <%= "(finalisée malgré #{@rotation.failed_count} échec(s))" if @rotation.forced %>
        </p>
      <% else %>
        <p class="rotation-status flex items-center gap-2 text-sm font-medium text-crit-ink">
          <%= icon :x_mark, class: "h-4 w-4" %> <%= pluralize(@rotation.failed_count, "serveur en échec", plural: "serveurs en échec") %> : ils gardent l'ancienne clé, qui reste utilisable.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <%= button_to "Relancer les échecs", retry_settings_key_rotation_path(@rotation), data: { turbo_frame: "_top" },
                class: "btn btn-primary" %>
          <%= button_to "Finaliser malgré les échecs", finalize_settings_key_rotation_path(@rotation),
                form: { data: { turbo_frame: "_top", turbo_confirm: "L'ancienne clé sera supprimée : Elio perdra l'accès aux serveurs en échec tant que la nouvelle clé n'y sera pas installée.",
                                confirm_label: "Finaliser", confirm_variant: "danger" } },
                class: "cursor-pointer rounded-md border border-crit/40 bg-surface px-3 py-1.5 text-sm font-medium text-crit-ink shadow-sm hover:bg-crit-soft" %>
        </div>
      <% end %>
    </section>

    <% if @rotation.steps.any? %>
      <ul id="rotation-steps" class="mt-4 divide-y divide-line rounded-xl border border-line bg-surface text-sm shadow-sm">
        <% @rotation.steps.each do |step| %>
          <li class="rotation-step flex items-start gap-3 px-4 py-3 is-<%= step.status %>">
            <span class="mt-0.5 <%= step.rotated? ? "text-good-ink" : "text-crit-ink" %>"><%= icon(step.rotated? ? :check : :x_mark) %></span>
            <div class="min-w-0 flex-1">
              <p><span class="font-medium"><%= step.server_name %></span> — <%= step.rotated? ? "nouvelle clé installée et vérifiée, ancienne retirée" : "échec : #{step.phase_label}" %></p>
              <% if step.error_message %><p class="mt-0.5 break-all font-mono text-xs text-crit-ink"><%= step.error_message %></p><% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
