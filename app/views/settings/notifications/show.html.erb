<% content_for :title, t("title", page: "#{t("settings.nav.notifications")} · #{t("settings.nav.title")}") %>
<%= render "settings/nav" %>

<div class="mt-6 flex flex-wrap items-center justify-between gap-4">
  <p class="max-w-2xl text-sm text-ink-3">
    <%= t(".receive_elio_s_activities") %>
  </p>
  <%= link_to new_settings_notification_channel_path,
        class: "btn btn-primary shrink-0" do %>
    <%= t(".add_channel") %>
  <% end %>
</div>

<% if @channels.any? %>
  <div class="mt-6 space-y-4">
    <% @channels.each do |channel| %>
      <section id="<%= dom_id(channel) %>" class="notification-channel rounded-xl border border-line bg-surface p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <h2 class="flex flex-wrap items-center gap-2 text-base font-semibold">
              <%= channel.name %>
              <span class="channel-kind-label rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent ring-1 ring-inset ring-accent/20"><%= channel.kind_label %></span>
              <% if channel.enabled? %>
                <span class="channel-state rounded-full bg-good-soft px-2 py-0.5 text-xs font-medium text-good-ink ring-1 ring-inset ring-good/20"><%= t("words.active") %></span>
              <% else %>
                <span class="channel-state rounded-full bg-subtle px-2 py-0.5 text-xs font-medium text-ink-2"><%= t(".paused") %></span>
              <% end %>
              <% if channel.mention_channel && channel.mentions? %>
                <span class="channel-mention rounded-full bg-warn-soft px-2 py-0.5 text-xs font-medium text-warn-ink ring-1 ring-inset ring-warn/20"><%= channel.kind == "discord" ? "@everyone" : "@channel" %></span>
              <% end %>
              <% if channel.daily_digest %>
                <span class="channel-digest rounded-full bg-subtle px-2 py-0.5 text-xs font-medium text-ink-2"><%= t(".daily_digest") %></span>
              <% end %>
            </h2>
            <p class="mt-1 break-all font-mono text-xs text-ink-3"><%= channel.masked_destination %></p>
            <% if channel.kind == "webhook" %>
              <details class="channel-secret mt-2 text-xs" data-controller="clipboard">
                <summary class="cursor-pointer text-ink-3 hover:text-ink"><%= t(".secret_html", body: tag.code("timestamp.body", class: "font-mono"), timestamp: tag.code("X-Elio-Timestamp", class: "font-mono"), signature: tag.code("X-Elio-Signature: sha256=…", class: "font-mono")) %>  </summary>
                <div class="mt-2 flex items-center gap-2">
                  <input readonly value="<%= channel.signing_secret %>" data-clipboard-target="source" aria-label="<%= t(".signing_secret") %>" class="input py-1 font-mono text-xs">
                  <%= render "settings/copy_button" %>
                </div>
              </details>
            <% end %>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <%= button_to t(".send_test"), test_settings_notification_channel_path(channel),
                  class: "btn btn-secondary whitespace-nowrap" %>
            <%= link_to edit_settings_notification_channel_path(channel), title: t(".edit"), aria: { label: t(".edit_2", channel_name: channel.name) },
                  class: "rounded-md p-1.5 text-ink-3 hover:bg-subtle hover:text-ink-2" do %>
              <%= icon :pencil_square %>
            <% end %>
            <%= button_to settings_notification_channel_path(channel), method: :delete, title: t(".delete"), aria: { label: t(".delete_2", channel_name: channel.name) },
                  form: { data: { turbo_confirm: t(".channel_will_longer_receive", channel_name: channel.name), confirm_label: t(".delete"), confirm_variant: "danger" } },
                  class: "cursor-pointer rounded-md p-1.5 text-ink-3 hover:bg-crit-soft hover:text-crit-ink" do %>
              <%= icon :trash %>
            <% end %>
          </div>
        </div>

        <div class="mt-4">
          <p class="text-xs font-medium uppercase tracking-wide text-ink-3"><%= t("count.activities_notified", count: channel.activity_kinds.size) %></p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% Activity::KINDS.values.select { |kind| channel.subscribed_to?(kind.key) }.each do |kind| %>
              <span class="channel-kind inline-flex items-center gap-1.5 rounded-full bg-subtle px-2 py-0.5 text-xs text-ink-2 ring-1 ring-inset ring-line">
                <%= render "activities/severity", severity: kind.severity %><%= kind.label %>
              </span>
            <% end %>
          </div>
        </div>

        <% if channel.last_error %>
          <p class="channel-error mt-4 rounded-md border border-crit/40 bg-crit-soft px-3 py-2 text-xs text-crit-ink"><%= t(".last_delivery_failed_html", last_error: channel.last_error) %></p>
        <% elsif channel.last_delivered_at %>
          <p class="mt-4 text-xs text-ink-3"><%= t(".last_delivery_html", last_delivered_at: (relative_time_tag channel.last_delivered_at)) %></p>
        <% end %>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="mt-6 rounded-xl border border-dashed border-line bg-surface px-6 py-12 text-center">
    <p class="text-sm text-ink-3"><%= t(".notification_channel_yet") %></p>
    <%= link_to t(".add_your_first_channel"), new_settings_notification_channel_path, class: "mt-2 inline-block text-sm font-medium text-accent hover:text-accent" %>
  </div>
<% end %>
