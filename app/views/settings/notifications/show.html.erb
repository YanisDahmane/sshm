<% content_for :title, "Notifications · Paramètres · Elio" %>
<%= render "settings/nav" %>

<div class="mt-6 flex flex-wrap items-center justify-between gap-4">
  <p class="max-w-2xl text-sm text-ink-3">
    Recevez les activités d'Elio dans Slack. Chaque canal choisit les activités qu'il reçoit et peut mentionner <code class="font-mono text-xs">@channel</code>.
  </p>
  <%= link_to new_settings_notification_channel_path,
        class: "inline-flex shrink-0 items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-hover" do %>
    Ajouter un canal Slack
  <% end %>
</div>

<% if @channels.any? %>
  <div class="mt-6 space-y-4">
    <% @channels.each do |channel| %>
      <section id="<%= dom_id(channel) %>" class="notification-channel rounded-xl border border-line bg-surface p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <h2 class="flex flex-wrap items-center gap-2 text-base font-semibold">
              <%= channel.name %>
              <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent ring-1 ring-inset ring-accent/20">Slack</span>
              <% if channel.enabled? %>
                <span class="channel-state rounded-full bg-good-soft px-2 py-0.5 text-xs font-medium text-good-ink ring-1 ring-inset ring-good/20">Actif</span>
              <% else %>
                <span class="channel-state rounded-full bg-subtle px-2 py-0.5 text-xs font-medium text-ink-2">En pause</span>
              <% end %>
              <% if channel.mention_channel %>
                <span class="channel-mention rounded-full bg-warn-soft px-2 py-0.5 text-xs font-medium text-warn-ink ring-1 ring-inset ring-warn/20">@channel</span>
              <% end %>
            </h2>
            <p class="mt-1 break-all font-mono text-xs text-ink-3"><%= channel.masked_webhook_url %></p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <%= button_to "Envoyer un test", test_settings_notification_channel_path(channel),
                  class: "cursor-pointer whitespace-nowrap rounded-md border border-line bg-surface px-3 py-1.5 text-sm font-medium text-ink-2 shadow-sm hover:bg-subtle" %>
            <%= link_to edit_settings_notification_channel_path(channel), title: "Modifier", aria: { label: "Modifier #{channel.name}" },
                  class: "rounded-md p-1.5 text-ink-3 hover:bg-subtle hover:text-ink-2" do %>
              <%= icon :pencil_square %>
            <% end %>
            <%= button_to settings_notification_channel_path(channel), method: :delete, title: "Supprimer", aria: { label: "Supprimer #{channel.name}" },
                  form: { data: { turbo_confirm: "Le canal « #{channel.name} » ne recevra plus aucune notification.", confirm_label: "Supprimer", confirm_variant: "danger" } },
                  class: "cursor-pointer rounded-md p-1.5 text-ink-3 hover:bg-crit-soft hover:text-crit-ink" do %>
              <%= icon :trash %>
            <% end %>
          </div>
        </div>

        <div class="mt-4">
          <p class="text-xs font-medium uppercase tracking-wide text-ink-3"><%= pluralize(channel.activity_kinds.size, "activité notifiée", plural: "activités notifiées") %></p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% Activity::KINDS.values.select { |kind| channel.subscribed_to?(kind.key) }.each do |kind| %>
              <span class="channel-kind inline-flex items-center gap-1.5 rounded-full bg-subtle px-2 py-0.5 text-xs text-ink-2 ring-1 ring-inset ring-line">
                <%= render "activities/severity", severity: kind.severity %><%= kind.label %>
              </span>
            <% end %>
          </div>
        </div>

        <% if channel.last_error %>
          <p class="channel-error mt-4 rounded-md border border-crit/40 bg-crit-soft px-3 py-2 text-xs text-crit-ink">Dernier envoi en échec : <%= channel.last_error %></p>
        <% elsif channel.last_delivered_at %>
          <p class="mt-4 text-xs text-ink-3">Dernier envoi <%= relative_time_tag channel.last_delivered_at %>.</p>
        <% end %>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="mt-6 rounded-xl border border-dashed border-line bg-surface px-6 py-12 text-center">
    <p class="text-sm text-ink-3">Aucun canal de notification pour le moment.</p>
    <%= link_to "Ajouter votre premier canal Slack", new_settings_notification_channel_path, class: "mt-2 inline-block text-sm font-medium text-accent hover:text-accent" %>
  </div>
<% end %>
