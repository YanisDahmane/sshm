<% input_class = "input mt-1" %>
<% label_class = "label" %>

<%= form_with model: channel, url: (channel.persisted? ? settings_notification_channel_path(channel) : settings_notification_channels_path), class: "space-y-6",
      data: { controller: "kind-fields" } do |f| %>
  <%= render "shared/form_errors", record: channel %>

  <div>
    <%= f.label :name, t(".name"), class: label_class %>
    <%= f.text_field :name, required: true, autofocus: true, placeholder: "#ops-alertes", class: input_class %>
  </div>

  <div>
    <%= f.label :locale, t(".language"), class: label_class %>
    <%= f.select :locale, locale_options(blank: t(".instance_language", language: Elio::Locales.names.fetch(app_settings.default_locale.to_sym))), {}, class: "#{input_class} w-auto" %>
    <p class="mt-1 text-xs text-ink-3"><%= t(".language_hint") %></p>
  </div>

  <fieldset>
    <legend class="<%= label_class %>"><%= t(".type") %></legend>
    <div class="mt-2 flex flex-wrap gap-4">
      <% NotificationChannel::KINDS.each do |value| %>
        <% label = NotificationChannel.kind_label(value) %>
        <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-2">
          <%= f.radio_button :kind, value, disabled: channel.persisted? && channel.kind != value,
                data: { kind_fields_target: "kind", action: "kind-fields#update" }, class: "h-4 w-4 border-line text-accent" %>
          <%= label %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div data-kind-fields-target="field" data-kinds="slack discord webhook">
    <%= f.label :webhook_url, t(".webhook_url"), class: label_class %>
    <%= f.password_field :webhook_url, value: nil, autocomplete: "off",
          placeholder: (channel.persisted? && channel.webhook_url ? t(".leave_empty_keep", masked_destination: channel.masked_destination) : "https://…"),
          class: "#{input_class} font-mono text-xs" %>
    <p class="mt-1 text-xs text-ink-3">
      <%= t(".webhook_help_html", slack: tag.em("Apps → Incoming Webhooks"), discord: tag.em(t(".discord_path")), timestamp: tag.code("X-Elio-Timestamp", class: "font-mono"), signature: tag.code("X-Elio-Signature", class: "font-mono")) %>   
    </p>
  </div>

  <div data-kind-fields-target="field" data-kinds="email">
    <%= f.label :recipients, t(".recipients"), class: label_class %>
    <%= f.text_field :recipients, placeholder: "ops@acme.fr, alice@acme.fr", autocomplete: "off", class: input_class %>
    <p class="mt-1 text-xs text-ink-3">
      <%= t(".up_addresses_separated_commas_html", _: (NotificationChannel::MAX_RECIPIENTS)) %>
      <% unless Rails.configuration.x.mail_enabled %><span class="text-warn-ink"><%= t(".sending_emails_not_configured") %></span><% end %>
    </p>
  </div>

  <fieldset>
    <legend class="text-sm font-medium text-ink-2"><%= t(".activities_notify") %></legend>
    <%= hidden_field_tag "notification_channel[activity_kinds][]", "" %>
    <div class="mt-2 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% Activity::KINDS.values.group_by(&:category).each do |category, kinds| %>
        <div class="activity-kind-group rounded-md border border-line p-3" data-controller="check-all">
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-ink"><%= Activity.category_label(category) %></p>
            <button type="button" data-action="check-all#toggle" class="cursor-pointer text-xs font-medium text-accent hover:text-accent"><%= t(".all_none") %></button>
          </div>
          <div class="mt-2 space-y-1.5">
            <% kinds.each do |kind| %>
              <label class="flex cursor-pointer items-start gap-2 text-sm text-ink-2" title="<%= kind.description %>">
                <%= check_box_tag "notification_channel[activity_kinds][]", kind.key, channel.subscribed_to?(kind.key),
                      id: "activity_kind_#{kind.key}", data: { check_all_target: "checkbox" }, class: "mt-0.5 h-4 w-4 rounded border-line text-accent" %>
                <span class="flex items-center gap-1.5"><%= render "activities/severity", severity: kind.severity %><%= kind.label %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>

  <div class="space-y-3">
    <label class="flex cursor-pointer items-start gap-2 text-sm text-ink-2" data-kind-fields-target="field" data-kinds="slack discord">
      <%= f.check_box :mention_channel, class: "mt-0.5 h-4 w-4 rounded border-line text-accent" %>
      <span><%= t(".mention_html", channel: tag.code("@channel", class: "font-mono text-xs"), everyone: tag.code("@everyone", class: "font-mono text-xs")) %></span>
    </label>
    <label class="flex cursor-pointer items-start gap-2 text-sm text-ink-2">
      <%= f.check_box :daily_digest, class: "mt-0.5 h-4 w-4 rounded border-line text-accent" %>
      <span><%= t(".daily_digest") %> <span class="text-ink-3"><%= t(".every_morning_8_00") %></span></span>
    </label>
    <label class="flex cursor-pointer items-start gap-2 text-sm text-ink-2">
      <%= f.check_box :enabled, class: "mt-0.5 h-4 w-4 rounded border-line text-accent" %>
      <span>Actif <span class="text-ink-3"><%= t(".uncheck_pause_channel") %></span></span>
    </label>
  </div>

  <div class="flex items-center justify-end gap-3 border-t border-line pt-4">
    <%= link_to t(".cancel"), settings_notifications_path, class: "btn btn-ghost" %>
    <%= f.submit channel.persisted? ? t(".save") : t(".add_channel"), class: "btn btn-primary" %>
  </div>
<% end %>
