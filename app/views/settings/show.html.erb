<% content_for :title, "Paramètres · SSHM" %>

<%= render "settings/nav" %>

<section id="ssh-key" class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold">Clé SSH de l'application</h2>
  <p class="mt-1 text-sm text-slate-500">
    SSHM se connecte à vos serveurs avec cette clé. Sa clé publique doit être ajoutée au fichier
    <code class="rounded bg-slate-100 px-1 font-mono text-xs">~/.ssh/authorized_keys</code> de l'utilisateur configuré sur chaque serveur.
    La clé privée reste chiffrée dans la base et n'est jamais affichée.
  </p>

  <% if @ssh_key %>
    <dl class="mt-6 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium text-slate-700">Empreinte</dt>
        <dd id="ssh-key-fingerprint" class="mt-1 break-all font-mono text-slate-600"><%= @ssh_key.fingerprint %></dd>
      </div>
      <div>
        <dt class="font-medium text-slate-700">Générée le</dt>
        <dd class="mt-1 text-slate-600"><%= relative_time_tag @ssh_key.created_at %></dd>
      </div>
    </dl>

    <div class="mt-6" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="ssh-public-key" class="text-sm font-medium text-slate-700">Clé publique</label>
        <%= render "copy_button" %>
      </div>
      <textarea id="ssh-public-key" readonly rows="3" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-slate-300 bg-slate-50 px-3 py-2 font-mono text-xs text-slate-700"><%= @ssh_key.public_key %></textarea>
    </div>

    <div class="mt-6" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="ssh-install-command" class="text-sm font-medium text-slate-700">Commande à lancer sur chaque serveur</label>
        <%= render "copy_button" %>
      </div>
      <textarea id="ssh-install-command" readonly rows="3" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-slate-300 bg-slate-900 px-3 py-2 font-mono text-xs text-slate-100"><%= ssh_key_install_command(@ssh_key) %></textarea>
    </div>

    <div class="mt-6 flex items-center justify-between gap-4 border-t border-slate-200 pt-6">
      <p class="text-sm text-slate-500">Régénérer la clé coupe l'accès à tous les serveurs jusqu'à ce que la nouvelle clé publique y soit ajoutée.</p>
      <%= button_to "Régénérer la clé", ssh_key_path,
            data: { turbo_confirm: "L'ancienne clé sera définitivement supprimée et SSHM ne pourra plus se connecter aux serveurs tant que la nouvelle clé publique n'y aura pas été ajoutée.",
                    confirm_label: "Régénérer la clé", confirm_variant: "danger" },
            class: "shrink-0 cursor-pointer rounded-md border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-700 shadow-sm hover:bg-red-50" %>
    </div>
  <% else %>
    <div class="mt-6 rounded-lg border border-dashed border-slate-300 px-6 py-10 text-center">
      <p class="text-sm text-slate-500">Aucune clé SSH n'a encore été générée.</p>
      <%= button_to "Générer une clé SSH", ssh_key_path,
            class: "mt-4 cursor-pointer rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    </div>
  <% end %>
</section>
