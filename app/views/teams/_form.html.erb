<% input_class = "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
<% label_class = "block text-sm font-medium text-slate-700" %>
<% profiles = Profile.order(:name) %>

<%= form_with model: team, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", record: team %>

  <div>
    <%= f.label :name, "Nom", class: label_class %>
    <%= f.text_field :name, autofocus: true, required: true, maxlength: 50, placeholder: "Développeurs", class: input_class %>
  </div>

  <div>
    <%= f.label :description, "Description (facultatif)", class: label_class %>
    <%= f.text_area :description, rows: 2, maxlength: 500, placeholder: "Qui en fait partie, à quoi elle sert…", class: input_class %>
  </div>

  <fieldset data-controller="check-all">
    <div class="flex items-center justify-between">
      <legend class="<%= label_class %>">Profils</legend>
      <% if profiles.any? %>
        <button type="button" data-action="check-all#toggle" class="cursor-pointer text-xs font-medium text-indigo-600 hover:text-indigo-500">Tout cocher / décocher</button>
      <% end %>
    </div>
    <%= hidden_field_tag "team[profile_ids][]", "", id: nil %>
    <% if profiles.any? %>
      <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
        <% profiles.each do |profile| %>
          <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-200 px-3 py-2 text-sm hover:bg-slate-50 has-[:checked]:border-indigo-300 has-[:checked]:bg-indigo-50/50">
            <%= check_box_tag "team[profile_ids][]", profile.id, team.profile_ids.include?(profile.id), id: "team_profile_ids_#{profile.id}",
                  data: { check_all_target: "checkbox" }, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
            <span class="min-w-0">
              <span class="block truncate font-medium"><%= profile.name %></span>
              <span class="block truncate text-xs text-slate-500"><%= profile.authorized_key&.comment || profile.authorized_key&.type %></span>
            </span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">Aucun profil pour le moment : vous pourrez en ajouter à l'équipe plus tard.</p>
    <% end %>
  </fieldset>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to "Annuler", team.persisted? ? team_path(team) : teams_path, class: "rounded-md px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
    <%= f.submit team.persisted? ? "Enregistrer" : "Créer l'équipe", class: "cursor-pointer rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
  </div>
<% end %>
