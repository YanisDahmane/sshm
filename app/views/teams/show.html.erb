<% content_for :title, "#{@team.name} · Elio" %>
<% select_class = "mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>

<div class="mx-auto max-w-3xl">
  <%= link_to "← Équipes", teams_path, class: "text-sm text-slate-500 hover:text-slate-700" %>

  <div class="mt-2 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= @team.name %></h1>
      <% if @team.description %>
        <p class="team-description mt-1 text-sm text-slate-600"><%= @team.description %></p>
      <% end %>
    </div>
    <% if can?(:operate) %>
      <div class="flex shrink-0 items-center gap-2">
        <%= link_to edit_team_path(@team),
              class: "inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do %>
          <%= icon :pencil_square %> Modifier
        <% end %>
        <%= button_to team_path(@team), method: :delete,
              form: { data: { turbo_confirm: "L'équipe « #{@team.name} » sera supprimée. Ses profils et leurs accès aux serveurs ne seront pas touchés.",
                              confirm_label: "Supprimer l'équipe", confirm_variant: "danger" } },
              class: "inline-flex cursor-pointer items-center gap-2 rounded-md border border-red-300 bg-white px-3 py-2 text-sm font-medium text-red-700 shadow-sm hover:bg-red-50" do %>
          <%= icon :trash %> Supprimer
        <% end %>
      </div>
    <% end %>
  </div>

  <section id="team-members" class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Membres</h2>
    <% if @team.profiles.any? %>
      <ul class="mt-3 divide-y divide-slate-100 rounded-md border border-slate-200">
        <% @team.profiles.each do |profile| %>
          <li class="team-member flex items-center gap-3 px-4 py-2 text-sm">
            <%= icon :key, class: "h-4 w-4 shrink-0 text-slate-400" %>
            <%= link_to profile.name, profile_path(profile), class: "font-medium hover:text-indigo-600 hover:underline" %>
            <span class="truncate font-mono text-xs text-slate-500"><%= profile.fingerprint %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">
        Aucun profil dans cette équipe.
        <% if can?(:operate) %><%= link_to "Ajouter des profils", edit_team_path(@team), class: "font-medium text-indigo-600 hover:text-indigo-500" %><% end %>
      </p>
    <% end %>
  </section>

  <% if can?(:operate) && @team.profiles.any? %>
    <section id="team-access" class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold">Autoriser ou retirer l'équipe</h2>
      <p class="mt-1 text-sm text-slate-500">Chaque profil de l'équipe est ajouté ou retiré sur les serveurs cochés. Les profils ajoutés plus tard à l'équipe ne sont pas autorisés automatiquement.</p>

      <% if Server.exists? %>
        <%= form_with url: team_accesses_path(@team), data: { controller: "quiet-submit" }, class: "mt-4 space-y-5" do |f| %>
          <%= render "servers/picker" %>

          <div class="flex flex-wrap items-end gap-4">
            <div>
              <%= label_tag :account, "Compte", class: "block text-sm font-medium text-slate-700" %>
              <%= text_field_tag :account, nil, placeholder: "ex. debian", autocomplete: "off", spellcheck: false, class: "#{select_class} w-56 font-mono" %>
              <p class="mt-1 text-xs text-slate-500">Vide : l'utilisateur SSH de chaque serveur.</p>
            </div>
            <div>
              <%= label_tag :team_duration, "Durée (autorisation)", class: "block text-sm font-medium text-slate-700" %>
              <%= select_tag :duration, options_for_select([ [ "Permanent", "" ], *TemporaryAccess::DURATIONS.map { |value, (label, _)| [ label, value ] } ]),
                    id: "team_duration", class: select_class %>
              <p class="mt-1 text-xs text-transparent select-none">.</p>
            </div>
            <div class="flex gap-2 pb-6">
              <%= f.button type: "submit", class: "group inline-flex cursor-pointer items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-wait disabled:opacity-60" do %>
                <%= icon :arrow_path, class: "hidden h-4 w-4 animate-spin group-disabled:block" %>
                Autoriser l'équipe
              <% end %>
              <%= f.button type: "submit", name: "_method", value: "delete", formaction: team_access_path(@team),
                    data: { turbo_confirm: "Les clés des #{pluralize(@team.profiles.size, "profil", plural: "profils")} de « #{@team.name} » seront retirées des serveurs cochés.",
                            confirm_label: "Retirer l'équipe", confirm_variant: "danger" },
                    class: "group inline-flex cursor-pointer items-center gap-2 rounded-md border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-700 shadow-sm hover:bg-red-50 disabled:cursor-wait disabled:opacity-60" do %>
                <%= icon :arrow_path, class: "hidden h-4 w-4 animate-spin group-disabled:block" %>
                Retirer l'équipe
              <% end %>
            </div>
          </div>
        <% end %>
        <div id="team-bulk-results"></div>
      <% else %>
        <p class="mt-4 text-sm text-slate-500"><%= link_to "Ajoutez un serveur", new_server_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %> pour pouvoir y autoriser l'équipe.</p>
      <% end %>
    </section>
  <% end %>
</div>
