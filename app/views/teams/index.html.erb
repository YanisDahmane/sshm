<% content_for :title, "Équipes · SSHM" %>

<section id="teams-section">
  <%= link_to "← Profils", profiles_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  <div class="mt-2 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Équipes</h1>
      <p class="text-sm text-slate-500"><%= pluralize(@teams.size, "équipe", plural: "équipes") %></p>
    </div>
    <% if can?(:operate) %>
      <%= link_to "Nouvelle équipe", new_team_path,
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% end %>
  </div>

  <% if @teams.any? %>
    <ul id="teams" class="mt-4 divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white shadow-sm">
      <% @teams.each do |team| %>
        <li id="<%= dom_id(team) %>" class="team flex items-center gap-4 px-4 py-3">
          <div class="min-w-0 flex-1">
            <%= link_to team.name, team_path(team), class: "font-medium hover:text-indigo-600 hover:underline" %>
            <p class="truncate text-xs text-slate-500">
              <% if team.profiles.any? %>
                <%= pluralize(team.profiles.size, "profil", plural: "profils") %> : <%= team.profiles.map(&:name).join(", ") %>
              <% else %>
                Aucun profil
              <% end %>
            </p>
          </div>
          <% if can?(:operate) %>
            <%= link_to edit_team_path(team), title: "Modifier", aria: { label: "Modifier l'équipe #{team.name}" },
                  class: "rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-700" do %>
              <%= icon :pencil_square %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <p class="text-sm text-slate-500">Aucune équipe. Une équipe regroupe des profils pour les autoriser ou les retirer d'un coup (ex. « Développeurs », « Astreinte »).</p>
      <% if can?(:operate) %>
        <%= link_to "Créer une équipe", new_team_path, class: "mt-2 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <% end %>
    </div>
  <% end %>
</section>
