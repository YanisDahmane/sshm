<%= turbo_frame_tag dom_id(@server, :ssh_check), class: "group block" do %>
  <%= render "servers/health_item", label: "SSH", refresh_path: server_ssh_check_path(@server), refresh_title: "Retester la connexion SSH" do %>
    <% if @result.success? %>
      <span class="ssh-check-result inline-flex items-center gap-1.5 rounded-full bg-good-soft px-2 py-0.5 text-xs font-medium text-good-ink ring-1 ring-inset ring-good/20"
            title="<%= @result.details %>">
        <%= icon :check, class: "h-3.5 w-3.5" %> Connexion OK
      </span>
      <span class="text-xs text-ink-3">vérifié <%= relative_time_tag Time.current %></span>
    <% else %>
      <span class="ssh-check-result inline-flex items-center gap-1.5 rounded-full bg-crit-soft px-2 py-0.5 text-xs font-medium text-crit-ink ring-1 ring-inset ring-crit/20">
        <%= icon :x_mark, class: "h-3.5 w-3.5" %> <%= @result.message %>
      </span>
    <% end %>
  <% end %>

  <% unless @result.success? %>
    <div class="mt-2 group-aria-busy:opacity-50">
      <p class="ssh-check-details break-all font-mono text-xs text-crit-ink"><%= @result.details %></p>
      <% if @result.reason == :host_key_changed %>
        <%= render "servers/host_key_changed", server: @server, host_key: @result.host_key %>
      <% elsif @result.reason %>
        <%= render "ssh_keys/setup_hint", server: @server, reason: @result.reason %>
      <% end %>
    </div>
  <% end %>
<% end %>
