<%= turbo_frame_tag dom_id(@server, :ssh_check), class: "group block" do %>
  <%= render "servers/health_item", label: "SSH", refresh_path: server_ssh_check_path(@server), refresh_title: "Retester la connexion SSH" do %>
    <% if @result.success? %>
      <span class="ssh-check-result inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20"
            title="<%= @result.details %>">
        <%= icon :check, class: "h-3.5 w-3.5" %> Connexion OK
      </span>
      <span class="text-xs text-slate-500">vérifié <%= relative_time_tag Time.current %></span>
    <% else %>
      <span class="ssh-check-result inline-flex items-center gap-1.5 rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">
        <%= icon :x_mark, class: "h-3.5 w-3.5" %> <%= @result.message %>
      </span>
    <% end %>
  <% end %>

  <% unless @result.success? %>
    <div class="mt-2 group-aria-busy:opacity-50">
      <p class="ssh-check-details break-all font-mono text-xs text-red-700"><%= @result.details %></p>
      <% if @result.reason %>
        <%= render "ssh_keys/setup_hint", server: @server, reason: @result.reason %>
      <% end %>
    </div>
  <% end %>
<% end %>
