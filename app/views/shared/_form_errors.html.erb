<% if record.errors.any? %>
  <div id="error_explanation" class="rounded-md border border-crit/40 bg-crit-soft px-4 py-3 text-sm text-crit-ink">
    <ul class="list-disc space-y-1 pl-5">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
