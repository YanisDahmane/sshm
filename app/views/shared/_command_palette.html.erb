<%# Quick search (⌘K / Ctrl+K) over pages, servers and profiles; see command_palette_controller.js. %>
<dialog id="command-palette" data-command-palette-target="dialog" aria-label="Recherche rapide"
        class="mx-auto mt-24 w-full max-w-lg rounded-xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm">
  <div class="flex items-center gap-3 border-b border-slate-200 px-4">
    <%= icon :magnifying_glass, class: "h-5 w-5 text-slate-400" %>
    <input type="search" data-command-palette-target="input" data-action="input->command-palette#filter keydown->command-palette#navigate"
           placeholder="Rechercher un serveur, un profil, une page…" autocomplete="off" spellcheck="false"
           role="combobox" aria-expanded="true" aria-controls="command-palette-results"
           class="w-full border-0 py-4 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-0">
  </div>
  <ul id="command-palette-results" data-command-palette-target="results" role="listbox" class="max-h-80 overflow-y-auto p-2"></ul>
  <p data-command-palette-target="empty" hidden class="px-4 py-8 text-center text-sm text-slate-500">Aucun résultat.</p>
  <div class="flex gap-4 border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
    <span><kbd class="font-sans">↑↓</kbd> naviguer</span><span><kbd class="font-sans">↵</kbd> ouvrir</span><span><kbd class="font-sans">Échap</kbd> fermer</span>
  </div>
  <script type="application/json" data-command-palette-target="items"><%= raw json_escape(command_palette_items.to_json) %></script>
</dialog>
