<%# Styled replacement for confirm(), driven by app/javascript/confirm_dialog.js. %>
<dialog id="confirm-dialog" aria-labelledby="confirm-dialog-title"
        class="m-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm">
  <form method="dialog" class="p-6">
    <h2 id="confirm-dialog-title" class="text-base font-semibold text-slate-900">Êtes-vous sûr ?</h2>
    <p data-confirm-message class="mt-2 text-sm text-slate-600"></p>
    <div class="mt-6 flex justify-end gap-3">
      <button value="cancel" class="cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Annuler</button>
      <button value="confirm" data-confirm-accept data-variant="primary"
              class="cursor-pointer rounded-md px-4 py-2 text-sm font-semibold text-white shadow-sm
                     data-[variant=primary]:bg-indigo-600 data-[variant=primary]:hover:bg-indigo-500
                     data-[variant=danger]:bg-red-600 data-[variant=danger]:hover:bg-red-500">Confirmer</button>
    </div>
  </form>
</dialog>
