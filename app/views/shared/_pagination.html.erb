<%# Pagination of a Paginator, keeping the other query parameters. Local `noun`: plural of the items ("activities"). %>
<% noun = local_assigns[:noun] || t(".items") %>
<% if pager.multiple_pages? %>
  <% page_url = ->(number) { url_for(request.query_parameters.merge("page" => number)) } %>
  <nav class="pagination mt-4 flex flex-wrap items-center justify-between gap-3 text-sm" aria-label="<%= t(".label") %>">
    <p class="pagination-info text-xs text-ink-3 tabular-nums"><%= t(".info", from: pager.from, to: pager.to, total: pager.total, items: noun) %></p>
    <div class="flex items-center gap-1">
      <% if pager.previous_page %>
        <%= link_to page_url.(pager.previous_page), rel: "prev", class: "btn btn-ghost px-2.5 py-1", aria: { label: t(".previous_label") } do %>
          <%= icon :chevron_left, class: "h-4 w-4" %><span class="hidden sm:inline"><%= t(".previous") %></span>
        <% end %>
      <% end %>
      <% pager.series.each do |number| %>
        <% if number == :gap %>
          <span class="px-1.5 text-ink-3" aria-hidden="true">…</span>
        <% elsif number == pager.page %>
          <span class="page-current grid h-8 min-w-8 place-items-center rounded-md bg-accent-fill px-2 font-medium text-white tabular-nums" aria-current="page"><%= number %></span>
        <% else %>
          <%= link_to number, page_url.(number), class: "grid h-8 min-w-8 place-items-center rounded-md px-2 text-ink-2 tabular-nums hover:bg-subtle hover:text-ink",
                aria: { label: t(".page", number: number) } %>
        <% end %>
      <% end %>
      <% if pager.next_page %>
        <%= link_to page_url.(pager.next_page), rel: "next", class: "btn btn-ghost px-2.5 py-1", aria: { label: t(".next_label") } do %>
          <span class="hidden sm:inline"><%= t(".next") %></span><%= icon :chevron_right, class: "h-4 w-4" %>
        <% end %>
      <% end %>
    </div>
  </nav>
<% end %>
