<div>
  <%= f.label attribute, label, class: "label" %>
  <%= f.public_send(type, attribute, required: true, autocomplete: local_assigns[:autocomplete], autofocus: local_assigns[:autofocus],
        readonly: local_assigns[:readonly],
        class: "input mt-1 read-only:bg-subtle read-only:text-ink-3") %>
  <% if local_assigns[:hint] %><p class="mt-1 text-xs text-ink-3"><%= hint %></p><% end %>
</div>
