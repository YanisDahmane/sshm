<div>
  <%= f.label attribute, label, class: "block text-sm font-medium text-ink-2" %>
  <%= f.public_send(type, attribute, required: true, autocomplete: local_assigns[:autocomplete], autofocus: local_assigns[:autofocus],
        readonly: local_assigns[:readonly],
        class: "mt-1 block w-full rounded-md border border-line px-3 py-2 text-sm shadow-sm read-only:bg-subtle read-only:text-ink-3 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent") %>
  <% if local_assigns[:hint] %><p class="mt-1 text-xs text-ink-3"><%= hint %></p><% end %>
</div>
