<button type="button" data-action="command-palette#open" aria-label="<%= t(".label") %>"
        class="command-palette-button mt-5 flex w-full cursor-pointer items-center gap-2 rounded-lg border border-line bg-canvas px-2.5 py-1.5 text-sm text-ink-3 hover:text-ink-2">
  <%= icon :magnifying_glass %>
  <span><%= t(".text") %></span>
  <kbd class="kbd ml-auto">⌘K</kbd>
</button>
