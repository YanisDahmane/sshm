<% content_for :title, t("title", page: t("nav.scheduled_tasks")) %>

<div>
  <h1 class="text-xl font-semibold"><%= t("nav.scheduled_tasks") %></h1>
  <p class="text-xs text-ink-3"><%= t(".cron_jobs_systemd_timers") %></p>
</div>

<%= form_with url: scheduled_tasks_path, method: :get, data: { controller: "auto-submit", turbo_action: "advance" }, class: "scheduled-tasks-filters mt-5 flex flex-wrap items-center gap-2" do |f| %>
  <%= f.search_field :q, value: @q, placeholder: t(".command_timer_file_e"), aria: { label: t(".search") },
        data: { action: "input->auto-submit#submitLater" }, class: "input w-72 py-1 text-xs" %>
  <%= f.select :group, [ [ t(".all_groups"), "" ], *@groups.map { |group| [ group.name, group.id ] } ], { selected: @group&.id },
        aria: { label: t(".group") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
  <%= f.select :state, [ [ t(".all_states"), "" ], [ t(".failed"), "failed" ], [ t(".late"), "late" ] ], { selected: @state },
        aria: { label: t(".state") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
  <noscript><%= f.submit t(".filter"), class: "btn btn-secondary" %></noscript>
<% end %>

<% if @rows.any? %>
  <div class="card mt-3 overflow-x-auto">
    <table id="scheduled-tasks" class="table-dense">
      <thead><tr><th class="pl-4"><%= t(".server") %></th><th>Type</th><th>Quand</th><th><%= t(".task") %></th><th>Utilisateur</th><th class="pr-4"><%= t(".state") %></th></tr></thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr class="scheduled-task" data-kind="<%= row.kind %>">
            <td class="pl-4"><%= link_to row.server.name, server_path(row.server, tab: "schedules"), class: "font-medium hover:text-accent hover:underline" %></td>
            <td class="text-xs text-ink-2"><%= { "timer" => "timer", "cron" => "cron", "periodic" => "script" }.fetch(row.kind) %></td>
            <td class="text-xs whitespace-nowrap">
              <% if row.kind == "timer" %><%= timer_schedule_text(row.timer) %>
              <% elsif row.kind == "cron" %><span title="<%= row.schedule %>"><%= Inventory::CronSchedule.cron(row.schedule).text %></span>
              <% else %><%= period_label(row.schedule) %>
              <% end %>
            </td>
            <td class="max-w-md text-xs">
              <% if row.kind == "cron" %>
                <span class="block truncate font-mono" title="<%= row.command %>"><%= row.command %></span>
              <% else %>
                <span class="font-mono"><%= row.name.delete_suffix(".timer") %></span>
                <% if row.command %><span class="text-ink-3"> — <%= row.command %></span><% end %>
              <% end %>
              <span class="block text-[11px] text-ink-3"><%= row.source %></span>
            </td>
            <td class="font-mono text-xs"><%= row.user || "—" %></td>
            <td class="pr-4 text-xs">
              <% if row.timer %><%= timer_state_badge(row.timer) %><% if row.timer["last_at"] %> <span class="text-ink-3">· <%= timer_time(row.timer["last_at"]) %></span><% end %>
              <% else %><span class="text-ink-3" title="<%= t(".cron_keeps_record_runs") %>">—</span><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", pager: @pager, noun: t(".tasks") %>
<% else %>
  <p class="card mt-3 px-4 py-6 text-sm text-ink-3"><%= @q.present? || @state ? t(".scheduled_task_matches") : t(".known_scheduled_task") %></p>
<% end %>

<% if @without_inventory.any? %>
  <p class="mt-3 text-xs text-ink-3"><%= t(".without_scheduled_tasks_inventory") %> <%= safe_join(@without_inventory.map { |server| link_to(server.name, server_path(server), class: "hover:underline") }, ", ") %>.</p>
<% end %>
