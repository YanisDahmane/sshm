<%# Header of the "Accès" section: desired state (rules), drift and access requests. %>
<% pending_count = AccessRequest.pending.count if can?(:operate) %>
<div>
  <h1 class="text-2xl font-bold tracking-tight">Accès</h1>
  <p class="mt-1 text-sm text-slate-500">Décrivez qui doit avoir accès à quoi, comparez avec les clés réellement présentes, et traitez les demandes d'accès.</p>
</div>
<nav class="access-tabs mt-4 flex gap-2 border-b border-slate-200" aria-label="Accès">
  <% tab = "-mb-px inline-flex items-center gap-2 border-b-2 px-3 py-2 text-sm font-medium" %>
  <% [ [ :rules, "Règles", access_rules_path, nil ], [ :drift, "Écarts", drift_path, local_assigns[:report]&.drifts&.size ],
       [ :requests, "Demandes", access_requests_path, pending_count ] ].each do |key, label, path, count| %>
    <%= link_to path, aria: { current: (current == key ? "page" : nil) },
          class: "#{tab} #{current == key ? "border-indigo-600 text-indigo-700" : "border-transparent text-slate-600 hover:text-slate-900"}" do %>
      <%= label %>
      <% if count.to_i.positive? %>
        <span class="<%= key == :drift ? "drift-count" : "pending-count" %> rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800"><%= count %></span>
      <% end %>
    <% end %>
  <% end %>
</nav>
