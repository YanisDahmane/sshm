<% content_for :title, t("title", page: t("nav.vulnerabilities")) %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-xl font-semibold"><%= t("nav.vulnerabilities") %></h1>
    <p class="text-xs text-ink-3"><%= t(".cves_packages_fleet_docker") %></p>
  </div>
  <p class="vulnerability-feeds-state text-xs text-ink-3">
    <% if @feeds.any? %>
      <%= safe_join(@feeds.map { |feed| safe_join([ feed.label, " : ", relative_time_tag(feed.refreshed_at) ]) }, " · ") %>
    <% else %>
      <%= t(".feeds_not_downloaded_yet") %><% if can?(:administer) %> — <%= link_to t(".settings_vulnerabilities"), settings_vulnerabilities_path, class: "text-accent hover:underline" %><% end %>.
    <% end %>
  </p>
</div>

<div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <%= stat_tile t(".vulnerabilities"), @summary[:cves], t(".distinct_cves"), icon: :shield_exclamation, id: "stat-cves" %>
  <%= stat_tile t(".fixable"), @summary[:fixable], t(".update_exists"), tone: (:warn if @summary[:fixable].positive?), id: "stat-fixable" %>
  <%= stat_tile t(".serious_fixable"), @summary[:serious], t(".high_critical"), tone: (:crit if @summary[:serious].positive?), id: "stat-serious" %>
  <%= stat_tile t(".servers_affected"), @summary[:servers], nil, icon: :server_stack, id: "stat-affected" %>
</div>

<div class="mt-5 flex flex-wrap items-center gap-3">
<div class="vulnerability-view-toggle flex rounded-lg border border-line bg-surface p-0.5 text-xs" role="group" aria-label="<%= t(".group_2") %>">
  <% [ [ "packages", t(".package"), :cube ], [ "cves", t(".cve"), :list_bullet ] ].each do |view, label, icon_name| %>
    <%= link_to vulnerabilities_path(request.query_parameters.except("page").merge("view" => view)), data: { view: view }, aria: { pressed: @view == view },
          class: "inline-flex items-center gap-1 rounded-md px-2 py-1 #{@view == view ? "bg-subtle font-medium text-ink" : "text-ink-3 hover:text-ink"}" do %>
      <%= icon icon_name, class: "h-4 w-4" %><%= label %>
    <% end %>
  <% end %>
</div>
<%= form_with url: vulnerabilities_path, method: :get, data: { controller: "auto-submit", turbo_action: "advance" }, class: "vulnerability-filters flex flex-wrap items-center gap-2" do |f| %>
  <%= hidden_field_tag :view, @view %>
  <%= f.search_field :q, value: @q, placeholder: t(".cve_package_e_g"), aria: { label: t(".search") },
        data: { action: "input->auto-submit#submitLater" }, class: "input w-60 py-1 text-xs" %>
  <%= f.select :severity, [ [ t(".all_severities"), "" ], *Vulnerability::SEVERITIES.keys.excluding("unknown").map { |key| [ key == "critical" ? Vulnerability.severity_label(key) : t("vulnerability.at_least", severity: Vulnerability.severity_label(key)), key ] } ],
        { selected: @severity }, aria: { label: t(".minimum_severity") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
  <%= f.select :group, [ [ t(".all_groups"), "" ], *@groups.map { |group| [ group.name, group.id ] } ], { selected: @group&.id },
        aria: { label: t(".group") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
  <%= f.select :origin, [ [ t(".systems_images"), "" ], *ServerVulnerability::ORIGINS.keys.map { |key| [ ServerVulnerability.origin_label(key), key ] } ], { selected: @origin },
        aria: { label: t(".origin") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
  <label class="flex items-center gap-1.5 text-xs"><%= t(".fixable_only_html", submit: (check_box_tag :fixable, "1", @fixable_only, data: { action: "change->auto-submit#submit" })) %></label>
  <noscript><%= f.submit t(".filter"), class: "btn btn-secondary" %></noscript>
<% end %>
</div>

<% if @view == "packages" %>
  <div class="card mt-3"><%= render "servers/vulnerability_packages", server: nil, groups: @package_groups, pager: @pager %></div>
<% elsif @rows.any? %>
  <div class="card mt-3 overflow-x-auto" data-controller="modal">
    <table id="vulnerabilities" class="table-dense">
      <thead><tr><th class="pl-4"><%= t(".severity") %></th><th><%= t("words.score") %></th><th>CVE</th><th><%= t(".packages") %></th><th><%= t(".servers") %></th><th class="pr-4"><%= t("words.fix") %></th></tr></thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr class="fleet-vulnerability hover:bg-subtle" data-cve="<%= row.cve %>">
            <td class="pl-4"><%= severity_badge(row.severity) %></td>
            <td><%= cve_score(@ratings[row.cve]) %></td>
            <td class="font-mono text-xs whitespace-nowrap"><%= link_to row.cve, vulnerability_path(row.cve), class: "vulnerability-link hover:text-accent hover:underline",
                                                                        data: { turbo_frame: "vulnerability-detail", action: "modal#open" } %></td>
            <td class="font-mono text-xs"><%= row.packages.join(", ") %>
              <% if row.images.any? %><span class="block text-[11px] text-ink-3"><%= t(".images_html", images_first: (row.images.first(3).join(", ")), count: (" …" if row.images.size > 3)) %></span><% end %></td>
            <td class="text-xs">
              <span class="font-medium"><%= row.servers.size %></span> ·
              <%= safe_join(row.servers.first(3).map { |server| link_to(server.name, server_path(server, tab: "vulnerabilities"), class: "hover:text-accent hover:underline") }, ", ") %><%= " …" if row.servers.size > 3 %>
            </td>
            <td class="pr-4 text-xs"><%= row.fixable ? status_badge(:good, "corrigeable") : tag.span(t(".fix"), class: "text-ink-3") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "vulnerabilities/detail_dialog" %>
  </div>
  <%= render "shared/pagination", pager: @pager, noun: t(".vulnerabilities_2") %>
<% else %>
  <p class="card mt-3 px-4 py-6 text-sm text-ink-3"><%= @q.present? || @severity || @fixable_only || @origin || @group ? t(".vulnerability_matches") : t(".known_vulnerability_fleet") %></p>
<% end %>
