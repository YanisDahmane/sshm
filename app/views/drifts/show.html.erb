<% content_for :title, "Écarts · SSHM" %>

<%= render "access_rules/tabs", current: :drift, report: @report %>

<% if @report.entries.empty? %>
  <div class="mt-6 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
    <p class="text-sm text-slate-500">Aucune règle d'accès : il n'y a rien à comparer.</p>
    <%= link_to "Ajouter une règle", access_rules_path, class: "mt-2 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
  </div>
<% else %>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
    <p class="drift-summary text-sm text-slate-600">
      <% if @report.clean? %>
        <span class="font-medium text-emerald-700">Aucun écart</span> sur les comptes lus.
      <% else %>
        <strong><%= pluralize(@report.drifts.size, "compte", plural: "comptes") %> en écart</strong> :
        <%= pluralize(@report.missing_count, "clé manquante", plural: "clés manquantes") %>,
        <%= pluralize(@report.extra_count, "clé en trop", plural: "clés en trop") %>.
      <% end %>
      D'après la dernière lecture des clés de chaque compte.
    </p>
    <div class="flex flex-wrap gap-2">
      <% if can?(:operate) %>
        <%= button_to server_scans_path, class: "inline-flex cursor-pointer items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do %>
          <%= icon :key, class: "h-4 w-4" %> Scanner les clés
        <% end %>
        <% if @report.missing_count.positive? %>
          <%= button_to drift_fix_path, form: { data: { controller: "quiet-submit" } },
                class: "group add-all-missing inline-flex cursor-pointer items-center gap-2 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-wait disabled:opacity-60" do %>
            <%= icon :arrow_path, class: "hidden h-4 w-4 animate-spin group-disabled:block" %>
            Ajouter toutes les clés manquantes
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <ul id="drift-entries" class="mt-4 space-y-3">
    <% @report.entries.each do |entry| %>
      <li id="drift-<%= dom_id(entry.server) %>-<%= entry.unix_user %>"
          class="drift-entry rounded-xl border bg-white p-4 shadow-sm <%= entry.drift? ? "is-drift border-amber-300" : (entry.scanned? ? "is-clean border-slate-200" : "is-unscanned border-slate-200") %>">
        <div class="flex flex-wrap items-center gap-2">
          <%= link_to entry.server.name, server_path(entry.server, anchor: "server-authorized-keys"), class: "font-semibold hover:text-indigo-600 hover:underline" %>
          <span class="font-mono text-sm text-slate-600"><%= entry.unix_user %></span>
          <% if !entry.scanned? %>
            <span class="drift-state rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Jamais lu</span>
          <% elsif entry.drift? %>
            <span class="drift-state rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-600/20">Écart</span>
          <% else %>
            <span class="drift-state rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Conforme</span>
          <% end %>
          <span class="ml-auto text-xs text-slate-400">
            <%= entry.scanned? ? "lu #{relative_time_in_words(entry.snapshot.read_at)}" : "lancez un scan pour comparer" %>
          </span>
        </div>

        <% if entry.missing.any? %>
          <div class="drift-missing mt-3">
            <div class="flex items-center justify-between gap-2">
              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Clés manquantes</p>
              <% if can?(:operate) %>
                <%= button_to "Ajouter les clés manquantes", drift_fix_path, params: { server_id: entry.server.id, account: entry.unix_user },
                      form: { data: { controller: "quiet-submit" } },
                      class: "cursor-pointer rounded-md border border-indigo-200 bg-white px-2.5 py-1 text-xs font-medium text-indigo-700 shadow-sm hover:bg-indigo-50 disabled:cursor-wait disabled:opacity-60" %>
              <% end %>
            </div>
            <ul class="mt-1 flex flex-wrap gap-1.5">
              <% entry.missing.each do |profile| %>
                <li><%= link_to profile.name, profile_path(profile), class: "inline-flex rounded-full bg-sky-50 px-2 py-0.5 text-xs font-medium text-sky-700 ring-1 ring-inset ring-sky-600/20 hover:bg-sky-100" %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if entry.extra.any? %>
          <div class="drift-extra mt-3">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Clés en trop</p>
            <ul class="mt-1 divide-y divide-slate-100 rounded-md border border-slate-200">
              <% entry.extra.each do |key| %>
                <% profile = entry.profile_for(key) %>
                <li class="drift-extra-key flex items-center gap-3 px-3 py-2 text-sm">
                  <%= icon :key, class: "h-4 w-4 shrink-0 text-slate-400" %>
                  <span class="min-w-0 flex-1 truncate">
                    <span class="<%= key.named? ? "font-medium" : "italic text-slate-500" %>"><%= key.named? ? key.name : "Sans nom" %></span>
                    <% if profile %><span class="text-xs text-slate-500">· profil <%= profile.name %></span><% end %>
                    <span class="ml-1 font-mono text-xs text-slate-400"><%= key.fingerprint %></span>
                  </span>
                  <% if can?(:operate) %>
                    <%= button_to drift_fix_path, method: :delete,
                          params: { server_id: entry.server.id, account: entry.unix_user, key: key.key, name: key.name },
                          title: "Retirer cette clé", aria: { label: "Retirer la clé #{key.name || "sans nom"} de #{entry.server.name}" },
                          form: { data: { turbo_confirm: "La clé « #{key.name || "sans nom"} » sera retirée de « #{entry.server.name} » pour #{entry.unix_user}.",
                                          confirm_label: "Retirer la clé", confirm_variant: "danger" } },
                          class: "cursor-pointer rounded-md p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600" do %>
                      <%= icon :trash %>
                    <% end %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
