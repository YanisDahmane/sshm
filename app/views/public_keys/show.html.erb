<% content_for :title, "#{@public_key.name} · Elio" %>
<% key = @public_key.authorized_key %>

<div class="mx-auto max-w-3xl">
  <%= link_to t("words.back_keyring"), public_keys_path, class: "text-sm text-ink-3 hover:text-ink-2" %>

  <div class="mt-2 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= @public_key.name %></h1>
      <p class="mt-1 text-sm text-ink-3">
        <span class="key-kind font-medium text-ink-2"><%= @public_key.kind_label %></span>
        <%= t(".added_keyring_html", created_at: (relative_time_tag @public_key.created_at)) %>
      </p>
      <% if @public_key.description %>
        <p class="key-description mt-1 text-sm text-ink-2"><%= @public_key.description %></p>
      <% end %>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <% if can?(:operate) %>
        <%= link_to edit_public_key_path(@public_key),
              class: "btn btn-secondary" do %>
          <%= icon :pencil_square %> <%= t(".edit") %>
        <% end %>
        <%= render "delete_button", public_key: @public_key, label: t(".delete"),
              class: "inline-flex cursor-pointer items-center gap-2 rounded-md border border-crit/40 bg-surface px-3 py-2 text-sm font-medium text-crit-ink shadow-sm hover:bg-crit-soft" %>
      <% end %>
    </div>
  </div>

  <section id="keyring-key" class="mt-8 rounded-xl border border-line bg-surface p-6 shadow-sm">
    <h2 class="text-lg font-semibold"><%= t(".ssh_key") %></h2>

    <dl class="mt-4 grid grid-cols-1 gap-4 text-sm sm:grid-cols-3">
      <div>
        <dt class="font-medium text-ink-2">Type</dt>
        <dd class="mt-1 font-mono text-ink-2"><%= key.type %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="font-medium text-ink-2"><%= t("words.fingerprint") %></dt>
        <dd id="keyring-fingerprint" class="mt-1 break-all font-mono text-ink-2"><%= @public_key.fingerprint %></dd>
      </div>
      <div class="sm:col-span-3">
        <dt class="font-medium text-ink-2"><%= t("words.comment") %></dt>
        <dd class="mt-1 text-ink-2"><%= key.comment || tag.span(t(".none"), class: "italic text-ink-3") %></dd>
      </div>
    </dl>

    <div class="mt-6" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="keyring-content" class="text-sm font-medium text-ink-2"><%= t(".public_key") %></label>
        <%= render "settings/copy_button" %>
      </div>
      <textarea id="keyring-content" readonly rows="3" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-line bg-subtle px-3 py-2 font-mono text-xs text-ink-2"><%= @public_key.content %></textarea>
    </div>
  </section>

  <%= render "public_keys/accesses", public_key: @public_key %>
  <% if can?(:operate) %>
    <%= render "public_keys/bulk_form", public_key: @public_key %>
  <% end %>
</div>
