<%# Where the keyring key is installed, from the last key reads (see Keys::PublicKeyAccessOverview). %>
<% accesses = Keys::PublicKeyAccessOverview.new(public_key).accesses %>
<section id="key-accesses" class="mt-6 rounded-xl border border-line bg-surface p-6 shadow-sm">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold">Accès</h2>
      <p class="mt-1 text-sm text-ink-3">Serveurs où cette clé est installée, d'après la dernière lecture des clés.</p>
    </div>
    <% if can?(:operate) %>
      <%= button_to server_scans_path, class: "btn btn-secondary shrink-0 whitespace-nowrap" do %>
        <%= icon :key, class: "h-4 w-4" %> Scanner les clés
      <% end %>
    <% end %>
  </div>

  <% if accesses.any? %>
    <ul class="mt-4 divide-y divide-line rounded-md border border-line">
      <% accesses.each do |access| %>
        <li class="key-access flex items-center justify-between gap-3 px-4 py-3 text-sm">
          <div class="min-w-0">
            <p class="truncate">
              <%= link_to access.server.name, server_path(access.server), class: "font-medium hover:text-accent hover:underline" %>
              · <span class="font-mono"><%= access.unix_user %></span>
            </p>
            <p class="text-xs text-ink-3">Vu <%= relative_time_tag access.read_at %></p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <% if access.temporary_access %>
              <%= relative_time_tag access.temporary_access.expires_at, prefix: "Expire ", expired: "Expiré, suppression en cours",
                    class: "rounded-full bg-warn-soft px-2 py-0.5 text-xs font-medium text-warn-ink ring-1 ring-inset ring-warn/20" %>
            <% else %>
              <span class="rounded-full bg-subtle px-2 py-0.5 text-xs font-medium text-ink-2">Permanent</span>
            <% end %>
            <% if can?(:operate) %>
              <%= button_to public_key_access_path(public_key), method: :delete, params: { server_id: access.server.id },
                    title: "Retirer l'accès", aria: { label: "Retirer l'accès à #{access.server.name}" },
                    form: { data: { controller: "quiet-submit",
                                    turbo_confirm: "La clé de « #{public_key.name} » sera supprimée de « #{access.server.name} ».",
                                    confirm_label: "Retirer l'accès", confirm_variant: "danger" } },
                    class: "cursor-pointer rounded-md p-1.5 text-ink-3 hover:bg-crit-soft hover:text-crit-ink disabled:cursor-wait disabled:opacity-50" do %>
                <%= icon :trash %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 rounded-md border border-dashed border-line px-4 py-6 text-center text-sm text-ink-3">
      Aucun accès connu. Ajoutez-la ci-dessous, ou lancez un scan si des clés ont été ajoutées à la main.
    </p>
  <% end %>
</section>
