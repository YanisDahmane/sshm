<% content_for :title, "Trousseau · Elio" %>

<section id="keyring-section">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Trousseau</h1>
      <p class="text-sm text-ink-3">
        <%= pluralize_fr(@pager.total, "clé", "clés") %>
      </p>
    </div>
    <% if can?(:operate) %>
      <%= link_to "Ajouter une clé", new_public_key_path,
            class: "btn btn-primary" %>
    <% end %>
  </div>

  <nav class="key-kind-filter mt-4 flex flex-wrap gap-2" aria-label="Type de clé">
    <% [ [ "Toutes", nil ], [ "Personnes", "person" ], [ "Serveurs", "server" ] ].each do |label, value| %>
      <%= filter_pill label, public_keys_path(kind: value), active: @kind == value %>
    <% end %>
  </nav>

  <% if @public_keys.any? %>
    <div class="mt-4 overflow-x-auto rounded-xl border border-line bg-surface shadow-sm">
      <table id="keyring" class="min-w-full divide-y divide-line text-sm">
        <thead class="bg-subtle text-left text-xs font-medium uppercase tracking-wide text-ink-3">
          <tr>
            <th scope="col" class="px-4 py-3">Nom</th>
            <th scope="col" class="px-4 py-3">Type</th>
            <th scope="col" class="px-4 py-3">Algorithme</th>
            <th scope="col" class="px-4 py-3">Empreinte</th>
            <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @public_keys.each do |public_key| %>
            <tr id="<%= dom_id(public_key) %>" class="hover:bg-subtle">
              <td class="px-4 py-3">
                <%= link_to public_key.name, public_key_path(public_key), class: "font-medium hover:text-accent hover:underline" %>
                <% if public_key.description %>
                  <p class="key-description text-xs text-ink-3"><%= public_key.description %></p>
                <% end %>
              </td>
              <td class="key-kind px-4 py-3 text-ink-2"><%= public_key.kind_label %></td>
              <td class="px-4 py-3 font-mono text-ink-2"><%= public_key.authorized_key&.type %></td>
              <td class="px-4 py-3 font-mono text-xs text-ink-3"><%= public_key.fingerprint %></td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-1">
                  <% if can?(:operate) %>
                    <%= link_to edit_public_key_path(public_key),
                          title: "Modifier", aria: { label: "Modifier #{public_key.name}" },
                          class: "rounded-md p-1.5 text-ink-3 hover:bg-subtle hover:text-ink-2" do %>
                      <%= icon :pencil_square %>
                    <% end %>
                  <% end %>
                  <% if can?(:operate) %>
                    <%= render "public_keys/delete_button", public_key: public_key %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: "clés" %>
  <% else %>
    <div class="mt-4 rounded-xl border border-dashed border-line bg-surface px-6 py-12 text-center">
      <p class="text-sm text-ink-3">Le trousseau est vide.</p>
      <% if can?(:operate) %>
        <%= link_to "Ajouter la première clé", new_public_key_path, class: "mt-2 inline-block text-sm font-medium text-accent hover:text-accent" %>
      <% end %>
    </div>
  <% end %>
</section>
