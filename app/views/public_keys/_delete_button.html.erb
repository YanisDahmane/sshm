<%= button_to public_key_path(public_key), method: :delete,
      title: t(".delete"), aria: { label: t(".delete_2", public_key_name: public_key.name) },
      form: { data: { turbo_confirm: t(".key_will_removed_keyring", public_key_name: public_key.name),
                      confirm_label: t(".delete"), confirm_variant: "danger" } },
      class: local_assigns.fetch(:class, "cursor-pointer rounded-md p-1.5 text-ink-3 hover:bg-crit-soft hover:text-crit-ink") do %>
  <%= icon :trash %>
  <%= local_assigns[:label] %>
<% end %>
