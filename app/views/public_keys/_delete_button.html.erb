<%= button_to public_key_path(public_key), method: :delete,
      title: "Supprimer", aria: { label: "Supprimer #{public_key.name}" },
      form: { data: { turbo_confirm: "La clé « #{public_key.name} » sera retirée du trousseau. Là où elle est déjà installée, elle reste en place.",
                      confirm_label: "Supprimer", confirm_variant: "danger" } },
      class: local_assigns.fetch(:class, "cursor-pointer rounded-md p-1.5 text-slate-500 hover:bg-red-50 hover:text-red-600") do %>
  <%= icon :trash %>
  <%= local_assigns[:label] %>
<% end %>
