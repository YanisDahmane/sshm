<!DOCTYPE html>
<html lang="fr" class="h-full">
  <head>
    <title><%= content_for(:title) || "Elio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/theme_script" %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col items-center justify-center bg-canvas px-4 py-12 font-sans text-sm text-ink antialiased">
    <%= render "shared/flash_container" %>
    <div class="w-full max-w-sm">
      <h1 class="mb-8 text-center text-3xl font-bold tracking-tight">Elio</h1>
      <div class="rounded-xl border border-line bg-surface p-8 shadow-sm">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
