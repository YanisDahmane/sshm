<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <title><%= content_for(:title) || "Elio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/theme_script" %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-canvas font-sans text-sm text-ink antialiased"
        <%= tag.attributes(user_signed_in? ? { data: { controller: "command-palette sidebar", action: "keydown->sidebar#closeOnEscape turbo:visit@document->sidebar#close" } } : {}) %>>
    <%= render "shared/flash_container" %>
    <%= render "shared/confirm_dialog" %>
    <% if user_signed_in? %>
      <%= render "shared/command_palette" %>
      <%= render "layouts/sidebar" %>
      <header class="sticky top-0 z-20 flex items-center gap-3 border-b border-line bg-surface px-4 py-2.5 lg:hidden">
        <button type="button" data-action="sidebar#open" aria-label="Ouvrir le menu" class="btn btn-ghost btn-icon"><%= icon :bars_3, class: "h-5 w-5" %></button>
        <%= link_to "Elio", root_path, class: "font-semibold tracking-tight" %>
      </header>
    <% end %>

    <main class="<%= "lg:pl-60" if user_signed_in? %>">
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-8">
        <%= yield %>
      </div>
    </main>
    <%= js_translations_tag %>
  </body>
</html>
