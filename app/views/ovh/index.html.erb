<% content_for :title, "OVHcloud · Elio" %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold">OVHcloud</h1>
    <p class="text-xs text-ink-3">
      Ressources du compte OVHcloud, rattachées aux serveurs du parc<% if @integration.last_synced_at %>, synchronisées <%= relative_time_tag @integration.last_synced_at %><% end %>.
      <% if @integration.last_error %><span class="text-crit-ink">Dernière synchronisation impossible : <%= @integration.last_error %></span><% end %>
    </p>
  </div>
  <% if can?(:administer) %>
    <%= link_to edit_settings_integration_path(@integration.kind), class: "btn btn-secondary" do %><%= icon :cog, class: "h-4 w-4" %>Extension<% end %>
  <% end %>
</div>

<div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <%= stat_tile "Services", @counts.slice(*OvhResource::SERVICE_KINDS).values.sum, "dédiés, VPS, instances", icon: :server_stack, id: "stat-ovh-services" %>
  <%= stat_tile "Non rattachés", @unattached_services, "services hors du parc", tone: (@unattached_services.positive? ? :warn : nil), icon: :exclamation_triangle, id: "stat-ovh-unattached" %>
  <%= stat_tile "Expirent bientôt", @expiring, nil, tone: (@expiring.positive? ? :warn : nil), icon: :clock, id: "stat-ovh-expiring" %>
  <%= stat_tile "DNS hors du parc", @outside_records, "enregistrements A / AAAA", tone: (@outside_records.positive? ? :warn : nil), icon: :list_bullet, id: "stat-ovh-dns-outside" %>
</div>

<nav class="ovh-tabs mt-6 flex gap-5 border-b border-line text-sm" aria-label="Ressources">
  <% [ [ "services", "Services", @counts.slice(*OvhResource::SERVICE_KINDS).values.sum ], [ "ips", "Adresses IP", @counts["ip"].to_i ], [ "dns", "DNS", @counts["dns_record"].to_i ] ].each do |tab, label, count| %>
    <%= link_to ovh_path(tab: tab), aria: { current: (@tab == tab ? "page" : nil) }, data: { tab: tab },
          class: "flex items-center gap-1.5 border-b-2 px-1 pb-2.5 #{@tab == tab ? "border-accent font-medium text-ink" : "border-transparent text-ink-3 hover:text-ink"}" do %>
      <%= label %> <span class="rounded-full bg-subtle px-1.5 text-[11px] text-ink-2"><%= count %></span>
    <% end %>
  <% end %>
</nav>

<%= form_with url: ovh_path, method: :get, data: { controller: "auto-submit", turbo_action: "advance" }, class: "mt-3 flex flex-wrap items-center gap-3" do |f| %>
  <%= hidden_field_tag :tab, @tab %>
  <%= f.search_field :q, value: @q, placeholder: "Nom, IP, cible…", aria: { label: "Rechercher" }, data: { action: "input->auto-submit#submitLater" }, class: "input w-56 py-1 text-xs" %>
  <label class="flex items-center gap-1.5 text-xs text-ink-2">
    <%= check_box_tag :unattached, "1", params[:unattached] == "1", data: { action: "change->auto-submit#submit" }, class: "h-4 w-4 rounded border-line text-accent" %>
    <%= @tab == "dns" ? "Hors du parc seulement" : "Non rattachés seulement" %>
  </label>
<% end %>

<% if @pager.records.any? %>
  <div class="card mt-3 overflow-x-auto">
    <table id="ovh-resources" class="table-dense">
      <thead>
        <tr>
          <% if @tab == "services" %><th class="pl-4">Service</th><th>Type</th><th>Offre</th><th>Datacenter</th><th>Expiration</th>
          <% elsif @tab == "ips" %><th class="pl-4">Bloc IP</th><th>Type</th><th>Service OVH</th><th>Firewall</th>
          <% else %><th class="pl-4">Nom</th><th>Type</th><th>Cible</th>
          <% end %>
          <th>Serveur</th>
          <% if can?(:operate) && @tab != "dns" %><th class="pr-4 text-right">Rattacher à</th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @pager.records.each do |resource| %>
          <tr id="<%= dom_id(resource) %>" class="ovh-resource" data-kind="<%= resource.kind %>">
            <% if @tab == "services" %>
              <td class="pl-4"><span class="font-medium"><%= resource.name %></span><span class="block font-mono text-[11px] text-ink-3"><%= resource.addresses.first(2).join(", ") %></span></td>
              <td class="text-xs"><%= resource.kind_label %></td>
              <td class="text-xs"><%= resource.data["offer"] || "—" %></td>
              <td class="text-xs"><%= resource.data["datacenter"] || resource.data["region"] || "—" %></td>
              <td class="whitespace-nowrap text-xs"><%= ovh_expiration(resource) %></td>
            <% elsif @tab == "ips" %>
              <td class="pl-4 font-mono text-xs"><%= resource.name %></td>
              <td class="text-xs"><%= resource.data["type"] %></td>
              <td class="font-mono text-xs"><%= resource.data["service"] || "—" %></td>
              <td class="text-xs">
                <% firewalls = Array(resource.data["firewall"]).map(&:last) %>
                <%= resource.data.key?("firewall") ? (firewalls.any? { _1["enabled"] } ? "activé" : "désactivé") : "—" %>
              </td>
            <% else %>
              <td class="pl-4 font-mono text-xs"><%= resource.name %></td>
              <td class="text-xs"><%= resource.data["type"] %></td>
              <td class="font-mono text-xs"><%= resource.data["target"] %></td>
            <% end %>
            <td class="ovh-server whitespace-nowrap text-xs">
              <% if resource.server %>
                <%= link_to resource.server.name, server_path(resource.server, tab: "ovh"), class: "hover:text-accent hover:underline" %>
                <span class="block text-[11px] text-ink-3"><%= ovh_match_label(resource) %></span>
              <% else %>
                <span class="<%= resource.kind == "dns_record" && resource.data["type"] != "CNAME" ? "text-warn-ink" : "text-ink-3" %>"><%= resource.kind == "dns_record" ? "hors du parc" : "non rattaché" %></span>
              <% end %>
            </td>
            <% if can?(:operate) && @tab != "dns" %>
              <td class="pr-4 text-right"><%= render "integrations/ovh/link_form", resource: resource %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", pager: @pager, noun: "ressources" %>
<% else %>
  <p class="card mt-3 px-4 py-6 text-sm text-ink-3"><%= @integration.last_synced_at ? "Aucune ressource ne correspond." : "Pas encore synchronisé avec OVHcloud." %></p>
<% end %>
