<% content_for :title, "Paquets · Elio" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold">Paquets</h1>
    <p class="text-xs text-ink-3">Quels serveurs ont un paquet, et en quelle version ? D'après le dernier inventaire de chaque serveur.</p>
  </div>
</div>

<%= form_with url: packages_path, method: :get, data: { turbo_action: "advance" }, class: "packages-search mt-5 flex gap-2" do |f| %>
  <%= f.search_field :q, value: @q, placeholder: "openssl, nginx, postgres…", autofocus: true, autocomplete: "off",
        aria: { label: "Nom du paquet" }, class: "input max-w-md" %>
  <%= f.button class: "btn btn-primary" do %><%= icon :magnifying_glass %> Rechercher<% end %>
<% end %>

<% if @servers_without_inventory.positive? %>
  <p class="mt-2 text-xs text-ink-3"><%= pluralize_fr(@servers_without_inventory, "serveur n'a", "serveurs n'ont") %> pas encore d'inventaire des paquets.</p>
<% end %>

<% if @q.present? %>
  <% if @results.any? %>
    <div class="mt-5 space-y-4">
      <% @results.each do |name, rows| %>
        <section class="package-result card">
          <div class="card-header">
            <h2 class="font-semibold"><%= name %> <span class="text-xs font-normal text-ink-3"><%= rows.first.manager_label %></span></h2>
            <span class="text-xs text-ink-3"><%= pluralize_fr(rows.map(&:server_id).uniq.size, "serveur", "serveurs") %> · <%= pluralize_fr(@versions[name].size, "version", "versions") %></span>
          </div>
          <table class="table-dense">
            <thead><tr><th class="pl-4">Version</th><th>Mise à jour</th><th class="pr-4">Serveurs</th></tr></thead>
            <tbody>
              <% @versions[name].each do |version, packages| %>
                <tr class="package-version">
                  <td class="pl-4 font-mono text-xs"><%= version %></td>
                  <td class="text-xs">
                    <% if (update = packages.find(&:upgradable?)) %>
                      <span class="font-mono text-ink-2">→ <%= update.available_version %></span>
                      <% if packages.any?(&:security) %><span class="badge ml-1 bg-crit-soft text-crit-ink">sécurité</span><% end %>
                    <% else %>
                      <span class="text-ink-3">à jour</span>
                    <% end %>
                  </td>
                  <td class="pr-4">
                    <div class="flex flex-wrap gap-1.5">
                      <% packages.map(&:server).uniq.sort_by(&:name).each do |server| %>
                        <%= link_to server.name, server_path(server, tab: "packages"), class: "badge bg-subtle text-ink-2 hover:text-ink" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="card mt-5 px-4 py-6 text-sm text-ink-3">Aucun paquet ne contient « <%= @q %> ».</p>
  <% end %>
<% else %>
  <section class="security-updates card mt-5">
    <div class="card-header">
      <h2 class="flex items-center gap-2 font-semibold"><%= icon :shield_check, class: "h-4 w-4 text-ink-3" %> Mises à jour de sécurité en attente</h2>
      <span class="text-xs text-ink-3"><%= pluralize_fr(@security.size, "paquet", "paquets") %></span>
    </div>
    <% if @security.any? %>
      <table class="table-dense">
        <thead><tr><th class="pl-4">Paquet</th><th>Version disponible</th><th class="pr-4">Serveurs concernés</th></tr></thead>
        <tbody>
          <% @security.each do |name, packages| %>
            <tr class="security-update">
              <td class="pl-4 font-medium"><%= link_to name, packages_path(q: name), class: "hover:text-accent hover:underline" %></td>
              <td class="font-mono text-xs text-ink-2"><%= packages.map(&:available_version).uniq.join(", ") %></td>
              <td class="pr-4">
                <div class="flex flex-wrap gap-1.5">
                  <% packages.map(&:server).uniq.sort_by(&:name).each do |server| %>
                    <%= link_to server.name, server_path(server, tab: "packages"), class: "badge bg-subtle text-ink-2 hover:text-ink" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="flex items-center gap-2 px-4 py-4 text-sm text-good-ink"><%= icon :check_circle %> Aucune mise à jour de sécurité en attente.</p>
    <% end %>
  </section>
<% end %>
