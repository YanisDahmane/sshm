<% input_class = "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
<% label_class = "block text-sm font-medium text-slate-700" %>
<% servers = Server.order(:name) %>

<%= form_with model: group, url: group.persisted? ? server_group_path(group) : server_groups_path, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", record: group %>

  <div>
    <%= f.label :name, "Nom", class: label_class %>
    <%= f.text_field :name, autofocus: true, required: true, maxlength: 50, placeholder: "Production", class: input_class %>
  </div>

  <fieldset>
    <legend class="<%= label_class %>">Couleur</legend>
    <div class="mt-2 flex flex-wrap gap-2">
      <% ServerGroup::COLORS.each do |value, (label, badge, _)| %>
        <label class="cursor-pointer">
          <%= f.radio_button :color, value, class: "peer sr-only" %>
          <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ring-1 ring-inset peer-checked:ring-2 peer-checked:ring-indigo-600 peer-focus-visible:outline-2 peer-focus-visible:outline-indigo-600 <%= badge %>"><%= label %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div>
    <%= f.label :expected_ports, class: label_class do %>Ports attendus <span class="font-normal text-slate-500">(facultatif)</span><% end %>
    <%= f.text_field :expected_ports, placeholder: "22, 80, 443/tcp, 51820/udp", autocomplete: "off", class: "#{input_class} font-mono" %>
    <p class="mt-1 text-xs text-slate-500">Ports que les serveurs du groupe peuvent exposer publiquement. Tout autre port public est signalé comme inattendu. Vide : pas de vérification.</p>
  </div>

  <fieldset data-controller="check-all">
    <div class="flex items-center justify-between">
      <legend class="<%= label_class %>">Serveurs</legend>
      <% if servers.any? %>
        <button type="button" data-action="check-all#toggle" class="cursor-pointer text-xs font-medium text-indigo-600 hover:text-indigo-500">Tout cocher / décocher</button>
      <% end %>
    </div>
    <%= hidden_field_tag "server_group[server_ids][]", "", id: nil %>
    <% if servers.any? %>
      <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
        <% servers.each do |server| %>
          <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-200 px-3 py-2 text-sm hover:bg-slate-50 has-[:checked]:border-indigo-300 has-[:checked]:bg-indigo-50/50">
            <%= check_box_tag "server_group[server_ids][]", server.id, group.server_ids.include?(server.id), id: "server_group_server_ids_#{server.id}",
                  data: { check_all_target: "checkbox" }, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
            <span class="min-w-0">
              <span class="block truncate font-medium"><%= server.name %></span>
              <span class="block truncate font-mono text-xs text-slate-500"><%= server.username %>@<%= server.host %></span>
            </span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">Aucun serveur pour le moment : vous pourrez en ajouter au groupe plus tard.</p>
    <% end %>
  </fieldset>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to "Annuler", server_groups_path, class: "rounded-md px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
    <%= f.submit group.persisted? ? "Enregistrer" : "Créer le groupe", class: "cursor-pointer rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
  </div>
<% end %>
