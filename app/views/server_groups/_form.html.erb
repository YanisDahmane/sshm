<% input_class = "input mt-1" %>
<% label_class = "label" %>
<% servers = Server.order(:name) %>

<%= form_with model: group, url: group.persisted? ? server_group_path(group) : server_groups_path, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", record: group %>

  <div>
    <%= f.label :name, t(".name"), class: label_class %>
    <%= f.text_field :name, autofocus: true, required: true, maxlength: 50, placeholder: t(".production"), class: input_class %>
  </div>

  <fieldset>
    <legend class="<%= label_class %>">Couleur</legend>
    <div class="mt-2 flex flex-wrap gap-2">
      <% ServerGroup::COLORS.each do |value, (badge, _)| %>
        <% label = ServerGroup.color_label(value) %>
        <label class="cursor-pointer">
          <%= f.radio_button :color, value, class: "peer sr-only" %>
          <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ring-1 ring-inset peer-checked:ring-2 peer-checked:ring-accent peer-focus-visible:outline-2 peer-focus-visible:outline-accent <%= badge %>"><%= label %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div>
    <%= f.label :expected_ports, class: label_class do %><%= t(".expected_ports") %> <span class="font-normal text-ink-3"><%= t(".optional") %></span><% end %>
    <%= f.text_field :expected_ports, placeholder: "22, 80, 443/tcp, 51820/udp", autocomplete: "off", class: "#{input_class} font-mono" %>
    <p class="mt-1 text-xs text-ink-3"><%= t(".ports_servers_group_may") %></p>
  </div>

  <fieldset data-controller="check-all">
    <div class="flex items-center justify-between">
      <legend class="<%= label_class %>"><%= t(".servers") %></legend>
      <% if servers.any? %>
        <button type="button" data-action="check-all#toggle" class="cursor-pointer text-xs font-medium text-accent hover:text-accent"><%= t(".check_uncheck_all") %></button>
      <% end %>
    </div>
    <%= hidden_field_tag "server_group[server_ids][]", "", id: nil %>
    <% if servers.any? %>
      <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
        <% servers.each do |server| %>
          <label class="flex cursor-pointer items-center gap-3 rounded-md border border-line px-3 py-2 text-sm hover:bg-subtle has-[:checked]:border-accent/40 has-[:checked]:bg-accent-soft/50">
            <%= check_box_tag "server_group[server_ids][]", server.id, group.server_ids.include?(server.id), id: "server_group_server_ids_#{server.id}",
                  data: { check_all_target: "checkbox" }, class: "h-4 w-4 rounded border-line text-accent" %>
            <span class="min-w-0">
              <span class="block truncate font-medium"><%= server.name %></span>
              <span class="block truncate font-mono text-xs text-ink-3"><%= server.username %>@<%= server.host %></span>
            </span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-ink-3"><%= t(".server_yet_you_can") %></p>
    <% end %>
  </fieldset>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to t(".cancel"), server_groups_path, class: "btn btn-ghost" %>
    <%= f.submit group.persisted? ? t(".save") : t(".create_group"), class: "btn btn-primary" %>
  </div>
<% end %>
