<% content_for :title, "Groupes de serveurs · Elio" %>

<section id="server-groups-section">
  <%= link_to "← Serveurs", servers_path, class: "text-sm text-ink-3 hover:text-ink-2" %>
  <div class="mt-2 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Groupes de serveurs</h1>
      <p class="text-sm text-ink-3"><%= pluralize(@groups.size, "groupe", plural: "groupes") %></p>
    </div>
    <% if can?(:operate) %>
      <%= link_to "Nouveau groupe", new_server_group_path,
            class: "rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-hover" %>
    <% end %>
  </div>

  <% if @groups.any? %>
    <ul id="server-groups" class="mt-4 divide-y divide-line rounded-xl border border-line bg-surface shadow-sm">
      <% @groups.each do |group| %>
        <li id="<%= dom_id(group) %>" class="server-group flex items-center gap-4 px-4 py-3">
          <span class="h-3 w-3 shrink-0 rounded-full <%= group.dot_classes %>"></span>
          <div class="min-w-0 flex-1">
            <%= link_to group.name, servers_path(group: group.id), class: "font-medium hover:text-accent hover:underline" %>
            <p class="truncate text-xs text-ink-3">
              <% if group.servers.any? %>
                <%= pluralize(group.servers.size, "serveur", plural: "serveurs") %> : <%= group.servers.map(&:name).join(", ") %>
              <% else %>
                Aucun serveur
              <% end %>
            </p>
          </div>
          <% if can?(:operate) %>
            <%= link_to edit_server_group_path(group), title: "Modifier", aria: { label: "Modifier le groupe #{group.name}" },
                  class: "rounded-md p-1.5 text-ink-3 hover:bg-subtle hover:text-ink-2" do %>
              <%= icon :pencil_square %>
            <% end %>
            <%= button_to server_group_path(group), method: :delete, title: "Supprimer", aria: { label: "Supprimer le groupe #{group.name}" },
                  form: { data: { turbo_confirm: "Le groupe « #{group.name} » sera supprimé. Ses serveurs ne seront pas touchés.",
                                  confirm_label: "Supprimer le groupe", confirm_variant: "danger" } },
                  class: "cursor-pointer rounded-md p-1.5 text-ink-3 hover:bg-crit-soft hover:text-crit-ink" do %>
              <%= icon :trash %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-4 rounded-xl border border-dashed border-line bg-surface px-6 py-12 text-center">
      <p class="text-sm text-ink-3">Aucun groupe. Les groupes servent à filtrer les serveurs et à en sélectionner plusieurs d'un coup (ex. « Production », « Clients »).</p>
      <% if can?(:operate) %>
        <%= link_to "Créer un groupe", new_server_group_path, class: "mt-2 inline-block text-sm font-medium text-accent hover:text-accent" %>
      <% end %>
    </div>
  <% end %>
</section>
