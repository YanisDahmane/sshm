<%# Guides the user when SSH fails because of the app key: reason is :missing_key or :key_refused. %>
<div class="ssh-setup-hint mt-3 rounded-md border border-line bg-subtle p-4 text-sm text-ink-2">
  <% if reason == :missing_key %>
    <p><%= t(".elio_has_ssh_key") %></p>
    <% if can?(:administer) %>
      <%= link_to t(".generate_key_settings"), settings_path, data: { turbo_frame: "_top" },
            class: "btn btn-primary mt-3" %>
    <% else %>
      <p class="mt-1 text-ink-3"><%= t(".ask_administrator_generate") %></p>
    <% end %>
  <% elsif (ssh_key = SshKey.current) %>
    <p>
      <%= t(".install_html", login: tag.code("#{server.username}@#{server.host}", class: "rounded bg-surface px-1 font-mono text-xs ring-1 ring-line")) %>
      <code class="rounded bg-surface px-1 font-mono text-xs ring-1 ring-line"><%= server.username %>@<%= server.host %></code>
      <%= "" %>
    </p>
    <div class="mt-3" data-controller="clipboard">
      <div class="flex items-start gap-2">
        <textarea readonly rows="3" data-clipboard-target="source" aria-label="<%= t(".elio_s_key_install") %>"
                  class="block w-full resize-none rounded-md border border-line bg-neutral-950 px-3 py-2 font-mono text-xs text-neutral-100"><%= ssh_key_install_command(ssh_key) %></textarea>
        <%= render "settings/copy_button" %>
      </div>
    </div>
  <% end %>
</div>
