<%# Guides the user when SSH fails because of the app key: reason is :missing_key or :key_refused. %>
<div class="ssh-setup-hint mt-3 rounded-md border border-line bg-subtle p-4 text-sm text-ink-2">
  <% if reason == :missing_key %>
    <p>Elio n'a pas encore de clé SSH pour se connecter aux serveurs.</p>
    <% if can?(:administer) %>
      <%= link_to "Générer la clé dans les paramètres", settings_path, data: { turbo_frame: "_top" },
            class: "mt-3 inline-flex rounded-md bg-accent px-3 py-1.5 text-sm font-semibold text-white hover:bg-accent-hover" %>
    <% else %>
      <p class="mt-1 text-ink-3">Demandez à un administrateur de la générer.</p>
    <% end %>
  <% elsif (ssh_key = SshKey.current) %>
    <p>
      Le serveur ne connaît pas encore la clé d'Elio. Connectez-vous-y en
      <code class="rounded bg-surface px-1 font-mono text-xs ring-1 ring-line"><%= server.username %>@<%= server.host %></code>
      et lancez cette commande, puis réessayez :
    </p>
    <div class="mt-3" data-controller="clipboard">
      <div class="flex items-start gap-2">
        <textarea readonly rows="3" data-clipboard-target="source" aria-label="Commande d'installation de la clé Elio"
                  class="block w-full resize-none rounded-md border border-line bg-neutral-950 px-3 py-2 font-mono text-xs text-neutral-100"><%= ssh_key_install_command(ssh_key) %></textarea>
        <%= render "settings/copy_button" %>
      </div>
    </div>
  <% end %>
</div>
