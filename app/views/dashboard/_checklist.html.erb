<%# Setup steps until everything is done (see OnboardingChecklist). %>
<section id="onboarding" class="mt-6 rounded-xl border border-accent/40 bg-accent-soft/50 p-6">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-lg font-semibold"><%= t(".getting_started_elio") %></h2>
    <span class="text-sm font-medium text-accent"><%= checklist.done_count %>/<%= checklist.steps.size %></span>
  </div>
  <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-accent-soft">
    <div class="h-full rounded-full bg-accent" style="width: <%= (100 * checklist.done_count / checklist.steps.size) %>%"></div>
  </div>

  <ol class="mt-5 space-y-3">
    <% checklist.steps.each_with_index do |step, index| %>
      <% current = step == checklist.current %>
      <li id="onboarding-<%= step.key %>" class="onboarding-step flex gap-3 <%= step.done? ? "is-done" : "" %>">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold
                     <%= step.done? ? "bg-good text-white" : (current ? "bg-accent-fill text-white" : "bg-surface text-ink-3 ring-1 ring-line") %>">
          <%= step.done? ? icon(:check, class: "h-3.5 w-3.5") : index + 1 %>
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium <%= step.done? ? "text-ink-3 line-through" : "text-ink" %>"><%= step.title %></p>
          <% if current %>
            <p class="mt-0.5 text-sm text-ink-2"><%= step.description %></p>
            <div class="mt-2">
              <% case step.key %>
              <% when :ssh_key %>
                <%= button_to t(".generate_key"), ssh_key_path, class: "btn btn-primary" %>
              <% when :server %>
                <%= link_to t(".add_server"), new_server_path, class: "btn btn-primary" %>
              <% when :install_key %>
                <%= render "ssh_keys/setup_hint", server: Server.order(:name).first, reason: :key_refused %>
                <%= link_to t(".open_test", order: Server.order(:name).first.name), server_path(Server.order(:name).first),
                      class: "btn btn-primary mt-3" %>
              <% when :public_key %>
                <%= link_to t(".add_key"), new_public_key_path, class: "btn btn-primary" %>
              <% when :inventory %>
                <% if can?(:operate) && (server = Server.where(ssh_ok: true).order(:name).first) %>
                  <%= button_to t(".inventory", server_name: server.name), server_inventory_path(server), class: "btn btn-primary" %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </li>
    <% end %>
  </ol>
</section>
