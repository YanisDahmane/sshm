<% content_for :title, "Dashboard · SSHM" %>

<div class="flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
    <p class="mt-1 text-sm text-slate-500">
      <% if @insights.scanned? %>
        Clés lues <%= relative_time_tag @insights.last_read_at %>.
      <% else %>
        Les clés des serveurs n'ont pas encore été lues.
      <% end %>
    </p>
  </div>
  <% if @servers.any? %>
    <%= button_to server_scans_path,
          class: "inline-flex shrink-0 cursor-pointer items-center gap-2 whitespace-nowrap rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do %>
      <%= icon :key, class: "h-4 w-4" %> Scanner les clés
    <% end %>
  <% end %>
</div>

<% unless @checklist.complete? %>
  <%= render "dashboard/checklist", checklist: @checklist %>
<% end %>

<% online = @servers.count { |server| server.reachable } %>
<% orphans = @insights.orphan_count %>
<div id="stats" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <%= render "dashboard/stat", id: "stat-online", label: "Serveurs en ligne", path: servers_path,
        value: "#{online}/#{@servers.size}", tone: (online < @servers.size ? :warning : :ok) %>
  <%= render "dashboard/stat", id: "stat-orphans", label: "Clés sans profil", path: "#attention",
        value: (@insights.scanned? ? orphans : "—"), tone: (orphans.positive? ? :warning : :ok),
        hint: (@insights.scanned? ? nil : "Lancez un scan") %>
  <%= render "dashboard/stat", id: "stat-temporary", label: "Accès temporaires en cours", path: "#temporary-accesses",
        value: @temporary_accesses.size, tone: :neutral %>
  <%= render "dashboard/stat", id: "stat-profiles", label: "Profils", path: profiles_path, value: @profiles_count, tone: :neutral %>
</div>

<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <section id="temporary-accesses" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Accès temporaires en cours</h2>
    <% if @temporary_accesses.any? %>
      <ul class="mt-4 divide-y divide-slate-100">
        <% @temporary_accesses.each do |access| %>
          <li id="<%= dom_id(access) %>" class="flex items-center justify-between gap-3 py-3 text-sm">
            <div class="min-w-0">
              <p class="truncate font-medium"><%= access.profile&.name || "Profil supprimé" %></p>
              <p class="truncate text-xs text-slate-500">
                <%= link_to access.server.name, server_path(access.server), class: "hover:text-indigo-600 hover:underline" %>
                · <span class="font-mono"><%= access.unix_user %></span>
              </p>
            </div>
            <%= relative_time_tag access.expires_at, prefix: "Expire ", expired: "Expiré, suppression en cours",
                  class: "shrink-0 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-slate-500">Aucun accès temporaire. Choisissez une durée en autorisant un profil sur un serveur.</p>
    <% end %>
  </section>

  <section id="attention" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">À surveiller</h2>
    <% attention = @servers.select { |server| server.reachable == false || server.ssh_ok == false || @insights.orphans_by_server_id[server.id].present? } %>
    <% if attention.any? %>
      <ul class="mt-4 divide-y divide-slate-100">
        <% attention.each do |server| %>
          <% orphans = @insights.orphans_by_server_id[server.id].to_a %>
          <li id="attention-<%= dom_id(server) %>" class="py-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <%= link_to server.name, server_path(server), class: "truncate font-medium hover:text-indigo-600 hover:underline" %>
              <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
                <% if server.reachable == false %><%= render "servers/status", server: server %><% end %>
                <% if server.ssh_ok == false %><%= render "servers/ssh_status", server: server %><% end %>
                <% if orphans.any? %><%= render "servers/orphan_keys", server: server, insights: @insights %><% end %>
              </div>
            </div>
            <% if orphans.any? %>
              <p class="attention-orphans mt-1 truncate text-xs text-slate-500">
                <%= orphans.first(3).map { |key| key.name || "sans nom" }.join(", ") %><%= " et #{orphans.size - 3} autre(s)" if orphans.size > 3 %>
                — <%= link_to "convertir en profil", server_path(server, anchor: "server-authorized-keys"), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% elsif @servers.any? %>
      <p class="mt-4 text-sm text-slate-500">Rien à signaler : serveurs joignables, connexion SSH OK et toutes les clés correspondent à un profil.</p>
    <% else %>
      <p class="mt-4 text-sm text-slate-500">Ajoutez un serveur pour commencer.</p>
    <% end %>
  </section>
</div>
