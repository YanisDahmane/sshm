<% content_for :title, t("title", page: t("monitors.index.monitors")) %>
<% base_url = @integration.value(:url) %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold"><%= t("words.monitors") %></h1>
    <p class="text-xs text-ink-3">
      <%= t(".uptime_kuma_monitors_attached") %><% if @integration.last_synced_at %><%= t(".synchronized_html", last_synced_at: (relative_time_tag @integration.last_synced_at)) %><% end %>.
      <% if @integration.last_error %><span class="text-crit-ink"><%= t(".last_sync_failed_html", last_error: @integration.last_error) %></span><% end %>
    </p>
  </div>
  <% if can?(:administer) %>
    <%= link_to edit_settings_integration_path(@integration.kind), class: "btn btn-secondary" do %><%= icon :cog, class: "h-4 w-4" %>Extension<% end %>
  <% end %>
</div>

<div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <%= stat_tile t(".monitors"), @counts[:total], nil, icon: :signal, id: "stat-monitors" %>
  <%= stat_tile t(".down"), @counts[:down], nil, tone: (@counts[:down].positive? ? :crit : nil), icon: :x_circle, id: "stat-monitors-down" %>
  <%= stat_tile t(".not_attached"), @counts[:unattached], t(".server"), tone: (@counts[:unattached].positive? ? :warn : nil), icon: :exclamation_triangle, id: "stat-unattached" %>
  <%= stat_tile t(".servers_without_monitor"), @servers_without.size, nil, tone: (@servers_without.any? ? :warn : nil), icon: :server_stack, id: "stat-without" %>
</div>

<div class="mt-5 flex flex-wrap items-center gap-2">
  <nav class="monitor-filters flex flex-wrap gap-2" aria-label="<%= t(".filters") %>">
    <% [ [ t(".all"), nil ], [ t(".not_attached"), "unattached" ], [ t(".down"), "down" ], [ t(".servers_without_monitor"), "without" ] ].each do |label, filter| %>
      <%= filter_pill label, monitors_path(filter: filter), active: @filter == filter, data: { filter: filter || "all" } %>
    <% end %>
  </nav>
  <% unless @filter == "without" %>
    <%= form_with url: monitors_path, method: :get, data: { controller: "auto-submit", turbo_action: "advance" }, class: "ml-auto" do |f| %>
      <%= hidden_field_tag :filter, @filter if @filter %>
      <%= f.search_field :q, value: @q, placeholder: t(".name_host_url"), aria: { label: t(".search_monitor") },
            data: { action: "input->auto-submit#submitLater" }, class: "input w-48 py-1 text-xs" %>
    <% end %>
  <% end %>
</div>

<% if @filter == "without" %>
  <% if @pager.records.any? %>
    <div class="card mt-3 overflow-x-auto">
      <table id="servers-without-monitor" class="table-dense">
        <thead><tr><th class="pl-4"><%= t(".server_2") %></th><th><%= t("words.addresses") %></th><th class="pr-4"><%= t(".groups") %></th></tr></thead>
        <tbody>
          <% @pager.records.each do |server| %>
            <tr class="server-without-monitor">
              <td class="pl-4"><%= link_to server.name, server_path(server, tab: "monitors"), class: "font-medium hover:text-accent hover:underline" %></td>
              <td class="font-mono text-xs text-ink-2"><%= server.addresses.first(3).join(", ").presence || "—" %></td>
              <td class="pr-4"><%= render partial: "server_groups/badge", collection: server.server_groups, as: :group %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: t("nouns.servers") %>
  <% else %>
    <p class="card mt-3 px-4 py-6 text-sm text-good-ink"><%= t(".each_server_watched_least") %></p>
  <% end %>
<% elsif @pager.records.any? %>
  <div class="card mt-3 overflow-x-auto">
    <table id="monitors" class="table-dense">
      <thead><tr><th class="pl-4"><%= t("words.monitor") %></th><th><%= t(".server_2") %></th><th><%= t("words.target") %></th><th><%= t(".state") %></th><th><%= t(".response") %></th><th><%= t(".uptime_24_h_30") %></th><th><%= t("words.certificate") %></th><% if can?(:operate) %><th class="pr-4 text-right"><%= t(".attach") %></th><% end %></tr></thead>
      <tbody><%= render partial: "integrations/uptime_kuma/monitor_row", collection: @pager.records, as: :monitor, locals: { base_url: base_url, show_server: true } %></tbody>
    </table>
  </div>
  <%= render "shared/pagination", pager: @pager, noun: t("nouns.monitors") %>
<% else %>
  <p class="card mt-3 px-4 py-6 text-sm text-ink-3"><%= @integration.last_synced_at ? t(".monitor_matches") : t(".not_synchronized_uptime_kuma") %></p>
<% end %>
