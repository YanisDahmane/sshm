<% content_for :title, "Sondes · Elio" %>
<% base_url = @integration.value(:url) %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold">Sondes</h1>
    <p class="text-xs text-ink-3">
      Sondes d'Uptime Kuma rattachées aux serveurs du parc<% if @integration.last_synced_at %>, synchronisées <%= relative_time_tag @integration.last_synced_at %><% end %>.
      <% if @integration.last_error %><span class="text-crit-ink">Dernière synchronisation impossible : <%= @integration.last_error %></span><% end %>
    </p>
  </div>
  <% if can?(:administer) %>
    <%= link_to edit_settings_integration_path(@integration.kind), class: "btn btn-secondary" do %><%= icon :cog, class: "h-4 w-4" %>Extension<% end %>
  <% end %>
</div>

<div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <%= stat_tile "Sondes", @counts[:total], nil, icon: :signal, id: "stat-monitors" %>
  <%= stat_tile "Hors ligne", @counts[:down], nil, tone: (@counts[:down].positive? ? :crit : nil), icon: :x_circle, id: "stat-monitors-down" %>
  <%= stat_tile "Non rattachées", @counts[:unattached], "à aucun serveur", tone: (@counts[:unattached].positive? ? :warn : nil), icon: :exclamation_triangle, id: "stat-unattached" %>
  <%= stat_tile "Serveurs sans sonde", @servers_without.size, nil, tone: (@servers_without.any? ? :warn : nil), icon: :server_stack, id: "stat-without" %>
</div>

<div class="mt-5 flex flex-wrap items-center gap-2">
  <nav class="monitor-filters flex flex-wrap gap-2" aria-label="Filtres">
    <% [ [ "Toutes", nil ], [ "Non rattachées", "unattached" ], [ "Hors ligne", "down" ], [ "Serveurs sans sonde", "without" ] ].each do |label, filter| %>
      <%= filter_pill label, monitors_path(filter: filter), active: @filter == filter, data: { filter: filter || "all" } %>
    <% end %>
  </nav>
  <% unless @filter == "without" %>
    <%= form_with url: monitors_path, method: :get, data: { controller: "auto-submit", turbo_action: "advance" }, class: "ml-auto" do |f| %>
      <%= hidden_field_tag :filter, @filter if @filter %>
      <%= f.search_field :q, value: @q, placeholder: "Nom, hôte, URL…", aria: { label: "Rechercher une sonde" },
            data: { action: "input->auto-submit#submitLater" }, class: "input w-48 py-1 text-xs" %>
    <% end %>
  <% end %>
</div>

<% if @filter == "without" %>
  <% if @pager.records.any? %>
    <div class="card mt-3 overflow-x-auto">
      <table id="servers-without-monitor" class="table-dense">
        <thead><tr><th class="pl-4">Serveur</th><th>Adresses</th><th class="pr-4">Groupes</th></tr></thead>
        <tbody>
          <% @pager.records.each do |server| %>
            <tr class="server-without-monitor">
              <td class="pl-4"><%= link_to server.name, server_path(server, tab: "monitors"), class: "font-medium hover:text-accent hover:underline" %></td>
              <td class="font-mono text-xs text-ink-2"><%= server.addresses.first(3).join(", ").presence || "—" %></td>
              <td class="pr-4"><%= render partial: "server_groups/badge", collection: server.server_groups, as: :group %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: "serveurs" %>
  <% else %>
    <p class="card mt-3 px-4 py-6 text-sm text-good-ink">Chaque serveur est surveillé par au moins une sonde.</p>
  <% end %>
<% elsif @pager.records.any? %>
  <div class="card mt-3 overflow-x-auto">
    <table id="monitors" class="table-dense">
      <thead><tr><th class="pl-4">Sonde</th><th>Serveur</th><th>Cible</th><th>État</th><th>Réponse</th><th>Dispo. 24 h · 30 j</th><th>Certificat</th><% if can?(:operate) %><th class="pr-4 text-right">Rattacher à</th><% end %></tr></thead>
      <tbody><%= render partial: "integrations/uptime_kuma/monitor_row", collection: @pager.records, as: :monitor, locals: { base_url: base_url, show_server: true } %></tbody>
    </table>
  </div>
  <%= render "shared/pagination", pager: @pager, noun: "sondes" %>
<% else %>
  <p class="card mt-3 px-4 py-6 text-sm text-ink-3"><%= @integration.last_synced_at ? "Aucune sonde ne correspond." : "Pas encore synchronisé avec Uptime Kuma." %></p>
<% end %>
