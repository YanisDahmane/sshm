<% content_for :title, "Clés autorisées · #{@server.name} · SSHM" %>

<turbo-frame id="<%= dom_id(@server, :authorized_keys) %>" class="group block">
  <nav class="account-tabs mb-4 flex flex-wrap gap-2" aria-label="Comptes">
    <% @accounts.each do |account| %>
      <%= link_to server_authorized_keys_path(@server, account: account.unix_user),
            aria: { current: (account == @account ? "page" : nil) },
            class: "account-tab inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium ring-1 ring-inset #{account == @account ? "bg-indigo-600 text-white ring-indigo-600" : "bg-white text-slate-700 ring-slate-300 hover:bg-slate-50"}" do %>
        <span class="font-mono"><%= account.unix_user %></span>
        <% if account.login? %>
          <span class="text-xs opacity-75">connexion</span>
        <% elsif account.sudo? %>
          <span class="text-xs opacity-75">via sudo</span>
        <% end %>
      <% end %>
    <% end %>
  </nav>

  <div class="flex items-center justify-between gap-4">
    <p class="text-sm text-slate-500">
      <code class="rounded bg-slate-100 px-1 font-mono text-xs"><%= @account.path %></code>
      <% if @result.success? %>
        · <%= pluralize(@result.keys.size, "clé", plural: "clés") %>
      <% end %>
    </p>
    <%= link_to server_authorized_keys_path(@server, account: @account.unix_user),
          title: "Recharger les clés", aria: { label: "Recharger les clés" },
          class: "rounded-md border border-slate-300 bg-white p-2 text-slate-600 shadow-sm hover:bg-slate-50" do %>
      <%= icon :arrow_path, class: "h-4 w-4 group-aria-busy:animate-spin" %>
    <% end %>
  </div>

  <% if @result.success? && can?(:operate) %>
    <% if @authorizable_profiles.any? %>
      <%= form_with url: server_authorizations_path(@server),
            data: { controller: "quiet-submit", turbo_frame: "_top" },
            class: "authorize-profile mt-4 flex flex-wrap items-end gap-2 rounded-md bg-slate-50 p-3" do |f| %>
        <%= f.hidden_field :account, value: @account.unix_user %>
        <div class="min-w-40 flex-1">
          <%= f.label :profile_id, "Autoriser un profil pour #{@account.unix_user}", for: "profile_id", class: "block text-xs font-medium text-slate-600" %>
          <%= f.select :profile_id, @authorizable_profiles.map { |profile| [ profile.name, profile.id ] }, {}, id: "profile_id",
                class: "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :duration, "Durée", for: "duration", class: "block text-xs font-medium text-slate-600" %>
          <%= f.select :duration, [ [ "Permanent", "" ], *TemporaryAccess::DURATIONS.map { |value, (label, _)| [ label, value ] } ], {}, id: "duration",
                class: "mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        </div>
        <%= f.button type: "submit",
              class: "group inline-flex cursor-pointer items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-wait disabled:opacity-60" do %>
          <%= icon :arrow_path, class: "hidden h-4 w-4 animate-spin group-disabled:block" %>
          Autoriser
        <% end %>
      <% end %>
    <% elsif Profile.none? %>
      <p class="mt-4 text-xs text-slate-500">
        <%= link_to "Créez un profil", new_profile_path, data: { turbo_frame: "_top" }, class: "font-medium text-indigo-600 hover:text-indigo-500" %> pour pouvoir l'autoriser sur ce serveur.
      </p>
    <% else %>
      <p class="all-profiles-authorized mt-4 text-xs text-slate-500">Tous les profils sont autorisés pour <%= @account.unix_user %>.</p>
    <% end %>
  <% end %>

  <div class="mt-4 group-aria-busy:opacity-50">
    <% if !@result.success? %>
      <div class="authorized-keys-error flex gap-3 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <%= icon :x_mark, class: "mt-0.5 h-4 w-4 shrink-0" %>
        <div>
          <p class="font-medium"><%= @result.error_title %></p>
          <p class="mt-1 break-all font-mono text-xs text-red-700"><%= @result.error_details %></p>
        </div>
      </div>
      <% if @result.reason %>
        <%= render "ssh_keys/setup_hint", server: @server, reason: @result.reason %>
      <% end %>
      <%= link_to "Réessayer", server_authorized_keys_path(@server, account: @account.unix_user),
            class: "retry-authorized-keys mt-3 inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" %>
    <% elsif @result.keys.empty? %>
      <p class="rounded-md border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500">Aucune clé autorisée sur ce serveur.</p>
    <% else %>
      <% if @orphan_keys.any? %>
        <% one = @orphan_keys.one? %>
        <div class="orphan-warning mb-3 flex gap-3 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
          <p>
            <strong><%= pluralize(@orphan_keys.size, "clé ne correspond", plural: "clés ne correspondent") %> à aucun profil.</strong>
            Si vous <%= one ? "la" : "les" %> reconnaissez, convertissez-<%= one ? "la" : "les" %> en profil avec le bouton
            « Créer un profil » ; sinon supprimez-<%= one ? "la" : "les" %>.
          </p>
        </div>
      <% end %>
      <ul class="authorized-keys divide-y divide-slate-100 rounded-md border border-slate-200">
        <% @result.keys.each do |key| %>
          <% orphan = @orphan_keys.include?(key) %>
          <li class="authorized-key flex items-center gap-3 px-4 py-3 <%= "is-orphan border-l-4 border-l-amber-400 bg-amber-50/40" if orphan %>">
            <%= icon :key, class: "h-4 w-4 shrink-0 text-slate-400" %>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="key-name truncate text-sm font-medium <%= key.named? ? "text-slate-900" : "italic text-slate-500" %>">
                  <%= key.named? ? key.name : "Sans nom" %>
                </span>
                <% if key.named? %>
                  <span class="key-badge rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Connue</span>
                <% else %>
                  <span class="key-badge rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/20">Inconnue</span>
                <% end %>
                <% if (profile = @profiles_by_fingerprint[key.fingerprint]) %>
                  <%= link_to profile_path(profile), data: { turbo_frame: "_top" },
                        class: "key-profile inline-flex items-center gap-1 rounded-full bg-sky-50 px-2 py-0.5 text-xs font-medium text-sky-700 ring-1 ring-inset ring-sky-600/20 hover:bg-sky-100" do %>
                    Profil : <%= profile.name %>
                  <% end %>
                <% end %>
                <% if (access = @temporary_accesses[key.fingerprint]) %>
                  <%= relative_time_tag access.expires_at, prefix: "Expire ", expired: "Expiré, suppression en cours",
                        class: "key-expiry inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20" %>
                <% end %>
                <% if key.matches?(@app_key) %>
                  <span class="key-badge key-master rounded-full bg-indigo-600 px-2 py-0.5 text-xs font-semibold text-white" title="Clé SSH de l'application SSHM">Master</span>
                <% end %>
              </div>
            </div>
            <div data-controller="modal" class="shrink-0">
              <button type="button" data-action="modal#open" title="Détails de la clé" aria-label="Détails de la clé <%= key.name || "sans nom" %>"
                      class="key-details-button cursor-pointer rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600">
                <%= icon :information_circle %>
              </button>
              <%= render "server_authorized_keys/key_details", key: key, account: @account, profile: @profiles_by_fingerprint[key.fingerprint],
                                                               dialog_id: "key-#{key.fingerprint.delete_prefix("SHA256:").gsub(/[^A-Za-z0-9]/, "")[0, 16]}" %>
            </div>
            <% if orphan %>
              <% if can?(:operate) %>
                <%= link_to new_profile_path(public_key: [ key.type, key.key, key.comment ].compact.join(" "), name: suggested_profile_name(key),
                                             return_to: server_path(@server, anchor: "server-authorized-keys")),
                      data: { turbo_frame: "_top" },
                      class: "create-profile inline-flex shrink-0 items-center gap-1.5 rounded-md border border-indigo-200 bg-white px-2.5 py-1 text-xs font-medium text-indigo-700 shadow-sm hover:bg-indigo-50" do %>
                  <%= icon :user_plus, class: "h-4 w-4" %> Créer un profil
                <% end %>
              <% end %>
            <% end %>
            <% unless key.matches?(@app_key) %>
              <% if can?(:operate) %>
                <%= button_to server_authorized_key_path(@server), method: :delete,
                      params: { key: key.key, name: key.name, account: @account.unix_user },
                      title: "Supprimer la clé", aria: { label: "Supprimer la clé #{key.name || "sans nom"}" },
                      form: { class: "shrink-0", data: { controller: "quiet-submit", turbo_frame: "_top",
                                                         turbo_confirm: "La clé « #{key.name || "sans nom"} » sera supprimée de « #{@server.name} » pour #{@account.unix_user}. Elle ne pourra plus se connecter avec ce compte.",
                                                         confirm_label: "Supprimer la clé", confirm_variant: "danger" } },
                      class: "cursor-pointer rounded-md p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600 disabled:cursor-wait disabled:opacity-50" do %>
                  <%= icon :trash %>
                <% end %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</turbo-frame>
