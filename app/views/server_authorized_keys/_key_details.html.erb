<%# Details of an authorized key, in a modal opened from its row (modal_controller.js). %>
<dialog data-modal-target="dialog" data-action="click->modal#backdropClose" aria-labelledby="<%= dialog_id %>-title"
        class="key-details m-auto w-full max-w-xl rounded-xl border border-line bg-surface p-0 text-left shadow-xl backdrop:bg-neutral-950/40 backdrop:backdrop-blur-sm">
  <div class="flex items-start justify-between gap-4 border-b border-line px-6 py-4">
    <div class="min-w-0">
      <h2 id="<%= dialog_id %>-title" class="truncate text-base font-semibold <%= key.named? ? "text-ink" : "italic text-ink-3" %>"><%= key.name || t(".unnamed") %></h2>
      <p class="mt-0.5 font-mono text-xs text-ink-3"><%= account.path %></p>
    </div>
    <button type="button" data-action="modal#close" aria-label="<%= t(".close") %>" class="shrink-0 cursor-pointer rounded-md p-1 text-ink-3 hover:bg-subtle hover:text-ink-2">
      <%= icon :x_mark, class: "h-5 w-5" %>
    </button>
  </div>

  <div class="px-6 py-5">
    <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-sm">
      <dt class="text-ink-3">Type</dt>
      <dd class="font-mono text-ink"><%= key.type %></dd>
      <dt class="text-ink-3">Empreinte</dt>
      <dd class="key-fingerprint break-all font-mono text-xs leading-5 text-ink"><%= key.fingerprint %></dd>
      <dt class="text-ink-3">Commentaire</dt>
      <dd class="text-ink"><%= key.comment || tag.span(t(".none"), class: "italic text-ink-3") %></dd>
      <% if key.options %>
        <dt class="text-ink-3">Options</dt>
        <dd class="key-options break-all font-mono text-warn-ink"><%= key.options %></dd>
      <% end %>
      <% if public_key %>
        <dt class="text-ink-3">Trousseau</dt>
        <dd><%= link_to public_key.name, public_key_path(public_key), data: { turbo_frame: "_top" }, class: "font-medium text-accent hover:text-accent" %></dd>
      <% end %>
      <% if key.line_number %>
        <dt class="text-ink-3">Ligne</dt>
        <dd class="text-ink"><%= t(".line_file_html", line_number: key.line_number) %></dd>
      <% end %>
    </dl>

    <div class="mt-5" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="<%= dialog_id %>-line" class="text-sm font-medium text-ink-2"><%= t(".file_line") %></label>
        <%= render "settings/copy_button" %>
      </div>
      <textarea id="<%= dialog_id %>-line" readonly rows="3" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-line bg-subtle px-3 py-2 font-mono text-xs text-ink-2"><%= key.to_line %></textarea>
    </div>
  </div>
</dialog>
