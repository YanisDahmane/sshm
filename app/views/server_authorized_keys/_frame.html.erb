<%# Lazy-loaded list of the server's authorized keys; reloads itself through the refresh link. %>
<turbo-frame id="<%= dom_id(server, :authorized_keys) %>" src="<%= server_authorized_keys_path(server) %>" loading="lazy" class="group block">
  <div class="flex items-center gap-2 py-6 text-sm text-slate-500">
    <%= icon :arrow_path, class: "h-4 w-4 animate-spin" %>
    Lecture des clés autorisées…
  </div>
</turbo-frame>
