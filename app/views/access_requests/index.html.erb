<% content_for :title, "Demandes d'accès · SSHM" %>

<%= render "access_rules/tabs", current: :requests %>

<div class="mt-6 flex items-center justify-between gap-4">
  <p class="text-sm text-slate-500">Demandez un accès temporaire à un serveur avec votre profil SSH ; un opérateur ou un administrateur l'accepte ou la refuse.</p>
  <%= link_to "Demander un accès", new_access_request_path,
        class: "shrink-0 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
</div>

<% if can?(:operate) %>
  <section id="pending-requests" class="mt-6">
    <h2 class="text-base font-semibold">À traiter</h2>
    <% if @pending.any? %>
      <ul class="mt-2 divide-y divide-slate-100 rounded-xl border border-amber-200 bg-white shadow-sm">
        <%= render partial: "access_requests/request", collection: @pending, as: :request, locals: { decide: true } %>
      </ul>
    <% else %>
      <p class="mt-2 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-6 text-center text-sm text-slate-500">Aucune demande en attente.</p>
    <% end %>
  </section>
<% end %>

<section id="my-requests" class="mt-6">
  <h2 class="text-base font-semibold">Mes demandes</h2>
  <% if @mine.any? %>
    <ul class="mt-2 divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white shadow-sm">
      <%= render partial: "access_requests/request", collection: @mine, as: :request, locals: { mine: true } %>
    </ul>
  <% else %>
    <p class="mt-2 text-sm text-slate-500">Vous n'avez fait aucune demande.</p>
  <% end %>
</section>

<% if can?(:operate) && @history.any? %>
  <section id="requests-history" class="mt-6">
    <h2 class="text-base font-semibold">Historique</h2>
    <ul class="mt-2 divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white shadow-sm">
      <%= render partial: "access_requests/request", collection: @history, as: :request %>
    </ul>
  </section>
<% end %>
