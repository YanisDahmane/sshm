<%# One access request; `decide` shows the approve / deny actions (pending list). %>
<li id="<%= dom_id(request) %>" class="access-request px-4 py-3 text-sm">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <% unless local_assigns[:mine] %><span class="font-medium"><%= request.requester.email %></span><span class="text-slate-400">→</span><% end %>
    <%= link_to request.server.name, server_path(request.server), class: "font-medium hover:text-indigo-600 hover:underline" %>
    <span class="font-mono text-xs text-slate-600"><%= request.unix_user %></span>
    <span class="text-slate-500">· <%= request.duration_label %></span>
    <% badge = { "pending" => "bg-amber-50 text-amber-800 ring-amber-600/20", "approved" => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
                 "denied" => "bg-red-50 text-red-700 ring-red-600/20" }.fetch(request.status, "bg-slate-100 text-slate-600 ring-slate-500/20") %>
    <span class="request-status rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset <%= badge %>"><%= request.status_label %></span>
    <span class="ml-auto text-xs text-slate-400"><%= relative_time_tag request.created_at %></span>
  </div>
  <p class="request-reason mt-1 text-slate-700">« <%= request.reason %> »</p>
  <% if request.decided_by %>
    <p class="mt-1 text-xs text-slate-500">
      <%= request.status == "approved" ? "Acceptée" : "Refusée" %> par <%= request.decided_by.email %> <%= relative_time_in_words(request.decided_at) %>
      <% if request.decision_note %> : « <%= request.decision_note %> »<% end %>
    </p>
  <% elsif request.pending? %>
    <p class="mt-1 text-xs text-slate-500">Expire <%= relative_time_in_words(request.expires_at) %> sans décision.</p>
  <% end %>

  <% if local_assigns[:decide] %>
    <% if request.decidable_by?(current_user) %>
      <div class="mt-3 flex flex-wrap items-start gap-2">
        <%= button_to "Accepter", approve_access_request_path(request), form: { data: { controller: "quiet-submit" } },
              class: "cursor-pointer rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-wait disabled:opacity-60" %>
        <%= form_with url: deny_access_request_path(request), class: "deny-request flex flex-wrap gap-2" do |f| %>
          <%= f.text_field :decision_note, placeholder: "Motif du refus (facultatif)", maxlength: 500, aria: { label: "Motif du refus" },
                class: "w-64 rounded-md border border-slate-300 px-3 py-1.5 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
          <%= f.submit "Refuser", class: "cursor-pointer rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 shadow-sm hover:bg-red-50" %>
        <% end %>
      </div>
    <% elsif request.requester == current_user %>
      <p class="own-request mt-2 text-xs text-slate-500">C'est votre demande : un autre opérateur ou administrateur doit la traiter.</p>
    <% end %>
  <% elsif local_assigns[:mine] && request.pending? %>
    <%= button_to "Annuler la demande", cancel_access_request_path(request), form: { class: "mt-2" },
          class: "cursor-pointer text-xs font-medium text-slate-500 hover:text-slate-700 hover:underline" %>
  <% end %>
</li>
