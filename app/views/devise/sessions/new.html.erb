<% content_for :title, "Connexion · Elio" %>

<h2 class="mb-6 text-xl font-semibold">Connexion</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
  <div>
    <%= f.label :email, "Email", class: "label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
          class: "input mt-1" %>
  </div>

  <div>
    <%= f.label :password, "Mot de passe", class: "label" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true,
          class: "input mt-1" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-line text-accent" %>
      <%= f.label :remember_me, "Se souvenir de moi", class: "text-sm text-ink-2" %>
    </div>
  <% end %>

  <%= f.submit "Se connecter",
        class: "btn btn-primary w-full" %>
<% end %>

<% if Rails.configuration.x.mail_enabled %>
  <p class="mt-4 text-center text-sm"><%= link_to "Mot de passe oublié ?", new_password_path(resource_name), class: "forgot-password text-accent hover:underline" %></p>
<% end %>

<p class="mt-6 text-center text-sm text-ink-3">
  Pas encore de compte ? Demandez une invitation à un administrateur.
</p>
