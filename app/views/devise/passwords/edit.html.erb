<% content_for :title, t("title", page: t("auth.reset.title")) %>

<h2 class="mb-6 text-xl font-semibold"><%= t("auth.reset.heading") %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>
  <%= render "shared/auth_field", f: f, attribute: :password, label: t("auth.fields.new_password"), type: :password_field, autofocus: true, autocomplete: "new-password",
                                  hint: (t("auth.fields.min_length", count: @minimum_password_length) if @minimum_password_length) %>
  <%= render "shared/auth_field", f: f, attribute: :password_confirmation, label: t("auth.fields.confirmation"), type: :password_field, autocomplete: "new-password" %>
  <%= f.submit t("auth.reset.submit"), class: "btn btn-primary w-full" %>
<% end %>

<p class="mt-6 text-center text-sm"><%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name), class: "text-accent hover:underline" %></p>
