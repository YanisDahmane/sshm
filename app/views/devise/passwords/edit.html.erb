<% content_for :title, "Nouveau mot de passe · Elio" %>

<h2 class="mb-6 text-xl font-semibold">Choisir un nouveau mot de passe</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>
  <%= render "shared/auth_field", f: f, attribute: :password, label: "Nouveau mot de passe", type: :password_field, autofocus: true, autocomplete: "new-password",
                                  hint: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length) %>
  <%= render "shared/auth_field", f: f, attribute: :password_confirmation, label: "Confirmation", type: :password_field, autocomplete: "new-password" %>
  <%= f.submit "Enregistrer le mot de passe", class: "btn btn-primary w-full" %>
<% end %>

<p class="mt-6 text-center text-sm"><%= link_to "Retour à la connexion", new_session_path(resource_name), class: "text-accent hover:underline" %></p>
