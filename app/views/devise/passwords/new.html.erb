<% content_for :title, "Mot de passe oublié · Elio" %>

<h2 class="mb-2 text-xl font-semibold">Mot de passe oublié</h2>
<p class="mb-6 text-sm text-ink-3">Indiquez votre email : si un compte existe, vous recevrez un lien pour choisir un nouveau mot de passe (valable 2 heures).</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= render "shared/auth_field", f: f, attribute: :email, label: "Email", type: :email_field, autofocus: true, autocomplete: "email" %>
  <%= f.submit "Recevoir le lien", class: "btn btn-primary w-full" %>
<% end %>

<p class="mt-6 text-center text-sm"><%= link_to "Retour à la connexion", new_session_path(resource_name), class: "text-accent hover:underline" %></p>
