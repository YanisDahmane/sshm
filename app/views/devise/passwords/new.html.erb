<% content_for :title, t("title", page: t("auth.forgot.title")) %>

<h2 class="mb-2 text-xl font-semibold"><%= t("auth.forgot.title") %></h2>
<p class="mb-6 text-sm text-ink-3"><%= t("auth.forgot.intro") %></p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= render "shared/auth_field", f: f, attribute: :email, label: t("auth.fields.email"), type: :email_field, autofocus: true, autocomplete: "email" %>
  <%= f.submit t("auth.forgot.submit"), class: "btn btn-primary w-full" %>
<% end %>

<p class="mt-6 text-center text-sm"><%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name), class: "text-accent hover:underline" %></p>
