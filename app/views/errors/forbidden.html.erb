<% content_for :title, "Accès refusé · SSHM" %>

<div class="mx-auto mt-12 max-w-md rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
  <p class="text-sm font-semibold uppercase tracking-wide text-red-600">403</p>
  <h1 class="mt-2 text-xl font-bold tracking-tight">Accès refusé</h1>
  <p class="mt-2 text-sm text-slate-600"><%= message %></p>
  <p class="mt-1 text-sm text-slate-500">Demandez à un administrateur si vous avez besoin de ce droit.</p>
  <%= link_to "Retour au dashboard", root_path, class: "mt-6 inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
</div>
