<% content_for :title, "#{@server.name} · Elio" %>

<div class="mx-auto max-w-5xl">
  <%= link_to "← Parc", servers_path, class: "text-sm text-slate-500 hover:text-slate-700" %>

  <div class="mt-2 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= @server.name %></h1>
      <p class="mt-1 font-mono text-sm text-slate-500"><%= @server.username %>@<%= @server.host %>:<%= @server.port %></p>
      <% if @server.server_groups.any? %>
        <div class="server-groups mt-2 flex flex-wrap gap-1.5">
          <%= render partial: "server_groups/badge", collection: @server.server_groups, as: :group %>
        </div>
      <% end %>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <% if can?(:operate) %>
        <%= button_to server_inventory_path(@server), form: { class: "refresh-inventory" },
              class: "inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do %>
          <%= icon :arrow_path %> Actualiser l'inventaire
        <% end %>
        <%= link_to edit_server_path(@server),
              class: "inline-flex shrink-0 items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do %>
          <%= icon :pencil_square %> Modifier
        <% end %>
        <%= render "servers/delete_button", server: @server %>
      <% end %>
    </div>
  </div>

  <%= render "servers/health_bar", server: @server %>
  <%= render "servers/health_card", server: @server %>
  <%= render "servers/system_card", server: @server %>
  <%= render "servers/services_card", server: @server %>
  <%= render "servers/ports_card", server: @server %>

  <section id="server-packages" class="card mt-6">
    <div class="card-header">
      <h2 class="flex items-center gap-2 font-semibold"><%= icon :cube, class: "h-4 w-4 text-ink-3" %> Paquets</h2>
      <%= link_to "Chercher sur tout le parc", packages_path, class: "text-xs font-medium text-accent hover:underline" %>
    </div>
    <%= render "server_packages/frame", server: @server %>
  </section>

  <section id="server-authorized-keys" class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Clés autorisées</h2>
    <p class="mt-1 text-sm text-slate-500">Clés publiques qui peuvent se connecter à ce serveur avec le compte de connexion d'Elio.</p>
    <div class="mt-4">
      <%= render "server_authorized_keys/frame", server: @server %>
    </div>
  </section>

  <section id="server-activity" class="mt-6 rounded-xl border border-slate-200 bg-white px-6 pt-5 pb-2 shadow-sm">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold">Historique</h2>
      <%= link_to "Tout voir", activities_path(server_id: @server.id), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>
    <% if @activities.any? %>
      <ul class="mt-2 divide-y divide-slate-100">
        <%= render partial: "activities/activity", collection: @activities, locals: { show_server: false } %>
      </ul>
    <% else %>
      <p class="py-6 text-sm text-slate-500">Aucune activité sur ce serveur pour le moment.</p>
    <% end %>
  </section>
</div>
