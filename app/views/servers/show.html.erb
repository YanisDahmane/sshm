<% content_for :title, "#{@server.name} · SSHM" %>

<div class="mx-auto max-w-3xl">
  <%= link_to "← Serveurs", servers_path, class: "text-sm text-slate-500 hover:text-slate-700" %>

  <div class="mt-2 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= @server.name %></h1>
      <p class="mt-1 font-mono text-sm text-slate-500"><%= @server.username %>@<%= @server.host %>:<%= @server.port %></p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <%= link_to edit_server_path(@server),
            class: "inline-flex shrink-0 items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do %>
        <%= icon :pencil_square %> Modifier
      <% end %>
      <%= render "servers/delete_button", server: @server %>
    </div>
  </div>

  <%= render "servers/health_bar", server: @server %>

  <section id="server-authorized-keys" class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Clés autorisées</h2>
    <p class="mt-1 text-sm text-slate-500">Clés publiques qui peuvent se connecter à ce serveur. Choisissez le compte à gérer.</p>
    <div class="mt-4">
      <%= render "server_authorized_keys/frame", server: @server %>
    </div>
  </section>

  <section id="server-activity" class="mt-6 rounded-xl border border-slate-200 bg-white px-6 pt-5 pb-2 shadow-sm">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold">Historique</h2>
      <%= link_to "Tout voir", activities_path(server_id: @server.id), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>
    <% if @activities.any? %>
      <ul class="mt-2 divide-y divide-slate-100">
        <%= render partial: "activities/activity", collection: @activities, locals: { show_server: false } %>
      </ul>
    <% else %>
      <p class="py-6 text-sm text-slate-500">Aucune activité sur ce serveur pour le moment.</p>
    <% end %>
  </section>
</div>
