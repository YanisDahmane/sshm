<% content_for :title, "#{@server.name} · Elio" %>
<% os = @server.inventory("os")&.data || {} %>
<% packages = @server.inventory("packages")&.data || {} %>
<% services = @server.inventory("services")&.data || {} %>
<% schedules = @server.inventory("scheduled_tasks")&.data || {} %>
<% docker = @server.inventory("docker")&.data || {} %>
<% ports = @server.inventory("ports") %>
<% snapshot = @server.account_snapshots.find { |candidate| candidate.unix_user == @server.username } %>

<div class="mx-auto max-w-6xl">
  <p class="text-xs text-ink-3">
    <%= link_to "Parc", servers_path, class: "hover:text-ink" %>
    <% if (group = @server.server_groups.first) %><span class="mx-1">/</span><%= link_to group.name, servers_path(group: group.id), class: "hover:text-ink" %><% end %>
    <span class="mx-1">/</span><span class="text-ink-2"><%= @server.name %></span>
  </p>

  <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-xl font-semibold"><%= @server.name %></h1>
        <%= render "servers/status", server: @server, health: true %>
        <% if @server.server_groups.any? %>
          <span class="server-groups flex flex-wrap gap-1.5"><%= render partial: "server_groups/badge", collection: @server.server_groups, as: :group %></span>
        <% end %>
      </div>
      <p class="server-summary mt-1 font-mono text-xs text-ink-3">
        <%= [ "#{@server.username}@#{@server.host}:#{@server.port}", (os["hostname"] if os["hostname"].present? && os["hostname"] != @server.host), os["name"],
              (pluralize_fr(os["cpus"], "processeur", "processeurs") if os["cpus"]), (human_bytes(os["memory_bytes"]) if os["memory_bytes"]) ].compact.join(" · ") %>
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-2">
      <% if can?(:operate) %>
        <%= button_to server_inventory_path(@server), form: { class: "refresh-inventory" }, class: "btn btn-secondary" do %>
          <%= icon :arrow_path %> Actualiser l'inventaire
        <% end %>
        <%= link_to edit_server_path(@server), class: "btn btn-secondary" do %>
          <%= icon :pencil_square %> Modifier
        <% end %>
        <%= render "servers/delete_button", server: @server %>
      <% end %>
    </div>
  </div>

  <%= render "servers/health_bar", server: @server %>

  <nav class="server-tabs scrollbar-none mt-5 flex gap-5 overflow-x-auto border-b border-line text-sm" aria-label="Sections du serveur">
    <% [ [ "overview", "Vue d'ensemble", nil ], [ "packages", "Paquets", packages["total"] ],
         [ "vulnerabilities", "Vulnérabilités", @server.server_vulnerabilities.fixable.distinct.count(:cve).nonzero? ], [ "services", "Services", (Array(services["units"]).count { |unit| unit["active"] == "active" } if services["units"]) ],
         *([ [ "docker", "Docker", (Array(docker["containers"]).size if docker["docker"] == "ok") ] ] if docker["docker"].in?(%w[ok unreadable])),
         [ "schedules", "Tâches planifiées", (Array(schedules["timers"]).size + Array(schedules["cron"]).size if schedules.any?) ],
         [ "ports", "Ports", (Inventory::PortAnalysis.new(@server).public_ports.size if ports&.collected?) ], [ "keys", "Clés SSH", snapshot&.keys&.size ],
         *@integration_tabs.map { |tab| [ tab[:key], tab[:label], tab[:count]&.call(@server) ] }, [ "history", "Historique", nil ] ].each do |tab, label, count| %>
      <% current = tab == @tab %>
      <%= link_to server_path(@server, tab: (tab unless tab == "overview")), aria: { current: (current ? "page" : nil) }, data: { tab: tab },
            class: "flex shrink-0 items-center gap-1.5 border-b-2 px-1 pb-2.5 #{current ? "border-accent font-medium text-ink" : "border-transparent text-ink-3 hover:text-ink"}" do %>
        <%= label %><% if count %><span class="rounded-full bg-subtle px-1.5 text-[11px] text-ink-2"><%= count %></span><% end %>
      <% end %>
    <% end %>
  </nav>

  <% case @tab %>
  <% when "overview" %>
    <%= render "servers/health_card", server: @server %>
    <%= render "servers/system_card", server: @server %>
    <%= render "servers/network_card", server: @server %>
  <% when "packages" %>
    <section id="server-packages" class="card mt-6">
      <div class="card-header">
        <h2 class="flex items-center gap-2 font-semibold"><%= icon :cube, class: "h-4 w-4 text-ink-3" %> Paquets</h2>
        <%= link_to "Chercher sur tout le parc", packages_path, class: "text-xs font-medium text-accent hover:underline" %>
      </div>
      <%= render "server_packages/frame", server: @server %>
    </section>
  <% when "vulnerabilities" %>
    <%= render "servers/vulnerabilities_card", server: @server %>
  <% when "services" %>
    <%= render "servers/services_card", server: @server %>
  <% when "docker" %>
    <%= render "servers/docker_card", server: @server %>
  <% when "schedules" %>
    <%= render "servers/scheduled_tasks_card", server: @server %>
  <% when "ports" %>
    <%= render "servers/ports_card", server: @server %>
  <% when "keys" %>
    <section id="server-authorized-keys" class="card mt-6 p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="flex items-center gap-2 font-semibold"><%= icon :key, class: "h-4 w-4 text-ink-3" %> Clés SSH autorisées</h2>
          <p class="mt-1 text-xs text-ink-3">Clés publiques qui peuvent se connecter à ce serveur avec le compte de connexion d'Elio.</p>
        </div>
        <% if can?(:operate) %><%= render "servers/add_key_dialog", server: @server %><% end %>
      </div>
      <div class="mt-4">
        <%= render "server_authorized_keys/frame", server: @server %>
      </div>
    </section>
  <% when *@integration_tabs.map { |tab| tab[:key] } %>
    <% tab = @integration_tabs.find { |candidate| candidate[:key] == @tab } %>
    <%= render "integrations/#{tab[:integration].kind}/server_tab", server: @server, integration: tab[:integration] %>
  <% when "history" %>
    <section id="server-activity" class="card mt-6 px-5 pt-4 pb-2">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 font-semibold"><%= icon :clock, class: "h-4 w-4 text-ink-3" %> Historique</h2>
        <%= link_to "Tout voir", activities_path(server_id: @server.id), class: "text-xs font-medium text-accent hover:underline" %>
      </div>
      <% if @activities.any? %>
        <ul class="mt-2 divide-y divide-line">
          <%= render partial: "activities/activity", collection: @activities, locals: { show_server: false } %>
        </ul>
        <% if @pager.multiple_pages? %><div class="pb-3"><%= render "shared/pagination", pager: @pager, noun: "activités" %></div><% end %>
      <% else %>
        <p class="py-6 text-sm text-ink-3">Aucune activité sur ce serveur pour le moment.</p>
      <% end %>
    </section>
  <% end %>
</div>
