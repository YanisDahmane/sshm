<%# Status badge of a server, refreshed in place by the pings (server_ping_controller.js).
    By default: reachability of the SSH port. With `health: true`: the health state (fleet list). %>
<% health = local_assigns[:health] %>
<%
  checked = server.last_checked_at ? "Vérifié #{relative_time_in_words(server.last_checked_at)} (#{l(server.last_checked_at, format: :short)})" : "Jamais vérifié"
  tone, label, title = if health
    case server.health_state
    when "off" then [ :off, "Injoignable", checked ]
    when "crit" then [ :crit, "Critique", server.health_reason_texts.join(" · ") ]
    when "warn" then [ :warn, "À surveiller", server.health_reason_texts.join(" · ") ]
    when "ok" then [ :good, "En ligne", "Aucun problème au dernier inventaire" ]
    else server.reachable ? [ :good, "En ligne", "Pas encore d'inventaire" ] : [ :neutral, "Inconnu", checked ]
    end
  else
    case server.reachable
    when true then [ :good, "En ligne", checked ]
    when false then [ :off, "Injoignable", checked ]
    else [ :neutral, "Inconnu", checked ]
    end
  end
%>
<%= status_badge tone, label, id: dom_id(server, :status), title: title,
      class: "server-status", data: { server_ping_target: "badge", state: (health ? server.health_state : server.reachable.to_s) } %>
