<%# Status badge of a server, refreshed in place by the pings (server_ping_controller.js).
    By default: reachability of the SSH port. With `health: true`: the health state (fleet list). %>
<% health = local_assigns[:health] %>
<%
  checked = server.last_checked_at ? t(".checked_at", relative_time_in_words: (relative_time_in_words(server.last_checked_at)), date: (l(server.last_checked_at, format: :short))) : t(".never_checked")
  tone, label, title = if health
    case server.health_state
    when "off" then [ :off, t(".unreachable"), checked ]
    when "crit" then [ :crit, t(".critical"), server.health_reason_texts.join(" · ") ]
    when "warn" then [ :warn, t(".watch"), server.health_reason_texts.join(" · ") ]
    when "ok" then [ :good, t(".online"), t(".problem_last_inventory") ]
    else server.reachable ? [ :good, t(".online"), t(".inventory_yet") ] : [ :neutral, t(".unknown"), checked ]
    end
  else
    case server.reachable
    when true then [ :good, t(".online"), checked ]
    when false then [ :off, t(".unreachable"), checked ]
    else [ :neutral, t(".unknown"), checked ]
    end
  end
%>
<%= status_badge tone, label, id: dom_id(server, :status), title: title,
      class: "server-status", data: { server_ping_target: "badge", state: (health ? server.health_state : server.reachable.to_s) } %>
