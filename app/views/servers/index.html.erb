<% content_for :title, "Parc · Elio" %>
<% ping_form = ->(badge_id = nil) { { data: { controller: "quiet-submit", action: "turbo:submit-start->server-ping#start turbo:submit-end->server-ping#finish", server_ping_badge_param: badge_id }.compact } } %>

<section data-controller="server-ping">
  <%= render "servers/checking_badge_template" %>

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-semibold">Parc</h1>
      <p class="text-xs text-ink-3">
        <%= pluralize_fr(@summary.total, "serveur", "serveurs") %>
        <% if @summary.last_inventory_at %> · inventaire <%= relative_time_tag @summary.last_inventory_at %><% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <% if @summary.total.positive? %>
        <%= button_to server_pings_path, params: { badge: "health" }, form: ping_form.call, title: "Vérifier que chaque serveur répond",
              class: "group btn btn-secondary" do %>
          <%= icon :arrow_path, class: "h-4 w-4 group-disabled:animate-spin" %> Actualiser les statuts
        <% end %>
        <% if can?(:operate) %>
          <%= button_to server_inventories_path, title: "Relire le système, la santé et les services de tous les serveurs", class: "btn btn-secondary" do %>
            <%= icon :pulse %> Inventaire
          <% end %>
          <%= button_to server_scans_path, title: "Lire les clés de tous les serveurs", class: "btn btn-secondary" do %>
            <%= icon :key %> Scanner les clés
          <% end %>
        <% end %>
      <% end %>
      <% if can?(:operate) %>
        <%= link_to "Importer", new_server_import_path, class: "btn btn-secondary" %>
        <%= link_to new_server_path, class: "btn btn-primary" do %>
          <%= icon :plus %> Ajouter un serveur
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @summary.total.positive? %>
    <div class="fleet-summary mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
      <%= stat_tile "En ligne", "#{@summary.online}/#{@summary.total}", "répondent sur leur port SSH", tone: (:good if @summary.online == @summary.total), icon: :check, id: "stat-online" %>
      <%= stat_tile "À surveiller", @summary.to_watch, "redémarrage, disque, service…", tone: (:warn if @summary.to_watch.positive?), icon: :exclamation_triangle, id: "stat-to-watch" %>
      <%= stat_tile "Critiques", @summary.critical, (@summary.unreachable.positive? ? "dont #{pluralize_fr(@summary.unreachable, "injoignable", "injoignables")}" : "seuils critiques dépassés"),
                    tone: (:crit if @summary.critical.positive?), icon: :x_mark, id: "stat-critical" %>
      <%= stat_tile "Mises à jour de sécurité", @summary.security_updates,
                    "sur #{pluralize_fr(@summary.servers_with_security_updates, "serveur", "serveurs")}", icon: :shield_check, id: "stat-security" %>
    </div>
  <% end %>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <nav class="server-group-filter flex flex-wrap items-center gap-2" aria-label="Groupes">
      <% chip = "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs" %>
      <% if @groups.any? %>
        <%= link_to "Tous", servers_path(os: @os, state: @state), aria: { current: (@group ? nil : "page") },
              class: "#{chip} #{@group ? "border border-line bg-surface text-ink-2 hover:bg-subtle" : "bg-ink font-medium text-canvas"}" %>
        <% @groups.each do |group| %>
          <% current = group == @group %>
          <%= link_to servers_path(group: group.id, os: @os, state: @state), aria: { current: (current ? "page" : nil) },
                class: "#{chip} #{current ? "bg-ink font-medium text-canvas" : "border border-line bg-surface text-ink-2 hover:bg-subtle"}" do %>
            <span class="h-2 w-2 rounded-full <%= group.dot_classes %>"></span><%= group.name %>
          <% end %>
        <% end %>
      <% end %>
      <%= link_to (@groups.any? ? "Gérer les groupes" : "Organiser les serveurs en groupes"), server_groups_path, class: "text-xs font-medium text-accent hover:underline" %>
    </nav>

    <%= form_with url: servers_path, method: :get, data: { controller: "auto-submit", turbo_action: "advance" }, class: "fleet-filters ml-auto flex flex-wrap items-center gap-2" do |f| %>
      <%= hidden_field_tag :group, @group.id if @group %>
      <%= f.search_field :q, value: @q, placeholder: "Nom, hostname, IP…", aria: { label: "Rechercher un serveur" },
            data: { action: "input->auto-submit#submitLater" }, class: "fleet-search input w-44 py-1 text-xs" %>
      <% if @os_names.any? %>
        <span class="os-filter">
          <%= f.select :os, [ [ "Tous les systèmes", "" ], *@os_names.map { |name| [ name, name ] } ], { selected: @os },
                aria: { label: "Système" }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
        </span>
      <% end %>
      <span class="state-filter">
        <%= f.select :state, [ [ "Tous les états", "" ], [ "À surveiller", "warn" ], [ "Critiques", "crit" ], [ "Injoignables", "off" ], [ "En ligne", "ok" ], [ "Sans inventaire", "unknown" ] ],
              { selected: @state }, aria: { label: "État" }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
      </span>
      <noscript><%= f.submit "Filtrer", class: "btn btn-secondary" %></noscript>
    <% end %>
  </div>

  <% if @servers.any? %>
    <div class="card mt-3 overflow-x-auto">
      <table id="servers" class="table-dense">
        <thead>
          <tr>
            <th scope="col" class="pl-4">État</th>
            <th scope="col">Serveur</th>
            <th scope="col">Système</th>
            <th scope="col">Charge 24 h</th>
            <th scope="col">Mémoire</th>
            <th scope="col">Disque</th>
            <th scope="col">Mises à jour</th>
            <% if @monitor_counts %><th scope="col">Sondes</th><% end %>
            <th scope="col">À noter</th>
            <th scope="col" class="pr-4"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @servers.each do |server| %>
            <% health = server.inventory("health")&.data || {} %>
            <tr id="<%= dom_id(server) %>" class="hover:bg-subtle/60">
              <td class="pl-4"><%= render "servers/status", server: server, health: true %></td>
              <td>
                <div class="flex flex-wrap items-center gap-1.5">
                  <%= link_to server.name, server_path(server), class: "font-medium hover:text-accent hover:underline" %>
                  <%= render partial: "server_groups/badge", collection: server.server_groups, as: :group %>
                </div>
                <p class="server-address font-mono text-[11px] text-ink-3"><%= server.username %>@<%= server.host %><%= ":#{server.port}" unless server.port == 22 %></p>
                <% if (hostname = server.distinct_hostname) %><p class="server-hostname font-mono text-[11px] text-ink-3" title="Hostname de la machine"><%= hostname %></p><% end %>
              </td>
              <td class="server-os whitespace-nowrap text-xs"><%= render "servers/os", server: server %></td>
              <td class="server-load"><%= sparkline @load_history.fetch(server.id, []), max: 100, width: 60, title: "Charge sur 24 h (en % des processeurs)" %></td>
              <td class="server-memory"><%= meter health.dig("memory", "used_percent"), warn: AppSetting.current.health_memory_warn, crit: AppSetting.current.health_memory_crit, width: "w-12" %></td>
              <td class="server-disk"><%= meter health["disk_max_percent"], warn: AppSetting.current.health_disk_warn, crit: AppSetting.current.health_disk_crit, width: "w-12" %></td>
              <td class="server-updates whitespace-nowrap text-xs">
                <% if (updates = health["updates"]) %>
                  <span class="tabular-nums"><%= updates["total"] %></span>
                  <% if updates["security"].to_i.positive? %>
                    <span class="badge bg-crit-soft text-crit-ink"><%= updates["security"] %> sécu</span>
                  <% end %>
                <% else %>
                  <span class="text-ink-3">—</span>
                <% end %>
              </td>
              <% if @monitor_counts %>
                <td class="server-monitors whitespace-nowrap text-xs">
                  <% total, down = @monitor_counts.fetch(server.id, [ 0, 0 ]) %>
                  <%= link_to server_path(server, tab: "monitors"), class: "hover:underline #{total.zero? ? "text-warn-ink" : "text-ink-2"}" do %>
                    <span class="tabular-nums"><%= total %></span><% if down.positive? %> <span class="badge bg-crit-soft text-crit-ink"><%= down %> hors ligne</span><% end %>
                  <% end %>
                </td>
              <% end %>
              <td class="server-notes min-w-40 max-w-60 text-xs">
                <div class="flex flex-wrap items-center gap-1.5">
                  <% if (reason = server.health_reason_texts.first) %>
                    <span class="<%= server.health_state == "crit" ? "text-crit-ink" : "text-warn-ink" %>"><%= reason %></span>
                    <% if server.health_reason_texts.size > 1 %><span class="text-ink-3" title="<%= server.health_reason_texts.drop(1).join(" · ") %>">+<%= server.health_reason_texts.size - 1 %></span><% end %>
                  <% elsif server.ssh_ok == false %>
                    <%= render "servers/ssh_status", server: server %>
                  <% end %>
                  <% if @insights.orphans_by_server_id[server.id].present? %>
                    <%= render "servers/orphan_keys", server: server, insights: @insights %>
                  <% end %>
                </div>
              </td>
              <td class="pr-4">
                <div class="flex items-center justify-end gap-1">
                  <%= button_to server_ping_path(server), params: { badge: "health" }, form: ping_form.call(dom_id(server, :status)),
                        title: "Actualiser le statut", aria: { label: "Actualiser le statut de #{server.name}" },
                        class: "group btn btn-ghost btn-icon" do %>
                    <%= icon :arrow_path, class: "h-4 w-4 group-disabled:animate-spin" %>
                  <% end %>
                  <% if can?(:operate) %>
                    <%= link_to edit_server_path(server), title: "Modifier", aria: { label: "Modifier #{server.name}" }, class: "btn btn-ghost btn-icon" do %>
                      <%= icon :pencil_square %>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: "serveurs" %>
  <% else %>
    <div class="card mt-3 border-dashed px-6 py-12 text-center">
      <p class="text-sm text-ink-3">
        <%= if @state || @os || @q.present? then "Aucun serveur ne correspond à ces filtres." elsif @group then "Aucun serveur dans ce groupe." else "Aucun serveur pour le moment." end %>
      </p>
      <% if @state || @os || @q.present? %>
        <%= link_to "Retirer les filtres", servers_path(group: @group&.id), class: "mt-2 inline-block text-sm font-medium text-accent hover:underline" %>
      <% elsif @group && can?(:operate) %>
        <%= link_to "Ajouter des serveurs au groupe", edit_server_group_path(@group), class: "mt-2 inline-block text-sm font-medium text-accent hover:underline" %>
      <% elsif can?(:operate) %>
        <%= link_to "Ajouter votre premier serveur", new_server_path, class: "mt-2 inline-block text-sm font-medium text-accent hover:underline" %>
      <% end %>
    </div>
  <% end %>
</section>
