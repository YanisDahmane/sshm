<% content_for :title, t("title", page: t("nav.fleet")) %>

<section data-controller="server-ping">
  <%= render "servers/checking_badge_template" %>

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-semibold">Parc</h1>
      <p class="text-xs text-ink-3">
        <%= t("count.servers", count: @summary.total) %>
        <% if @summary.last_inventory_at %> <%= t("dashboard.index.inventory_html", last_inventory_at: (relative_time_tag @summary.last_inventory_at)) %><% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <% if @summary.total.positive? %>
        <%= button_to server_pings_path, params: { badge: "health" }, form: server_ping_form, title: t(".check_every_server_answers"),
              class: "group btn btn-secondary" do %>
          <%= icon :arrow_path, class: "h-4 w-4 group-disabled:animate-spin" %> <%= t(".refresh_statuses") %>
        <% end %>
        <% if can?(:operate) %>
          <%= button_to server_inventories_path, title: t(".read_again_system_health"), class: "btn btn-secondary" do %>
            <%= icon :pulse %> Inventaire
          <% end %>
          <%= button_to server_scans_path, title: t(".read_keys_every_server"), class: "btn btn-secondary" do %>
            <%= icon :key %> <%= t("dashboard.index.scan_keys") %>
          <% end %>
        <% end %>
      <% end %>
      <% if can?(:operate) %>
        <%= link_to t(".import"), new_server_import_path, class: "btn btn-secondary" %>
        <%= link_to new_server_path, class: "btn btn-primary" do %>
          <%= icon :plus %> <%= t("command_palette.add_server") %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @summary.total.positive? %>
    <div class="fleet-summary mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
      <%= stat_tile t("dashboard.index.online"), "#{@summary.online}/#{@summary.total}", t("dashboard.index.answer_their_ssh_port"), tone: (:good if @summary.online == @summary.total), icon: :check, id: "stat-online" %>
      <%= stat_tile t("dashboard.index.watch"), @summary.to_watch, t("dashboard.index.reboot_disk_service"), tone: (:warn if @summary.to_watch.positive?), icon: :exclamation_triangle, id: "stat-to-watch" %>
      <%= stat_tile t("dashboard.index.critical"), @summary.critical, (@summary.unreachable.positive? ? t("dashboard.index.including_unreachable", count: @summary.unreachable) : t("dashboard.index.critical_thresholds_exceeded")),
                    tone: (:crit if @summary.critical.positive?), icon: :x_mark, id: "stat-critical" %>
      <%= stat_tile t(".security_updates"), @summary.security_updates,
                    t(".on_servers", count: @summary.servers_with_security_updates), icon: :shield_check, id: "stat-security" %>
    </div>
  <% end %>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <nav class="server-group-filter flex flex-wrap items-center gap-2" aria-label="<%= t(".groups") %>">
      <% chip = "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs" %>
      <% if @groups.any? %>
        <%= link_to t(".all"), servers_path(os: @os, state: @state), aria: { current: (@group ? nil : "page") },
              class: "#{chip} #{@group ? "border border-line bg-surface text-ink-2 hover:bg-subtle" : "bg-ink font-medium text-canvas"}" %>
        <% @groups.each do |group| %>
          <% current = group == @group %>
          <%= link_to servers_path(group: group.id, os: @os, state: @state), aria: { current: (current ? "page" : nil) },
                class: "#{chip} #{current ? "bg-ink font-medium text-canvas" : "border border-line bg-surface text-ink-2 hover:bg-subtle"}" do %>
            <span class="h-2 w-2 rounded-full <%= group.dot_classes %>"></span><%= group.name %>
          <% end %>
        <% end %>
      <% end %>
      <%= link_to (@groups.any? ? t(".manage_groups") : t(".organize_servers_groups")), server_groups_path, class: "text-xs font-medium text-accent hover:underline" %>
    </nav>

    <%= form_with url: servers_path, method: :get, data: { controller: "auto-submit", turbo_action: "advance" }, class: "fleet-filters ml-auto flex flex-wrap items-center gap-2" do |f| %>
      <%= hidden_field_tag :group, @group.id if @group %>
      <%= f.search_field :q, value: @q, placeholder: t(".name_hostname_ip"), aria: { label: t(".search_server") },
            data: { action: "input->auto-submit#submitLater" }, class: "fleet-search input w-44 py-1 text-xs" %>
      <% if @os_names.any? %>
        <span class="os-filter">
          <%= f.select :os, [ [ t(".all_systems"), "" ], *@os_names.map { |name| [ name, name ] } ], { selected: @os },
                aria: { label: t(".system") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
        </span>
      <% end %>
      <span class="state-filter">
        <%= f.select :state, [ [ t(".all_states"), "" ], [ t("dashboard.index.watch"), "warn" ], [ t("dashboard.index.critical"), "crit" ], [ t(".unreachable"), "off" ], [ t("dashboard.index.online"), "ok" ], [ t(".without_inventory"), "unknown" ] ],
              { selected: @state }, aria: { label: t(".state") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
      </span>
      <noscript><%= f.submit t(".filter"), class: "btn btn-secondary" %></noscript>
    <% end %>
    <div class="view-toggle flex rounded-lg border border-line bg-surface p-0.5" role="group" aria-label="<%= t(".display") %>">
      <% [ [ "list", t(".list"), :list_bullet ], [ "grid", t(".grid"), :squares_2x2 ] ].each do |view, label, icon_name| %>
        <%= link_to servers_path(request.query_parameters.except("page").merge("view" => view)), title: t(".view_label", label_downcase: label.downcase), data: { view: view },
              aria: { label: t(".view_label", label_downcase: label.downcase), pressed: @view == view },
              class: "inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs #{@view == view ? "bg-subtle font-medium text-ink" : "text-ink-3 hover:text-ink"}" do %>
          <%= icon icon_name, class: "h-4 w-4" %><span class="hidden sm:inline"><%= label %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @servers.any? && @view == "grid" %>
    <div id="servers-grid" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
      <%= render partial: "servers/card", collection: @servers, as: :server %>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: t("nouns.servers") %>
  <% elsif @servers.any? %>
    <div class="card mt-3 overflow-x-auto">
      <table id="servers" class="table-dense">
        <thead>
          <tr>
            <th scope="col" class="pl-4"><%= t(".state") %></th>
            <th scope="col"><%= t(".server") %></th>
            <th scope="col"><%= t(".system") %></th>
            <th scope="col"><%= t(".load_24_h") %></th>
            <th scope="col"><%= t(".memory") %></th>
            <th scope="col"><%= t(".disk") %></th>
            <th scope="col"><%= t(".updates") %></th>
            <% if @monitor_counts %><th scope="col">Sondes</th><% end %>
            <th scope="col"><%= t(".notes") %></th>
            <th scope="col" class="pr-4"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "servers/row", collection: @servers, as: :server %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: t("nouns.servers") %>
  <% else %>
    <div class="card mt-3 border-dashed px-6 py-12 text-center">
      <p class="text-sm text-ink-3">
        <%= if @state || @os || @q.present? then t(".server_matches_these_filters") elsif @group then t(".server_group") else t(".server_yet") end %>
      </p>
      <% if @state || @os || @q.present? %>
        <%= link_to t(".remove_filters"), servers_path(group: @group&.id), class: "mt-2 inline-block text-sm font-medium text-accent hover:underline" %>
      <% elsif @group && can?(:operate) %>
        <%= link_to t(".add_servers_group"), edit_server_group_path(@group), class: "mt-2 inline-block text-sm font-medium text-accent hover:underline" %>
      <% elsif can?(:operate) %>
        <%= link_to t(".add_your_first_server"), new_server_path, class: "mt-2 inline-block text-sm font-medium text-accent hover:underline" %>
      <% end %>
    </div>
  <% end %>
</section>
