<div class="flex min-h-7 flex-wrap items-center gap-x-3 gap-y-1">
  <span class="w-16 shrink-0 text-xs font-semibold uppercase tracking-wide text-slate-400"><%= label %></span>
  <%= yield %>
  <% if local_assigns[:refresh_path] %>
    <%= link_to refresh_path, title: local_assigns[:refresh_title], aria: { label: local_assigns[:refresh_title] }, data: { turbo_prefetch: false },
          class: "health-refresh ml-auto rounded-md p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600" do %>
      <%= icon :arrow_path, class: "h-4 w-4 group-aria-busy:animate-spin" %>
    <% end %>
  <% end %>
</div>
