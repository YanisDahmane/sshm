<%# The server presents another host key than the pinned one: show both, let an admin trust the new one. %>
<div class="host-key-changed mt-3 rounded-md border border-warn/40 bg-warn-soft p-4 text-sm text-warn-ink">
  <p>
    <%= t(".warning_html", reinstalled: tag.strong(t(".reinstalled")), command: tag.code("ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub", class: "font-mono text-xs")) %> 
  </p>
  <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 font-mono text-xs">
    <dt class="font-sans text-warn-ink"><%= t("words.known") %></dt>
    <dd class="host-key-known break-all"><%= host_key[:known].presence&.join(", ") || "—" %></dd>
    <dt class="font-sans text-warn-ink"><%= t(".presented") %></dt>
    <dd class="host-key-new break-all"><%= host_key[:new] %></dd>
  </dl>
  <% if can?(:administer) %>
    <%= button_to t(".trust_new_fingerprint"), server_host_key_path(server), params: { fingerprint: host_key[:new] },
          form: { class: "mt-3", data: { turbo_frame: "_top", turbo_confirm: t(".new_fingerprint_will_replace", new: (host_key[:new]), server_name: server.name),
                                         confirm_label: t(".trust"), confirm_variant: "danger" } },
          class: "cursor-pointer rounded-md border border-warn/40 bg-surface px-3 py-1.5 text-sm font-medium text-warn-ink shadow-sm hover:bg-warn-soft" %>
  <% else %>
    <p class="mt-3 text-warn-ink"><%= t(".ask_administrator_check_accept") %></p>
  <% end %>
</div>
