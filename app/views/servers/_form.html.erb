<% input_class = "mt-1 block w-full rounded-md border border-line px-3 py-2 text-sm shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
<% label_class = "block text-sm font-medium text-ink-2" %>

<%= form_with model: server, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", record: server %>

  <div>
    <%= f.label :name, "Nom", class: label_class %>
    <%= f.text_field :name, autofocus: true, required: true, placeholder: "Production web", class: input_class %>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
    <div class="sm:col-span-2">
      <%= f.label :host, "Hôte (IP ou nom de domaine)", class: label_class %>
      <%= f.text_field :host, required: true, placeholder: "192.168.1.10", autocomplete: "off", spellcheck: false, class: "#{input_class} font-mono" %>
    </div>
    <div>
      <%= f.label :port, "Port", class: label_class %>
      <%= f.number_field :port, required: true, min: 1, max: 65_535, class: "#{input_class} font-mono" %>
    </div>
  </div>

  <div>
    <%= f.label :username, "Utilisateur", class: label_class %>
    <%= f.text_field :username, required: true, placeholder: "root", autocomplete: "off", spellcheck: false, class: "#{input_class} font-mono" %>
  </div>

  <% if ServerGroup.exists? %>
    <fieldset>
      <legend class="<%= label_class %>">Groupes</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        <%= f.collection_check_boxes :server_group_ids, ServerGroup.order(:name), :id, :name do |b| %>
          <label class="cursor-pointer">
            <%= b.check_box class: "peer sr-only" %>
            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium ring-1 ring-inset opacity-50 peer-checked:opacity-100 peer-checked:ring-2 peer-checked:[&>svg]:block peer-focus-visible:outline-2 peer-focus-visible:outline-accent <%= b.object.badge_classes %>">
              <%= icon :check, class: "hidden h-3 w-3" %><%= b.text %>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to "Annuler", server.persisted? ? server_path(server) : servers_path, class: "rounded-md px-4 py-2 text-sm font-medium text-ink-2 hover:bg-subtle" %>
    <%= f.submit server.persisted? ? "Enregistrer" : "Ajouter le serveur", class: "cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-hover" %>
  </div>
<% end %>
