<% content_for :title, "Modifier #{@server.name_was} · SSHM" %>

<div class="mx-auto max-w-xl">
  <%= link_to "← Serveurs", servers_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  <h1 class="mt-2 text-2xl font-bold tracking-tight">Modifier « <%= @server.name_was %> »</h1>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form", server: @server %>
  </div>

  <section id="danger-zone" class="mt-6 rounded-xl border border-red-200 bg-white p-6 shadow-sm">
    <h2 class="text-base font-semibold text-red-700">Supprimer ce serveur</h2>
    <p class="mt-1 text-sm text-slate-600">
      Le serveur est retiré de SSHM. Les clés installées sur la machine, dont celle de SSHM, restent en place :
      retirez-les d'abord depuis la page du serveur si nécessaire. L'historique d'activité est conservé.
    </p>
    <div class="mt-4">
      <%= render "servers/delete_button", server: @server, label: "Supprimer le serveur" %>
    </div>
  </section>
</div>
