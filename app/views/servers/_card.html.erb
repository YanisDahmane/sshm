<%# One server of the fleet as a card (grid view of servers/index): state, system, gauges, what to look at. %>
<% health = server.inventory("health")&.data || {} %>
<% state = server.health_state %>
<% tone = { "crit" => "crit", "off" => "crit", "warn" => "warn" }[state] %>
<% reason = server.health_reason_texts.first %>
<article id="<%= dom_id(server, :card) %>" class="server-card card flex flex-col p-4 <%= { "crit" => "border-crit/40", "warn" => "border-warn/50" }.fetch(tone, "") %>" data-state="<%= state %>">
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <%= link_to server.name, server_path(server), class: "block truncate font-semibold hover:text-accent hover:underline" %>
      <p class="truncate text-xs text-ink-3">
        <% if server.os_name %>
          <span class="<%= "text-warn-ink" if Inventory::EndOfLife.status(server.os_id, server.os_version).state.in?(%i[soon ended]) %>" title="<%= server.os_name %>"><%= short_os_name(server.os_name) %></span>
        <% else %>
          <span>Système inconnu</span>
        <% end %>
        <% if server.server_groups.any? %> · <%= server.server_groups.map(&:name).join(", ") %><% end %>
      </p>
    </div>
    <%= render "servers/status", server: server, health: true %>
  </div>

  <% if state == "off" %>
    <p class="mt-4 flex flex-1 items-center justify-center gap-2 rounded-lg bg-subtle px-3 py-6 text-sm text-ink-3">
      <%= icon :signal_slash, class: "h-4 w-4" %>
      Pas de réponse<% if server.last_checked_at %> <%= relative_time_tag server.last_checked_at, prefix: "· vérifié " %><% end %>
    </p>
  <% elsif health.any? %>
    <div class="server-card-gauges mt-4 space-y-2">
      <%= meter health["load_percent"], warn: 80, crit: 100, width: "flex-1", label: "CPU" %>
      <%= meter health.dig("memory", "used_percent"), warn: app_settings.health_memory_warn, crit: app_settings.health_memory_crit, width: "flex-1", label: "RAM" %>
      <%= meter health["disk_max_percent"], warn: app_settings.health_disk_warn, crit: app_settings.health_disk_crit, width: "flex-1", label: "Disque" %>
    </div>
  <% else %>
    <p class="mt-4 flex-1 rounded-lg bg-subtle px-3 py-4 text-center text-xs text-ink-3">Pas encore d'inventaire</p>
  <% end %>

  <div class="server-card-footer mt-4 text-xs">
    <% if reason %>
      <p class="flex items-start gap-1.5 <%= tone == "crit" ? "text-crit-ink" : "text-warn-ink" %>">
        <%= icon(tone == "crit" ? :x_mark : :exclamation_triangle, class: "mt-0.5 h-3.5 w-3.5 shrink-0") %>
        <span><%= reason %><% if server.health_reason_texts.size > 1 %> <span class="text-ink-3" title="<%= server.health_reason_texts.drop(1).join(" · ") %>">+<%= server.health_reason_texts.size - 1 %></span><% end %></span>
      </p>
    <% else %>
      <% updates = health.dig("updates", "total") %>
      <% ports = Inventory::PortAnalysis.new(server).public_ports.map { |port| port.proto == "tcp" ? port.port.to_s : "#{port.port}/#{port.proto}" }.uniq %>
      <p class="truncate text-ink-3">
        <%= [ (updates.to_i.zero? ? "à jour" : pluralize_fr(updates, "mise à jour", "mises à jour") if updates), ("ports #{ports.join(", ")}" if ports.any?) ].compact.join(" · ").presence || "#{server.username}@#{server.host}" %>
      </p>
    <% end %>
  </div>
</article>
