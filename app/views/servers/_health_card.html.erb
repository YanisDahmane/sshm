<%# Health of the server: figures of the last inventory (Inventory::Collectors::Health), what needs attention, 24-hour history, disks. %>
<% snapshot = server.inventory("health") %>
<% health = snapshot&.collected? ? snapshot.data : nil %>
<% settings = app_settings %>
<section id="server-health-details" class="card mt-6">
  <div class="card-header">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :pulse, class: "h-4 w-4 text-ink-3" %> Santé</h2>
    <div class="flex items-center gap-2 text-xs text-ink-3">
      <%= inventory_status_badge(snapshot) %>
      <% if snapshot&.collected_at %>relevé <%= relative_time_tag snapshot.collected_at %><% end %>
    </div>
  </div>

  <% if health %>
    <% memory = health["memory"] || {} %>
    <% fullest = Array(health["disks"]).max_by { |disk| disk["used_percent"].to_f } %>
    <div class="grid gap-3 p-4 sm:grid-cols-3">
      <div class="health-load rounded-lg border border-line px-3 py-2.5">
        <p class="text-xs text-ink-3">Charge</p>
        <div class="mt-1 flex items-end justify-between gap-2">
          <p class="text-xl font-semibold tabular-nums"><%= number_with_precision(health.dig("load", 0), precision: 2, strip_insignificant_zeros: true) %>
            <span class="text-xs font-normal text-ink-3">/ <%= pluralize_fr(health["cpus"].to_i, "processeur", "processeurs") %></span></p>
          <%= sparkline @health_history.map { |_, load, _, _| load }, max: 100, width: 80, height: 26, title: "Charge sur 24 h" %>
        </div>
      </div>
      <div class="health-memory rounded-lg border border-line px-3 py-2.5">
        <p class="text-xs text-ink-3">Mémoire</p>
        <p class="mt-1 text-xl font-semibold tabular-nums"><%= memory["used_percent"]&.round %> %
          <span class="text-xs font-normal text-ink-3"><%= human_bytes(memory["total"].to_i - memory["available"].to_i) %> / <%= human_bytes(memory["total"]) %></span></p>
        <div class="mt-2"><%= meter memory["used_percent"], warn: settings.health_memory_warn, crit: settings.health_memory_crit, width: "w-full", value: false %></div>
      </div>
      <div class="health-disk rounded-lg border border-line px-3 py-2.5">
        <p class="text-xs text-ink-3">Disque le plus plein <% if fullest %><span class="font-mono"><%= fullest["mount"] %></span><% end %></p>
        <% if fullest %>
          <p class="mt-1 text-xl font-semibold tabular-nums <%= "text-crit-ink" if fullest["used_percent"] >= settings.health_disk_crit %>"><%= fullest["used_percent"].round %> %
            <span class="text-xs font-normal text-ink-3"><%= human_bytes(fullest["used"]) %> / <%= human_bytes(fullest["size"]) %></span></p>
          <div class="mt-2"><%= meter fullest["used_percent"], warn: settings.health_disk_warn, crit: settings.health_disk_crit, width: "w-full", value: false %></div>
        <% else %>
          <p class="mt-1 text-xl text-ink-3">—</p>
        <% end %>
      </div>
    </div>

    <div class="grid gap-4 border-t border-line p-4 lg:grid-cols-3">
      <div class="health-reasons">
        <h3 class="text-xs font-semibold tracking-wide text-ink-3 uppercase">À traiter</h3>
        <% if server.health_reasons.any? %>
          <ul class="mt-2 space-y-1.5">
            <% server.health_reasons.each do |reason| %>
              <li class="flex items-start gap-2 <%= reason["tone"] == "crit" ? "text-crit-ink" : "text-warn-ink" %>">
                <%= icon(reason["tone"] == "crit" ? :x_mark : :exclamation_triangle, class: "mt-0.5 h-4 w-4") %><span class="text-ink"><%= reason["text"] %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-2 flex items-center gap-2 text-sm text-good-ink"><%= icon :check_circle %> Rien à signaler</p>
        <% end %>
        <dl class="health-facts mt-4 space-y-1 text-xs">
          <div class="flex justify-between gap-2"><dt class="text-ink-3">Mises à jour</dt>
            <dd><% if (updates = health["updates"]) %><%= updates["total"] %><% if updates["security"].to_i.positive? %> dont <span class="font-medium text-crit-ink"><%= updates["security"] %> de sécurité</span><% end %><% else %>—<% end %></dd></div>
          <div class="flex justify-between gap-2"><dt class="text-ink-3">Redémarrage requis</dt><dd><%= health["reboot_required"] ? "oui" : "non" %></dd></div>
          <div class="flex justify-between gap-2"><dt class="text-ink-3">Services en échec</dt><dd class="text-right font-mono"><%= Array(health["failed_units"]).join(", ").presence || "aucun" %></dd></div>
          <div class="flex justify-between gap-2"><dt class="text-ink-3">Horloge</dt><dd><%= { true => "synchronisée", false => "non synchronisée" }.fetch(health["ntp_synchronized"], "—") %></dd></div>
          <% if (swap = health["swap"]) %>
            <div class="flex justify-between gap-2"><dt class="text-ink-3">Swap</dt><dd><%= swap["used_percent"].round %> % de <%= human_bytes(swap["total"]) %></dd></div>
          <% end %>
        </dl>
      </div>
      <div class="health-history grid gap-4 sm:grid-cols-3 lg:col-span-2 lg:grid-cols-1">
        <%= history_chart @health_history.map { |time, load, _, _| [ time, load ] }, label: "Charge (% des processeurs)" %>
        <%= history_chart @health_history.map { |time, _, memory, _| [ time, memory ] }, label: "Mémoire", threshold: settings.health_memory_warn %>
        <%= history_chart @health_history.map { |time, _, _, disk| [ time, disk ] }, label: "Disque le plus plein", threshold: settings.health_disk_warn,
                          color: (fullest && fullest["used_percent"] >= settings.health_disk_crit ? "var(--color-crit)" : "var(--color-accent)") %>
      </div>
    </div>

    <% if Array(health["disks"]).any? %>
      <table class="health-disks table-dense border-t border-line">
        <thead><tr><th class="pl-4">Point de montage</th><th>Type</th><th>Taille</th><th>Utilisé</th><th class="pr-4">Inodes</th></tr></thead>
        <tbody>
          <% health["disks"].each do |disk| %>
            <tr>
              <td class="pl-4 font-mono text-xs"><%= disk["mount"] %></td>
              <td class="text-xs text-ink-2"><%= disk["type"] %></td>
              <td class="text-xs tabular-nums"><%= human_bytes(disk["size"]) %></td>
              <td><%= meter disk["used_percent"], warn: settings.health_disk_warn, crit: settings.health_disk_crit, width: "w-24" %></td>
              <td class="pr-4 text-xs tabular-nums text-ink-2"><%= disk["inodes_used_percent"] ? "#{disk["inodes_used_percent"].round} %" : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% elsif snapshot&.failed? %>
    <p class="inventory-error px-4 py-4 text-sm text-crit-ink"><%= snapshot.message %></p>
  <% else %>
    <p class="health-empty px-4 py-4 text-sm text-ink-3">Pas encore de mesure : lancez l'inventaire pour suivre la charge, la mémoire, les disques et les mises à jour.</p>
  <% end %>
</section>
