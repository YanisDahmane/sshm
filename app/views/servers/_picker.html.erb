<%# Checkboxes `server_ids[]` for every server, with "check all" and "whole group" buttons (Stimulus check-all). %>
<% servers = Server.order(:name).includes(:server_groups) %>
<% groups = ServerGroup.joins(:memberships).distinct.order(:name) %>
<fieldset data-controller="check-all">
  <div class="flex items-center justify-between">
    <legend class="text-sm font-medium text-slate-700">Serveurs</legend>
    <button type="button" data-action="check-all#toggle" class="cursor-pointer text-xs font-medium text-indigo-600 hover:text-indigo-500">Tout cocher / décocher</button>
  </div>
  <% if groups.any? %>
    <div class="bulk-groups mt-2 flex flex-wrap items-center gap-2">
      <span class="text-xs text-slate-500">Tout le groupe :</span>
      <% groups.each do |group| %>
        <button type="button" data-action="check-all#toggleGroup" data-check-all-group-param="<%= group.id %>"
                class="cursor-pointer rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset hover:opacity-80 <%= group.badge_classes %>"><%= group.name %></button>
      <% end %>
    </div>
  <% end %>
  <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
    <% servers.each do |server| %>
      <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-200 px-3 py-2 text-sm hover:bg-slate-50 has-[:checked]:border-indigo-300 has-[:checked]:bg-indigo-50/50">
        <%= check_box_tag "server_ids[]", server.id, false, id: "server_ids_#{server.id}",
              data: { check_all_target: "checkbox", groups: server.server_group_ids.join(" ") },
              class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
        <span class="min-w-0">
          <span class="block truncate font-medium"><%= server.name %></span>
          <span class="block truncate font-mono text-xs text-slate-500"><%= server.username %>@<%= server.host %></span>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
