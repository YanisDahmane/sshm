<%# Network of the server: its interfaces and addresses (Inventory::Collectors::Network), plus the addresses added by hand. %>
<% snapshot = server.inventory("network") %>
<% data = snapshot&.data || {} %>
<section id="server-network" class="card mt-6">
  <div class="card-header">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :globe, class: "h-4 w-4 text-ink-3" %> <%= t(".network") %></h2>
    <div class="flex items-center gap-2 text-xs text-ink-3">
      <%= inventory_status_badge(snapshot) %>
      <% if snapshot&.collected_at %><%= t(".read_html", collected_at: (relative_time_tag snapshot.collected_at)) %><% end %>
    </div>
  </div>

  <% interfaces = Array(data["interfaces"]).select { |interface| interface["addresses"].present? } %>
  <% if snapshot&.collected? && interfaces.any? %>
    <table class="table-dense">
      <thead><tr><th class="pl-4"><%= t("words.interface") %></th><th><%= t("words.address") %></th><th class="pr-4"><%= t(".scope") %></th></tr></thead>
      <tbody>
        <% interfaces.each do |interface| %>
          <% interface["addresses"].each_with_index do |address, index| %>
            <tr class="network-address" data-interface="<%= interface["name"] %>">
              <td class="pl-4 whitespace-nowrap">
                <% if index.zero? %>
                  <span class="font-mono text-xs font-medium"><%= interface["name"] %></span>
                  <% if Inventory::Collectors::Network::VPN_KINDS.include?(interface["kind"]) %>
                    <%= status_badge :accent, network_kind_label(interface["kind"]), icon: :shield_check, class: "interface-kind ml-1" %>
                  <% else %>
                    <span class="interface-kind ml-1 text-xs text-ink-3"><%= network_kind_label(interface["kind"]) %></span>
                  <% end %>
                  <% unless interface["up"] %><%= status_badge :neutral, t(".off"), class: "ml-1" %><% end %>
                <% end %>
              </td>
              <td class="font-mono text-xs">
                <%= address["address"] %><span class="text-ink-3">/<%= address["prefix"] %></span>
                <% if address["temporary"] %><span class="ml-1 font-sans text-ink-3"><%= t("words.temporary") %></span><% end %>
              </td>
              <td class="pr-4 text-xs"><%= address_scope_badge(address["scope"]) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-4 py-4 text-sm text-ink-3">
      <%= snapshot&.failed? ? snapshot.message : (snapshot&.status == "unsupported" ? snapshot.message : t(".network_inventory_yet_refresh")) %>
    </p>
  <% end %>

  <% if server.extra_addresses.any? %>
    <p class="extra-addresses border-t border-line px-4 py-2.5 text-xs text-ink-2">
      <%= t(".added_hand") %> <span class="font-mono"><%= server.extra_addresses.join(", ") %></span>
    </p>
  <% end %>
</section>
