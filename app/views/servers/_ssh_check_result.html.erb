<% if result.success? %>
  <div class="ssh-check-result flex gap-3 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
    <%= icon :check, class: "mt-0.5 h-4 w-4 shrink-0" %>
    <div>
      <p class="font-medium"><%= result.message %></p>
      <p class="mt-1 break-all font-mono text-xs text-emerald-700"><%= result.details %></p>
    </div>
  </div>
<% else %>
  <div class="ssh-check-result flex gap-3 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
    <%= icon :x_mark, class: "mt-0.5 h-4 w-4 shrink-0" %>
    <div>
      <p class="font-medium"><%= result.message %></p>
      <p class="mt-1 break-all font-mono text-xs text-red-700"><%= result.details %></p>
    </div>
  </div>
  <% if result.reason %>
    <%= render "ssh_keys/setup_hint", server: server, reason: result.reason %>
  <% end %>
<% end %>
