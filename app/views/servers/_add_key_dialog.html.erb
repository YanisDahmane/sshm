<%# "Ajouter une clé" on the server's keys tab (operators): a key of the keyring, or a new key saved
    to the keyring and added in one go. Replaced over Turbo Stream after a submission (errors, or closed). %>
<% public_key ||= PublicKey.new(kind: "person") %>
<% source ||= "keyring" %>
<% open ||= false %>
<% keys = PublicKey.order(:name).to_a %>
<% snapshot = AccountSnapshot.find_by(server: server, unix_user: server.username) %>
<% present = snapshot ? snapshot.keys.map(&:fingerprint).to_set : Set.new %>
<% source = "new" if keys.empty? %>
<div id="<%= dom_id(server, :add_key) %>" data-controller="modal" class="add-key" <% if open %>data-modal-open-value="true"<% end %>>
  <button type="button" data-action="modal#open" class="add-key-button btn btn-primary">
    <%= icon :plus, class: "h-4 w-4" %> <%= t(".add_key") %>
  </button>

  <dialog data-modal-target="dialog" data-action="click->modal#backdropClose" aria-labelledby="<%= dom_id(server, :add_key) %>-title"
          class="add-key-dialog m-auto w-full max-w-xl rounded-xl border border-line bg-surface p-0 text-left text-ink shadow-xl backdrop:bg-neutral-950/40 backdrop:backdrop-blur-sm">
    <div class="flex items-start justify-between gap-4 border-b border-line px-6 py-4">
      <div>
        <h2 id="<%= dom_id(server, :add_key) %>-title" class="text-base font-semibold"><%= t(".add_key_html", server_name: server.name) %></h2>
        <p class="mt-0.5 font-mono text-xs text-ink-3"><%= AuthorizedKeysAccount.login(server).path %></p>
      </div>
      <button type="button" data-action="modal#close" aria-label="<%= t(".close") %>" class="btn btn-ghost btn-icon"><%= icon :x_mark, class: "h-5 w-5" %></button>
    </div>

    <%= form_with url: server_authorizations_path(server), data: { controller: "kind-fields quiet-submit" }, class: "space-y-5 px-6 py-5" do |f| %>
      <fieldset>
        <legend class="sr-only"><%= t(".key_origin") %></legend>
        <div class="add-key-sources grid grid-cols-2 gap-1 rounded-lg bg-subtle p-1 text-sm">
          <% [ [ "keyring", t(".keyring") ], [ "new", t(".new_key") ] ].each do |value, label| %>
            <label class="flex cursor-pointer items-center justify-center gap-2 rounded-md px-3 py-1.5 font-medium text-ink-2 has-[:checked]:bg-surface has-[:checked]:text-ink has-[:checked]:shadow-sm">
              <%= radio_button_tag :source, value, source == value, id: "#{dom_id(server, :add_key)}_source_#{value}", class: "sr-only",
                    disabled: value == "keyring" && keys.empty?, data: { kind_fields_target: "kind", action: "kind-fields#update" } %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div data-kind-fields-target="field" data-kinds="keyring" class="add-key-keyring">
        <%= label_tag :public_key_id, t(".keyring_key"), for: "#{dom_id(server, :add_key)}_public_key_id", class: "label" %>
        <%= select_tag :public_key_id,
              options_for_select(keys.map { |key| [ "#{key.name} — #{key.kind_label}#{" (déjà sur le serveur)" if present.include?(key.fingerprint)}", key.id,
                                                   { disabled: present.include?(key.fingerprint) } ] },
                                 keys.find { |key| !present.include?(key.fingerprint) }&.id),
              id: "#{dom_id(server, :add_key)}_public_key_id", class: "input mt-1 w-full" %>
        <% if snapshot %>
          <p class="mt-1 text-xs text-ink-3"><%= t(".last_key_reading_html", relative_time_in_words: (relative_time_in_words(snapshot.read_at))) %></p>
        <% end %>
      </div>

      <div data-kind-fields-target="field" data-kinds="new" class="add-key-new space-y-4">
        <%= render "shared/form_errors", record: public_key %>
        <div>
          <%= label_tag "public_key[name]", t(".name"), for: "#{dom_id(server, :add_key)}_name", class: "label" %>
          <%= text_field_tag "public_key[name]", public_key.name, id: "#{dom_id(server, :add_key)}_name", required: true, placeholder: t(".alice"), class: "input mt-1 w-full" %>
        </div>
        <fieldset>
          <legend class="label">Type</legend>
          <div class="mt-1.5 flex gap-4">
            <% PublicKey::KINDS.each do |value| %>
              <% label = PublicKey.kind_label(value) %>
              <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-2">
                <%= radio_button_tag "public_key[kind]", value, public_key.kind == value, id: "#{dom_id(server, :add_key)}_kind_#{value}", class: "h-4 w-4 border-line text-accent" %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <div>
          <%= label_tag "public_key[content]", t(".public_ssh_key"), for: "#{dom_id(server, :add_key)}_content", class: "label" %>
          <%= text_area_tag "public_key[content]", public_key.content, id: "#{dom_id(server, :add_key)}_content", required: true, rows: 3, spellcheck: false,
                autocomplete: "off", placeholder: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA… alice@laptop", class: "input mt-1 w-full font-mono text-xs" %>
          <p class="mt-1 text-xs text-ink-3"><%= t(".content_hint_html", extension: tag.code(".pub", class: "font-mono")) %></p>
        </div>
        <div>
          <%= label_tag "public_key[description]", for: "#{dom_id(server, :add_key)}_description", class: "label" do %>Description <span class="font-normal text-ink-3"><%= t(".optional") %></span><% end %>
          <%= text_field_tag "public_key[description]", public_key.description, id: "#{dom_id(server, :add_key)}_description",
                placeholder: t(".work_laptop_github_actions"), class: "input mt-1 w-full" %>
        </div>
      </div>

      <div>
        <%= label_tag :duration, t(".duration"), for: "#{dom_id(server, :add_key)}_duration", class: "label" %>
        <%= select_tag :duration, options_for_select([ [ t(".permanent"), "" ], *TemporaryAccess.options ], params[:duration]),
              id: "#{dom_id(server, :add_key)}_duration", class: "input mt-1 w-full sm:w-60" %>
      </div>

      <div class="flex items-center justify-end gap-2 border-t border-line pt-4">
        <button type="button" data-action="modal#close" class="btn btn-ghost">Annuler</button>
        <%= button_tag type: "submit", class: "group btn btn-primary disabled:cursor-wait disabled:opacity-60" do %>
          <%= icon :arrow_path, class: "hidden h-4 w-4 animate-spin group-disabled:block" %> <%= t(".add_server") %>
        <% end %>
      </div>
    <% end %>
  </dialog>
</div>
