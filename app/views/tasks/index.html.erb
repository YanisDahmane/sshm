<% content_for :title, t("title", page: t("nav.tasks")) %>

<%# No src: auto-refresh sets it while tasks are unfinished (Turbo refuses a frame whose src is the page itself). %>
<turbo-frame id="tasks" target="_top">
  <% if @counts.slice("queued", "running").values.sum.positive? %><div data-controller="auto-refresh" data-auto-refresh-interval-value="3000" hidden></div><% end %>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= t("nav.tasks") %></h1>
      <p class="mt-1 text-sm text-ink-3"><%= t(".inventories_key_scans_automations_html", in_days_to_i: (BackgroundTask::RETENTION.in_days.to_i)) %></p>
    </div>
    <% if can?(:administer) %>
      <%= link_to "/jobs", class: "btn btn-secondary", data: { turbo: false } do %><%= icon :list_bullet, class: "h-4 w-4" %><%= t("command_palette.jobs") %><% end %>
    <% end %>
  </div>

  <%= render "tasks/workers_warning", workers_running: @workers_running %>

  <nav class="task-filters mt-6 flex flex-wrap gap-2" aria-label="<%= t(".status") %>">
    <% [ [ t(".all"), nil ], [ t(".queued"), "queued" ], [ t(".running"), "running" ], [ t(".done"), "succeeded" ], [ t(".failed"), "failed" ] ].each do |label, filter| %>
      <%= filter_pill label, tasks_path(status: filter), active: @filter == filter, count: (task_filter_count(filter) if filter), data: { filter: filter || "all" } %>
    <% end %>
  </nav>

  <section class="card mt-4 overflow-x-auto">
    <% if @tasks.any? %>
      <table id="background-tasks" class="table-dense w-full">
        <thead>
          <tr><th><%= t(".task") %></th><th>Statut</th><th>Progression</th><th><%= t(".started") %></th><th><%= t(".started_2") %></th><th><%= t(".duration") %></th></tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <tr id="<%= dom_id(task) %>" class="background-task">
              <td>
                <%= link_to task.label, task_path(task), class: "font-medium text-ink hover:text-accent" %>
                <span class="ml-1 text-xs text-ink-3"><%= task.kind_label %></span>
              </td>
              <td><%= task_status_badge(task.status) %></td>
              <td><%= render "tasks/progress", task: task %></td>
              <td class="text-ink-2"><%= task.author_name %></td>
              <td class="text-ink-2"><%= relative_time_tag(task.created_at) %></td>
              <td class="text-ink-2 tabular-nums"><%= task_duration(task.duration) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="py-10 text-center text-sm text-ink-3"><%= (@filter ? t(".none_in_category") : t(".none")) %>.</p>
    <% end %>
  </section>

  <%= render "shared/pagination", pager: @pager, noun: t(".tasks") %>

  <section id="upcoming-automations" class="card mt-8">
    <div class="card-header">
      <h2 class="text-sm font-semibold"><%= t(".next_automations") %></h2>
      <% if can?(:administer) %><%= link_to t(".manage"), settings_automations_path, class: "text-xs font-medium text-accent" %><% end %>
    </div>
    <% if @upcoming_automations.any? %>
      <ul class="divide-y divide-line">
        <% @upcoming_automations.each do |automation| %>
          <li class="upcoming-automation flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-sm">
            <span>
              <span class="font-medium text-ink"><%= automation.label %></span>
              <span class="text-xs text-ink-3">· <%= Automation.interval_label(automation.interval_minutes).downcase %> · <%= automation.scope_label %></span>
              <% if automation.definition.quiet %><span class="text-xs text-ink-3"><%= t(".quiet_not_listed_tasks") %></span><% end %>
            </span>
            <span class="text-xs text-ink-2">
              <% next_run = automation.next_run_at %>
              <%= next_run <= Time.current ? t(".next_minute") : relative_time_tag(next_run, prefix: "") %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-4 py-6 text-center text-sm text-ink-3"><%= t(".automation_turned") %></p>
    <% end %>
  </section>
</turbo-frame>
