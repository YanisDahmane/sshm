<% content_for :title, t("title", page: t(".title")) %>

<h2 class="text-xl font-semibold"><%= t(".title") %></h2>
<p class="mt-1 mb-6 text-sm text-ink-3"><%= t(".intro") %></p>

<%= form_with url: two_factor_challenge_path, class: "space-y-5" do |f| %>
  <% if request.post? %>
    <p id="error_explanation" class="rounded-md border border-crit/40 bg-crit-soft px-4 py-3 text-sm text-crit-ink"><%= t(".invalid") %></p>
  <% end %>
  <div>
    <%= f.label :code, t(".code"), class: "label" %>
    <%= f.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", spellcheck: false,
          class: "input mt-1 text-center font-mono text-lg tracking-widest" %>
  </div>
  <%= f.submit t(".submit"), class: "btn btn-primary w-full" %>
<% end %>

<p class="mt-6 text-center text-sm text-ink-3">
  <%= link_to t(".cancel"), new_user_session_path, class: "font-medium text-accent hover:text-accent" %>
</p>
