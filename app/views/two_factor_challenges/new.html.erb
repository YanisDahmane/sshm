<% content_for :title, "Double authentification · Elio" %>

<h2 class="text-xl font-semibold">Double authentification</h2>
<p class="mt-1 mb-6 text-sm text-ink-3">Saisissez le code à 6 chiffres de votre application d'authentification, ou un code de secours.</p>

<%= form_with url: two_factor_challenge_path, class: "space-y-5" do |f| %>
  <% if request.post? %>
    <p id="error_explanation" class="rounded-md border border-crit/40 bg-crit-soft px-4 py-3 text-sm text-crit-ink">Code invalide ou déjà utilisé.</p>
  <% end %>
  <div>
    <%= f.label :code, "Code", class: "block text-sm font-medium text-ink-2" %>
    <%= f.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", spellcheck: false,
          class: "mt-1 block w-full rounded-md border border-line px-3 py-2 text-center font-mono text-lg tracking-widest shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
  </div>
  <%= f.submit "Vérifier", class: "w-full cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-hover" %>
<% end %>

<p class="mt-6 text-center text-sm text-ink-3">
  <%= link_to "Annuler et revenir à la connexion", new_user_session_path, class: "font-medium text-accent hover:text-accent" %>
</p>
