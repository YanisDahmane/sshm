<%# "OVH" tab of a server: its OVH service, IP blocks (reverse, network firewall vs. its public ports, anti-DDoS) and DNS records. %>
<% resources = server.ovh_resources.order(:kind, :name).to_a %>
<% services = resources.select(&:service?) %>
<% blocks = resources.select { |resource| resource.kind == "ip" } %>
<% records = resources.select { |resource| resource.kind == "dns_record" } %>
<% public_ports = Inventory::PortAnalysis.new(server).public_ports %>
<div id="server-ovh">
  <% if resources.empty? %>
    <p class="card mt-6 px-4 py-6 text-sm text-ink-3">
      <%= t(".ovhcloud_resource_attached_server") %><%= t(".not_synchronized_yet") unless integration.last_synced_at %>.
      <%= link_to t(".see_resources_not_attached"), ovh_path(unattached: 1), class: "font-medium text-accent hover:underline" %>
    </p>
  <% end %>

  <% services.each do |service| %>
    <section class="ovh-service card mt-6">
      <div class="card-header">
        <h2 class="flex items-center gap-2 font-semibold"><%= icon :server_stack, class: "h-4 w-4 text-ink-3" %> <%= service.kind_label %> · <%= service.name %></h2>
        <span class="text-xs text-ink-3"><%= t(".attached_html", ovh_match_label: (ovh_match_label(service))) %></span>
      </div>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-2 px-4 py-3 text-sm sm:grid-cols-4">
        <div><dt class="text-xs text-ink-3"><%= t("words.offer") %></dt><dd><%= service.data["offer"] || "—" %></dd></div>
        <div><dt class="text-xs text-ink-3"><%= service.kind == "instance" ? t(".region") : t(".datacenter") %></dt><dd><%= service.data["datacenter"] || service.data["region"] || "—" %></dd></div>
        <div><dt class="text-xs text-ink-3"><%= t(".state") %></dt><dd><%= service.data["state"] || "—" %></dd></div>
        <div><dt class="text-xs text-ink-3"><%= t("words.expiry") %></dt><dd><%= ovh_expiration(service) %></dd></div>
        <% if service.kind == "instance" %>
          <div class="col-span-2"><dt class="text-xs text-ink-3"><%= t("words.project") %></dt><dd><%= service.data["project_name"] || service.data["project"] %></dd></div>
        <% end %>
        <div class="col-span-2"><dt class="text-xs text-ink-3"><%= t(".ovh_service") %></dt><dd class="font-mono text-xs"><%= service.data["service"] || service.external_id %></dd></div>
      </dl>
    </section>
  <% end %>

  <% if blocks.any? %>
    <section id="server-ovh-ips" class="card mt-6">
      <div class="card-header"><h2 class="flex items-center gap-2 font-semibold"><%= icon :globe, class: "h-4 w-4 text-ink-3" %> <%= t(".ovh_ips_reverse_network") %></h2></div>
      <% blocks.each do |block| %>
        <div class="ovh-ip border-t border-line px-4 py-3 text-sm first:border-t-0" data-block="<%= block.name %>">
          <p class="flex flex-wrap items-center gap-2">
            <span class="font-mono font-medium"><%= block.name %></span>
            <span class="text-xs text-ink-3"><%= [ block.data["type"], block.data["service"] ].compact.join(" · ") %></span>
          </p>
          <% Array(block.data["reverse"]).each do |ip, reverse| %>
            <p class="mt-1 text-xs text-ink-2"><%= t(".reverse") %> <span class="font-mono"><%= ip %></span> : <span class="ovh-reverse font-mono"><%= reverse.presence || t("words.none") %></span></p>
          <% end %>
          <% if block.data.key?("firewall") %>
            <% firewalls = block.data["firewall"] %>
            <% if firewalls.empty? %>
              <p class="mt-1 text-xs text-warn-ink"><%= t(".ovh_network_firewall_not") %></p>
            <% end %>
            <% firewalls.each do |ip, firewall| %>
              <div class="ovh-firewall mt-2" data-ip="<%= ip %>">
                <p class="text-xs">
                  <%= t(".firewall") %> <span class="font-mono"><%= ip %></span> :
                  <%= firewall["enabled"] ? status_badge(:good, t(".text")) : status_badge(:warn, t(".off")) %>
                </p>
                <% if Array(firewall["rules"]).any? %>
                  <ul class="mt-1 space-y-0.5 font-mono text-[11px] text-ink-2">
                    <% firewall["rules"].sort_by { |rule| rule["sequence"].to_i }.each do |rule| %><li class="ovh-firewall-rule"><%= ovh_firewall_rule(rule) %></li><% end %>
                  </ul>
                <% end %>
                <% if public_ports.any? %>
                  <ul class="mt-2 flex flex-wrap gap-1.5 text-xs">
                    <% public_ports.each do |port| %>
                      <li class="ovh-port inline-flex items-center gap-1" data-port="<%= port.port %>/<%= port.proto %>"><span class="font-mono"><%= port.port %>/<%= port.proto %></span><%= ovh_firewall_badge(Integrations::Ovh::Firewall.verdict(firewall, port.proto, port.port)) %></li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            <% end %>
          <% end %>
          <% Array(block.data["mitigation"]).each do |ip, mitigation| %>
            <p class="ovh-mitigation mt-1 text-xs text-ink-2"><%= t(".anti_ddos") %> <span class="font-mono"><%= ip %></span> : <%= mitigation["permanent"] ? "permanent" : "automatique" %><%= " (#{mitigation["state"]})" if mitigation["state"] %></p>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if records.any? || resources.any? %>
    <section id="server-ovh-dns" class="card mt-6">
      <div class="card-header"><h2 class="flex items-center gap-2 font-semibold"><%= icon :list_bullet, class: "h-4 w-4 text-ink-3" %> <%= t(".dns_records_server") %></h2></div>
      <% if records.any? %>
        <table class="table-dense">
          <thead><tr><th class="pl-4"><%= t("words.name") %></th><th>Type</th><th><%= t("words.target") %></th><th class="pr-4"><%= t("words.ttl") %></th></tr></thead>
          <tbody>
            <% records.each do |record| %>
              <tr class="ovh-dns-record"><td class="pl-4 font-mono text-xs"><%= record.name %></td><td class="text-xs"><%= record.data["type"] %></td>
                <td class="font-mono text-xs"><%= record.data["target"] %></td><td class="pr-4 text-xs text-ink-3"><%= record.data["ttl"] %></td></tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-4 py-4 text-sm text-ink-3"><%= t(".dns_record_zones_read") %></p>
      <% end %>
    </section>
  <% end %>
</div>
