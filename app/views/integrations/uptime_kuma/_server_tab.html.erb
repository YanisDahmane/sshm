<%# "Sondes" tab of a server (Uptime Kuma extension). %>
<% monitors = server.uptime_kuma_monitors.to_a %>
<% base_url = integration.value(:url) %>
<section id="server-monitors" class="card mt-6">
  <div class="card-header">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :signal, class: "h-4 w-4 text-ink-3" %> Sondes Uptime Kuma</h2>
    <span class="text-xs text-ink-3">
      <% if integration.last_synced_at %>synchronisées <%= relative_time_tag integration.last_synced_at %><% end %>
      · <%= link_to "Toutes les sondes", monitors_path, class: "text-accent hover:underline" %>
    </span>
  </div>
  <% if monitors.any? %>
    <div class="overflow-x-auto">
      <table class="table-dense">
        <thead><tr><th class="pl-4">Sonde</th><th>Cible</th><th>État</th><th>Réponse</th><th>Dispo. 24 h · 30 j</th><th>Certificat</th><% if can?(:operate) %><th class="pr-4 text-right">Serveur</th><% end %></tr></thead>
        <tbody><%= render partial: "integrations/uptime_kuma/monitor_row", collection: monitors, as: :monitor, locals: { base_url: base_url } %></tbody>
      </table>
    </div>
  <% else %>
    <p class="monitors-empty px-4 py-6 text-sm text-ink-3">
      Aucune sonde ne surveille ce serveur<%= " (Uptime Kuma n'a pas encore été synchronisé)" unless integration.last_synced_at %>.
      <% if UptimeKumaMonitor.unattached.exists? %>
        <%= link_to "Rattacher une sonde existante", monitors_path(filter: "unattached"), class: "font-medium text-accent hover:underline" %>
      <% end %>
    </p>
  <% end %>
</section>
