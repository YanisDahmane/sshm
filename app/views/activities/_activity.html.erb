<li id="<%= dom_id(activity) %>" class="activity flex items-start gap-3 py-3 text-sm" data-kind="<%= activity.kind %>">
  <span class="mt-1.5"><%= render "activities/severity", severity: activity.severity %></span>
  <div class="min-w-0 flex-1">
    <p class="text-slate-900"><%= activity.summary %></p>
    <p class="mt-0.5 text-xs text-slate-500">
      <span class="font-medium text-slate-600"><%= activity.label %></span>
      · <%= activity.author_name %>
      · <%= relative_time_tag activity.created_at %>
      <% if activity.server && local_assigns.fetch(:show_server, true) %>
        · <%= link_to activity.server.name, server_path(activity.server), class: "hover:text-indigo-600 hover:underline" %>
      <% end %>
    </p>
  </div>
</li>
