<% content_for :title, t("title", page: t(".title")) %>
<% input_class = "input mt-1" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold tracking-tight"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-ink-3"><%= current_user.email %> · <%= current_user.role_label %></p>

  <section id="two-factor" class="mt-8 rounded-xl border border-line bg-surface p-6 shadow-sm">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-base font-semibold"><%= t(".two_factor") %></h2>
        <p class="mt-1 text-sm text-ink-3"><%= t(".two_factor_intro") %></p>
      </div>
      <% if current_user.two_factor_enabled? %>
        <span class="two-factor-state shrink-0 rounded-full bg-good-soft px-2 py-0.5 text-xs font-medium text-good-ink ring-1 ring-inset ring-good/20"><%= t(".enabled") %></span>
      <% else %>
        <span class="two-factor-state shrink-0 rounded-full bg-subtle px-2 py-0.5 text-xs font-medium text-ink-2"><%= t(".disabled") %></span>
      <% end %>
    </div>

    <% if current_user.two_factor_enabled? %>
      <p class="mt-4 text-sm text-ink-2"><%= t(".enabled_since_html", time: relative_time_tag(current_user.otp_enabled_at), codes: t(".codes_left", count: current_user.backup_codes_left)) %></p>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= form_with url: backup_codes_two_factor_path, data: { turbo: false }, class: "rounded-md border border-line p-4" do |f| %>
          <p class="text-sm font-medium text-ink-2"><%= t(".new_codes") %></p>
          <%= f.text_field :code, required: true, placeholder: t(".current_code"), autocomplete: "one-time-code", aria: { label: t(".code_to_regenerate") }, class: "#{input_class} font-mono" %>
          <%= f.submit t(".regenerate"), class: "btn btn-secondary mt-3" %>
        <% end %>
        <% if current_user.two_factor_mandatory?(app_settings) %>
          <p class="rounded-md border border-line p-4 text-sm text-ink-3"><%= t(".mandatory") %></p>
        <% else %>
          <%= form_with url: two_factor_path, method: :delete, class: "rounded-md border border-crit/40 p-4" do |f| %>
            <p class="text-sm font-medium text-crit-ink"><%= t(".turn_off") %></p>
            <%= f.text_field :code, required: true, placeholder: t(".current_code"), autocomplete: "one-time-code", aria: { label: t(".code_to_turn_off") }, class: "#{input_class} font-mono" %>
            <%= f.submit t(".turn_off_submit"), class: "mt-3 cursor-pointer rounded-md border border-crit/40 bg-surface px-3 py-1.5 text-sm font-medium text-crit-ink shadow-sm hover:bg-crit-soft" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= link_to t(".turn_on"), new_two_factor_path,
            class: "btn btn-primary mt-4" %>
    <% end %>
  </section>

  <%= render "accounts/language" %>

  <section id="password" class="mt-6 rounded-xl border border-line bg-surface p-6 shadow-sm">
    <h2 class="text-base font-semibold"><%= t(".password") %></h2>
    <%= form_with model: current_user, url: password_account_path, method: :patch, scope: :user, class: "mt-4 space-y-4" do |f| %>
      <%= render "shared/form_errors", record: current_user %>
      <div>
        <%= f.label :current_password, t(".current_password"), class: "label" %>
        <%= f.password_field :current_password, required: true, autocomplete: "current-password", class: input_class %>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :password, t("auth.fields.new_password"), class: "label" %>
          <%= f.password_field :password, required: true, autocomplete: "new-password", class: input_class %>
        </div>
        <div>
          <%= f.label :password_confirmation, t("auth.fields.confirmation"), class: "label" %>
          <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: input_class %>
        </div>
      </div>
      <%= f.submit t(".change_password"), class: "btn btn-primary" %>
    <% end %>
  </section>
</div>
