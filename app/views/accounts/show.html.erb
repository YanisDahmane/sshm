<% content_for :title, "Mon compte · Elio" %>
<% input_class = "input mt-1" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold tracking-tight">Mon compte</h1>
  <p class="mt-1 text-sm text-ink-3"><%= current_user.email %> · <%= current_user.role_label %></p>

  <section id="two-factor" class="mt-8 rounded-xl border border-line bg-surface p-6 shadow-sm">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-base font-semibold">Double authentification</h2>
        <p class="mt-1 text-sm text-ink-3">Un code de votre application d'authentification (Google Authenticator, 1Password, Bitwarden…) est demandé après le mot de passe.</p>
      </div>
      <% if current_user.two_factor_enabled? %>
        <span class="two-factor-state shrink-0 rounded-full bg-good-soft px-2 py-0.5 text-xs font-medium text-good-ink ring-1 ring-inset ring-good/20">Activée</span>
      <% else %>
        <span class="two-factor-state shrink-0 rounded-full bg-subtle px-2 py-0.5 text-xs font-medium text-ink-2">Désactivée</span>
      <% end %>
    </div>

    <% if current_user.two_factor_enabled? %>
      <p class="mt-4 text-sm text-ink-2">Activée <%= relative_time_tag current_user.otp_enabled_at %> · <%= pluralize(current_user.backup_codes_left, "code de secours restant", plural: "codes de secours restants") %>.</p>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= form_with url: backup_codes_two_factor_path, data: { turbo: false }, class: "rounded-md border border-line p-4" do |f| %>
          <p class="text-sm font-medium text-ink-2">Nouveaux codes de secours</p>
          <%= f.text_field :code, required: true, placeholder: "Code actuel", autocomplete: "one-time-code", aria: { label: "Code pour régénérer les codes de secours" }, class: "#{input_class} font-mono" %>
          <%= f.submit "Régénérer", class: "btn btn-secondary mt-3" %>
        <% end %>
        <% if current_user.admin? && AppSetting.current.require_admin_two_factor %>
          <p class="rounded-md border border-line p-4 text-sm text-ink-3">La double authentification est obligatoire pour les administrateurs : elle ne peut pas être désactivée.</p>
        <% else %>
          <%= form_with url: two_factor_path, method: :delete, class: "rounded-md border border-crit/40 p-4" do |f| %>
            <p class="text-sm font-medium text-crit-ink">Désactiver</p>
            <%= f.text_field :code, required: true, placeholder: "Code actuel", autocomplete: "one-time-code", aria: { label: "Code pour désactiver la double authentification" }, class: "#{input_class} font-mono" %>
            <%= f.submit "Désactiver la 2FA", class: "mt-3 cursor-pointer rounded-md border border-crit/40 bg-surface px-3 py-1.5 text-sm font-medium text-crit-ink shadow-sm hover:bg-crit-soft" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= link_to "Activer la double authentification", new_two_factor_path,
            class: "btn btn-primary mt-4" %>
    <% end %>
  </section>

  <section id="password" class="mt-6 rounded-xl border border-line bg-surface p-6 shadow-sm">
    <h2 class="text-base font-semibold">Mot de passe</h2>
    <%= form_with model: current_user, url: password_account_path, method: :patch, scope: :user, class: "mt-4 space-y-4" do |f| %>
      <%= render "shared/form_errors", record: current_user %>
      <div>
        <%= f.label :current_password, "Mot de passe actuel", class: "label" %>
        <%= f.password_field :current_password, required: true, autocomplete: "current-password", class: input_class %>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :password, "Nouveau mot de passe", class: "label" %>
          <%= f.password_field :password, required: true, autocomplete: "new-password", class: input_class %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmation", class: "label" %>
          <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: input_class %>
        </div>
      </div>
      <%= f.submit "Changer le mot de passe", class: "btn btn-primary" %>
    <% end %>
  </section>
</div>
