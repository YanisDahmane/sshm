<% content_for :title, "Mon compte · SSHM" %>
<% input_class = "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold tracking-tight">Mon compte</h1>
  <p class="mt-1 text-sm text-slate-500"><%= current_user.email %> · <%= current_user.role_label %></p>

  <section id="two-factor" class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-base font-semibold">Double authentification</h2>
        <p class="mt-1 text-sm text-slate-500">Un code de votre application d'authentification (Google Authenticator, 1Password, Bitwarden…) est demandé après le mot de passe.</p>
      </div>
      <% if current_user.two_factor_enabled? %>
        <span class="two-factor-state shrink-0 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Activée</span>
      <% else %>
        <span class="two-factor-state shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Désactivée</span>
      <% end %>
    </div>

    <% if current_user.two_factor_enabled? %>
      <p class="mt-4 text-sm text-slate-600">Activée <%= relative_time_tag current_user.otp_enabled_at %> · <%= pluralize(current_user.backup_codes_left, "code de secours restant", plural: "codes de secours restants") %>.</p>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <%= form_with url: backup_codes_two_factor_path, data: { turbo: false }, class: "rounded-md border border-slate-200 p-4" do |f| %>
          <p class="text-sm font-medium text-slate-700">Nouveaux codes de secours</p>
          <%= f.text_field :code, required: true, placeholder: "Code actuel", autocomplete: "one-time-code", aria: { label: "Code pour régénérer les codes de secours" }, class: "#{input_class} font-mono" %>
          <%= f.submit "Régénérer", class: "mt-3 cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" %>
        <% end %>
        <% if current_user.admin? && AppSetting.current.require_admin_two_factor %>
          <p class="rounded-md border border-slate-200 p-4 text-sm text-slate-500">La double authentification est obligatoire pour les administrateurs : elle ne peut pas être désactivée.</p>
        <% else %>
          <%= form_with url: two_factor_path, method: :delete, class: "rounded-md border border-red-200 p-4" do |f| %>
            <p class="text-sm font-medium text-red-700">Désactiver</p>
            <%= f.text_field :code, required: true, placeholder: "Code actuel", autocomplete: "one-time-code", aria: { label: "Code pour désactiver la double authentification" }, class: "#{input_class} font-mono" %>
            <%= f.submit "Désactiver la 2FA", class: "mt-3 cursor-pointer rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 shadow-sm hover:bg-red-50" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= link_to "Activer la double authentification", new_two_factor_path,
            class: "mt-4 inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% end %>
  </section>

  <section id="password" class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-base font-semibold">Mot de passe</h2>
    <%= form_with model: current_user, url: password_account_path, method: :patch, scope: :user, class: "mt-4 space-y-4" do |f| %>
      <%= render "shared/form_errors", record: current_user %>
      <div>
        <%= f.label :current_password, "Mot de passe actuel", class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :current_password, required: true, autocomplete: "current-password", class: input_class %>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :password, "Nouveau mot de passe", class: "block text-sm font-medium text-slate-700" %>
          <%= f.password_field :password, required: true, autocomplete: "new-password", class: input_class %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmation", class: "block text-sm font-medium text-slate-700" %>
          <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: input_class %>
        </div>
      </div>
      <%= f.submit "Changer le mot de passe", class: "cursor-pointer rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% end %>
  </section>
</div>
