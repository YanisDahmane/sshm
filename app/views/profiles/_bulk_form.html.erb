<%# Grants the profile access to several servers at once (ProfileAccessesController#create). %>
<% servers = Server.order(:name) %>
<% select_class = "mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
<section id="bulk-authorize" class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold">Autoriser sur plusieurs serveurs</h2>

  <% if servers.any? %>
    <%= form_with url: profile_accesses_path(profile), data: { controller: "quiet-submit check-all" }, class: "mt-4 space-y-5" do |f| %>
      <fieldset>
        <div class="flex items-center justify-between">
          <legend class="text-sm font-medium text-slate-700">Serveurs</legend>
          <button type="button" data-action="check-all#toggle" class="cursor-pointer text-xs font-medium text-indigo-600 hover:text-indigo-500">Tout cocher / décocher</button>
        </div>
        <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
          <% servers.each do |server| %>
            <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-200 px-3 py-2 text-sm hover:bg-slate-50 has-[:checked]:border-indigo-300 has-[:checked]:bg-indigo-50/50">
              <%= check_box_tag "server_ids[]", server.id, false, id: "server_ids_#{server.id}", data: { check_all_target: "checkbox" },
                    class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
              <span class="min-w-0">
                <span class="block truncate font-medium"><%= server.name %></span>
                <span class="block truncate font-mono text-xs text-slate-500"><%= server.username %>@<%= server.host %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="flex flex-wrap items-end gap-4">
        <div>
          <%= label_tag :account, "Compte", class: "block text-sm font-medium text-slate-700" %>
          <%= text_field_tag :account, nil, placeholder: "ex. debian", autocomplete: "off", spellcheck: false,
                class: "#{select_class} w-56 font-mono" %>
          <p class="mt-1 text-xs text-slate-500">Vide : l'utilisateur SSH de chaque serveur.</p>
        </div>
        <div>
          <%= label_tag :bulk_duration, "Durée", class: "block text-sm font-medium text-slate-700" %>
          <%= select_tag :duration, options_for_select([ [ "Permanent", "" ], *TemporaryAccess::DURATIONS.map { |value, (label, _)| [ label, value ] } ]),
                id: "bulk_duration", class: select_class %>
          <p class="mt-1 text-xs text-transparent select-none">.</p>
        </div>
        <div class="pb-6">
          <%= f.button type: "submit", class: "group inline-flex cursor-pointer items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-wait disabled:opacity-60" do %>
            <%= icon :arrow_path, class: "hidden h-4 w-4 animate-spin group-disabled:block" %>
            <span class="group-disabled:hidden">Autoriser</span>
            <span class="hidden group-disabled:inline">Autorisation en cours…</span>
          <% end %>
        </div>
      </div>
    <% end %>
    <div id="bulk-results"></div>
  <% else %>
    <p class="mt-4 text-sm text-slate-500"><%= link_to "Ajoutez un serveur", new_server_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %> pour pouvoir y autoriser ce profil.</p>
  <% end %>
</section>
