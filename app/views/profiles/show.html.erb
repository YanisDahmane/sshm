<% content_for :title, "#{@profile.name} · SSHM" %>
<% key = @profile.authorized_key %>

<div class="mx-auto max-w-3xl">
  <%= link_to "← Profils", profiles_path, class: "text-sm text-slate-500 hover:text-slate-700" %>

  <div class="mt-2 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= @profile.name %></h1>
      <p class="mt-1 text-sm text-slate-500">Profil ajouté <%= relative_time_tag @profile.created_at %></p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <% if can?(:operate) %>
        <%= link_to edit_profile_path(@profile),
              class: "inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do %>
          <%= icon :pencil_square %> Modifier
        <% end %>
        <%= render "delete_button", profile: @profile, label: "Supprimer",
              class: "inline-flex cursor-pointer items-center gap-2 rounded-md border border-red-300 bg-white px-3 py-2 text-sm font-medium text-red-700 shadow-sm hover:bg-red-50" %>
      <% end %>
      <% if can?(:administer) %>
        <%= render "profiles/revoke_everywhere", profile: @profile %>
      <% end %>
    </div>
  </div>

  <section id="profile-key" class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Clé SSH</h2>

    <dl class="mt-4 grid grid-cols-1 gap-4 text-sm sm:grid-cols-3">
      <div>
        <dt class="font-medium text-slate-700">Type</dt>
        <dd class="mt-1 font-mono text-slate-600"><%= key.type %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="font-medium text-slate-700">Empreinte</dt>
        <dd id="profile-fingerprint" class="mt-1 break-all font-mono text-slate-600"><%= @profile.fingerprint %></dd>
      </div>
      <div class="sm:col-span-3">
        <dt class="font-medium text-slate-700">Commentaire</dt>
        <dd class="mt-1 text-slate-600"><%= key.comment || tag.span("Aucun", class: "italic text-slate-400") %></dd>
      </div>
    </dl>

    <div class="mt-6" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="profile-public-key" class="text-sm font-medium text-slate-700">Clé publique</label>
        <%= render "settings/copy_button" %>
      </div>
      <textarea id="profile-public-key" readonly rows="3" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-slate-300 bg-slate-50 px-3 py-2 font-mono text-xs text-slate-700"><%= @profile.public_key %></textarea>
    </div>
  </section>

  <%= render "profiles/accesses", profile: @profile %>
  <% if can?(:operate) %>
    <%= render "profiles/bulk_form", profile: @profile %>
  <% end %>
</div>
