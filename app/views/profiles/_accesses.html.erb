<%# Where the profile's key is installed, from the last key reads (see ProfileAccessOverview). %>
<% accesses = ProfileAccessOverview.new(profile).accesses %>
<section id="profile-accesses" class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold">Accès</h2>
      <p class="mt-1 text-sm text-slate-500">Serveurs et comptes où la clé de ce profil est installée, d'après la dernière lecture des clés.</p>
    </div>
    <% if can?(:operate) %>
      <%= button_to server_scans_path, class: "inline-flex shrink-0 cursor-pointer items-center gap-2 whitespace-nowrap rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do %>
        <%= icon :key, class: "h-4 w-4" %> Scanner les clés
      <% end %>
    <% end %>
  </div>

  <% if accesses.any? %>
    <ul class="mt-4 divide-y divide-slate-100 rounded-md border border-slate-200">
      <% accesses.each do |access| %>
        <li class="profile-access flex items-center justify-between gap-3 px-4 py-3 text-sm">
          <div class="min-w-0">
            <p class="truncate">
              <%= link_to access.server.name, server_path(access.server), class: "font-medium hover:text-indigo-600 hover:underline" %>
              · <span class="font-mono"><%= access.unix_user %></span>
            </p>
            <p class="text-xs text-slate-500">Vu <%= relative_time_tag access.read_at %></p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <% if access.temporary_access %>
              <%= relative_time_tag access.temporary_access.expires_at, prefix: "Expire ", expired: "Expiré, suppression en cours",
                    class: "rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20" %>
            <% else %>
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Permanent</span>
            <% end %>
            <% if can?(:operate) %>
              <%= button_to profile_access_path(profile), method: :delete, params: { server_id: access.server.id, account: access.unix_user },
                    title: "Retirer l'accès", aria: { label: "Retirer l'accès à #{access.server.name} pour #{access.unix_user}" },
                    form: { data: { controller: "quiet-submit",
                                    turbo_confirm: "La clé de « #{profile.name} » sera supprimée de « #{access.server.name} » pour #{access.unix_user}.",
                                    confirm_label: "Retirer l'accès", confirm_variant: "danger" } },
                    class: "cursor-pointer rounded-md p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600 disabled:cursor-wait disabled:opacity-50" do %>
                <%= icon :trash %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 rounded-md border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500">
      Aucun accès connu. Autorisez ce profil ci-dessous, ou lancez un scan si des clés ont été ajoutées à la main.
    </p>
  <% end %>
</section>
