"{\n  \"threat_severity\" : \"Moderate\",\n  \"public_date\" : \"2026-10-23T00:00:00Z\",\n  \"bugzilla\" : {\n    \"description\" : \"kernel: md/raid5: let stripe batch bm_seq comparison wrap-safe\",\n    \"id\" : \"2559598\",\n    \"url\" : \"https://bugzilla.redhat.com/show_bug.cgi?id=2559598\"\n  },\n  \"cvss3\" : {\n    \"cvss3_base_score\" : \"4.7\",\n    \"cvss3_scoring_vector\" : \"CVSS:3.1/AV:L/AC:H/PR:L/UI:N/S:U/C:N/I:H/A:N\",\n    \"status\" : \"draft\"\n  },\n  \"cwe\" : \"CWE-190\",\n  \"details\" : [ \"In the Linux kernel, the following vulnerability has been resolved:\\nmd/raid5: let stripe batch bm_seq comparison wrap-safe\\nOnce the 32-bit seq wraps, a newer bm_seq can look smaller\\nthan old, so .. covert to wrap-safe calculate way.\", \"A flaw was found in the Linux kernel's RAID5 storage driver. A sequence number comparison issue in stripe batch processing fails to account for 32-bit integer wrapping. During extensive storage write operations, the sequence counter may overflow, causing the system to misidentify newer stripe batches as older. This flaw may allow a local user to cause data inconsistencies or a denial of service (DoS) through improper stripe batch handling.\" ],\n  \"package_state\" : [ {\n    \"product_name\" : \"Red Hat Enterprise Linux 10\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"kernel\",\n    \"cpe\" : \"cpe:/o:redhat:enterprise_linux:10\"\n  }, {\n    \"product_name\" : \"Red Hat Enterprise Linux 6\",\n    \"fix_state\" : \"Out of support scope\",\n    \"package_name\" : \"kernel\",\n    \"cpe\" : \"cpe:/o:redhat:enterprise_linux:6\"\n  }, {\n    \"product_name\" : \"Red Hat Enterprise Linux 7\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"kernel\",\n    \"cpe\" : \"cpe:/o:redhat:enterprise_linux:7\"\n  }, {\n    \"product_name\" : \"Red Hat Enterprise Linux 7\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"kernel-rt\",\n    \"cpe\" : \"cpe:/o:redhat:enterprise_linux:7\"\n  }, {\n    \"product_name\" : \"Red Hat Enterprise Linux 8\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"kernel\",\n    \"cpe\" : \"cpe:/o:redhat:enterprise_linux:8\"\n  }, {\n    \"product_name\" : \"Red Hat Enterprise Linux 8\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"kernel-rt\",\n    \"cpe\" : \"cpe:/o:redhat:enterprise_linux:8\"\n  }, {\n    \"product_name\" : \"Red Hat Enterprise Linux 9\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"kernel\",\n    \"cpe\" : \"cpe:/o:redhat:enterprise_linux:9\"\n  }, {\n    \"product_name\" : \"Red Hat Enterprise Linux 9\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"kernel-rt\",\n    \"cpe\" : \"cpe:/o:redhat:enterprise_linux:9\"\n  }, {\n    \"product_name\" : \"Red Hat OpenShift Container Platform 4\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"openshift/ose-rhel-coreos-8\",\n    \"cpe\" : \"cpe:/a:redhat:openshift:4\"\n  }, {\n    \"product_name\" : \"Red Hat OpenShift Container Platform 4\",\n    \"fix_state\" : \"Fix deferred\",\n    \"package_name\" : \"openshift/ose-rhel-coreos-9\",\n    \"cpe\" : \"cpe:/a:redhat:openshift:4\"\n  } ],\n  \"references\" : [ \"https://www.cve.org/CVERecord?id=CVE-2026-98902\\nhttps://nvd.nist.gov/vuln/detail/CVE-2026-98902\\nhttps://git.kernel.org/pub/scm/linux/security/vulns.git/plain/cve/published/2026/CVE-2026-98902.mbox\" ],\n  \"name\" : \"CVE-2026-98902\",\n  \"csaw\" : false\n}"